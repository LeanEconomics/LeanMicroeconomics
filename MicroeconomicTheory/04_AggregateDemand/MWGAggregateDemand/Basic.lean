import MWGConsumerChoice.WeakAxiom
import Mathlib.Topology.Algebra.Monoid
import Mathlib.Topology.Algebra.Module.Basic

/-!
# Aggregate demand: the shared foundation

MWG, Sections 4.A-4.C, pp. 105-111. This module fixes the objects used throughout Chapter 4.

* There are `I` consumers (`Fin I`) and `L` commodities (`Fin L`). Consumer `i` has a Walrasian
  demand function `xs i : DemandFunction L` (MWG Chapter 2's `x(p, w)`, read on the domain
  `p ≫ 0`, `w > 0`).
* **Section 4.B** (p. 106): aggregate demand `x(p, w₁, …, w_I) = ∑ᵢ xᵢ(p, wᵢ)` (`aggDemand`),
  invariance to redistributions of a given total wealth (`RedistributionInvariant`) and
  straight, parallel wealth expansion paths (`ParallelLinearEngel`).
* **Section 4.B** (pp. 108-109): a wealth distribution rule `(w₁(p, w), …, w_I(p, w))` with
  `∑ᵢ wᵢ(p, w) = w` (`IsWealthDistributionRule`), the induced aggregate demand
  `x(p, w) = ∑ᵢ xᵢ(p, wᵢ(p, w))` (`ruleDemand`), and the price-independent share rule
  `wᵢ(p, w) = αᵢ w` of Section 4.C (`shareDemand`).
* **Section 4.C** (p. 109, footnote 6): continuity, homogeneity of degree zero and Walras' law
  pass to aggregate demand (`ruleDemand_homogeneousZero`, `ruleDemand_walrasLaw`,
  `ruleDemand_continuousOn`); footnote 7: a proportional change in all wealths is a
  proportional change in prices (`footnote_4_C_7`).
* **Section 4.B** (p. 108): with identical preferences, aggregate demand depends only on the
  statistical distribution of wealth (`aggDemand_perm`).
-/

namespace MWG.AggregateDemand

open MWG.ConsumerChoice

variable {L I : ℕ}

/-- **Section 4.B** (MWG, p. 106). Aggregate demand `x(p, w₁, …, w_I) = ∑ᵢ xᵢ(p, wᵢ)` at prices
`p` and the wealth distribution `ws`. -/
def aggDemand (xs : Fin I → DemandFunction L) (p : Fin L → ℝ) (ws : Fin I → ℝ) :
    Fin L → ℝ :=
  ∑ i, xs i p (ws i)

/-- **Section 4.B** (MWG, p. 106). Aggregate demand is invariant to redistributions of wealth:
`∑ᵢ xᵢ(p, wᵢ) = ∑ᵢ xᵢ(p, w'ᵢ)` whenever `∑ᵢ wᵢ = ∑ᵢ w'ᵢ` (all wealths positive, `p ≫ 0`), so
that aggregate demand can be written `x(p, ∑ᵢ wᵢ)`. -/
def RedistributionInvariant (xs : Fin I → DemandFunction L) : Prop :=
  ∀ p, StrictlyPositive p → ∀ ws ws' : Fin I → ℝ, (∀ i, 0 < ws i) → (∀ i, 0 < ws' i) →
    ∑ i, ws i = ∑ i, ws' i → aggDemand xs p ws = aggDemand xs p ws'

/-- **Section 4.B** (MWG, p. 107; Figure 4.B.1). At every price vector the consumers' wealth
expansion paths are straight lines with a common direction:
`xᵢ(p, w) = aᵢ(p) + w b(p)` for all `i` and all `w > 0`. -/
def ParallelLinearEngel (xs : Fin I → DemandFunction L) : Prop :=
  ∀ p, StrictlyPositive p → ∃ a : Fin I → Fin L → ℝ, ∃ b : Fin L → ℝ,
    ∀ i w, 0 < w → xs i p w = a i + w • b

/-- **Section 4.B** (MWG, p. 108). A wealth distribution rule: individual wealths `wᵢ(p, w)` that
add up to aggregate wealth, `∑ᵢ wᵢ(p, w) = w` for all `(p, w)`. -/
def IsWealthDistributionRule (wr : Fin I → (Fin L → ℝ) → ℝ → ℝ) : Prop :=
  ∀ p w, ∑ i, wr i p w = w

/-- **Section 4.B** (MWG, p. 109). The aggregate demand generated by a wealth distribution rule,
`x(p, w) = ∑ᵢ xᵢ(p, wᵢ(p, w))`, a function of prices and aggregate wealth only. -/
def ruleDemand (xs : Fin I → DemandFunction L) (wr : Fin I → (Fin L → ℝ) → ℝ → ℝ) :
    DemandFunction L :=
  fun p w => ∑ i, xs i p (wr i p w)

/-- **Section 4.C** (MWG, p. 109). The price-independent distribution rule `wᵢ(p, w) = αᵢ w`. -/
def shareRule (α : Fin I → ℝ) : Fin I → (Fin L → ℝ) → ℝ → ℝ := fun i _ w => α i * w

/-- **Section 4.C** (MWG, p. 109). Wealth shares: `αᵢ ≥ 0`, `∑ᵢ αᵢ = 1`. -/
def IsShareVector (α : Fin I → ℝ) : Prop := (∀ i, 0 ≤ α i) ∧ ∑ i, α i = 1

/-- **Section 4.C** (MWG, p. 109). Aggregate demand with fixed wealth shares,
`x(p, w) = ∑ᵢ xᵢ(p, αᵢ w)`. -/
def shareDemand (xs : Fin I → DemandFunction L) (α : Fin I → ℝ) : DemandFunction L :=
  fun p w => ∑ i, xs i p (α i * w)

/-- The share demand is the demand of the share rule. -/
theorem shareDemand_eq_ruleDemand (xs : Fin I → DemandFunction L) (α : Fin I → ℝ) :
    shareDemand xs α = ruleDemand xs (shareRule α) := rfl

/-- The demand of a rule at `(p, w)` is aggregate demand at the distribution `(wᵢ(p, w))ᵢ`. -/
theorem ruleDemand_eq_aggDemand (xs : Fin I → DemandFunction L)
    (wr : Fin I → (Fin L → ℝ) → ℝ → ℝ) (p : Fin L → ℝ) (w : ℝ) :
    ruleDemand xs wr p w = aggDemand xs p (fun i => wr i p w) := rfl

/-- **Section 4.C** (MWG, p. 109). Shares adding up to one give a wealth distribution rule. -/
theorem isWealthDistributionRule_shareRule {α : Fin I → ℝ} (hα : ∑ i, α i = 1) :
    IsWealthDistributionRule (L := L) (shareRule α) := by
  intro p w
  simp only [shareRule]
  rw [← Finset.sum_mul, hα, one_mul]

/-- **Section 4.B** (MWG, p. 109). Under a wealth distribution rule, aggregate demand at `(p, w)`
depends only on prices and aggregate wealth: two pairs with the same `(p, w)` give the same
aggregate demand, and the distribution used adds up to `w`. -/
theorem ruleDemand_spec {xs : Fin I → DemandFunction L} {wr : Fin I → (Fin L → ℝ) → ℝ → ℝ}
    (hwr : IsWealthDistributionRule wr) (p : Fin L → ℝ) (w : ℝ) :
    ruleDemand xs wr p w = aggDemand xs p (fun i => wr i p w) ∧ ∑ i, wr i p w = w :=
  ⟨rfl, hwr p w⟩

/-- **Section 4.B** (MWG, p. 108). When all consumers have the same demand function, aggregate
demand depends only on the statistical distribution of wealth: relabelling who holds which
wealth level does not change it. -/
theorem aggDemand_perm (x : DemandFunction L) (p : Fin L → ℝ) (ws : Fin I → ℝ)
    (σ : Equiv.Perm (Fin I)) :
    aggDemand (fun _ => x) p (ws ∘ σ) = aggDemand (fun _ => x) p ws := by
  unfold aggDemand
  exact Equiv.sum_comp σ (fun i => x p (ws i))

/-- Aggregate demand of a family whose wealth expansion paths are straight lines with a common
direction depends on wealths only through their sum. -/
theorem aggDemand_of_linear {xs : Fin I → DemandFunction L} {p : Fin L → ℝ}
    {a : Fin I → Fin L → ℝ} {b : Fin L → ℝ} (h : ∀ i w, 0 < w → xs i p w = a i + w • b)
    {ws : Fin I → ℝ} (hws : ∀ i, 0 < ws i) :
    aggDemand xs p ws = ∑ i, a i + (∑ i, ws i) • b := by
  unfold aggDemand
  rw [Finset.sum_congr rfl fun i _ => h i (ws i) (hws i), Finset.sum_add_distrib,
    Finset.sum_smul]

/-- **Section 4.C** (MWG, p. 109, footnote 6). If every individual demand is homogeneous of
degree zero and every `wᵢ(·, ·)` is homogeneous of degree one and positive on the domain, the
aggregate demand of the rule is homogeneous of degree zero. -/
theorem ruleDemand_homogeneousZero {xs : Fin I → DemandFunction L}
    {wr : Fin I → (Fin L → ℝ) → ℝ → ℝ} (hx : ∀ i, HomogeneousZero (xs i))
    (hpos : ∀ i p w, PWDomain p w → 0 < wr i p w)
    (hhom : ∀ i p w α, PWDomain p w → 0 < α → wr i (α • p) (α * w) = α * wr i p w) :
    HomogeneousZero (ruleDemand xs wr) := by
  intro p w α hd hα
  unfold ruleDemand
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [hhom i p w α hd hα]
  exact hx i p (wr i p w) α ⟨hd.1, hpos i p w hd⟩ hα

/-- **Section 4.C** (MWG, p. 109). If every individual demand satisfies Walras' law and the
rule is a positive wealth distribution rule, aggregate demand satisfies Walras' law:
`p·x(p, w) = ∑ᵢ wᵢ(p, w) = w`. -/
theorem ruleDemand_walrasLaw {xs : Fin I → DemandFunction L}
    {wr : Fin I → (Fin L → ℝ) → ℝ → ℝ} (hx : ∀ i, WalrasLaw (xs i))
    (hwr : IsWealthDistributionRule wr) (hpos : ∀ i p w, PWDomain p w → 0 < wr i p w) :
    WalrasLaw (ruleDemand xs wr) := by
  intro p w hd
  unfold ruleDemand
  rw [dotProduct_sum]
  calc ∑ i, p ⬝ᵥ xs i p (wr i p w) = ∑ i, wr i p w :=
        Finset.sum_congr rfl fun i _ => hx i p (wr i p w) ⟨hd.1, hpos i p w hd⟩
    _ = w := hwr p w

/-- **Section 4.C** (MWG, p. 109, footnote 6). If every individual demand is continuous on the
domain and every `wᵢ(·, ·)` is continuous and positive on the domain, aggregate demand is
continuous on the domain. -/
theorem ruleDemand_continuousOn {xs : Fin I → DemandFunction L}
    {wr : Fin I → (Fin L → ℝ) → ℝ → ℝ}
    (hx : ∀ i, ContinuousOn (Function.uncurry (xs i)) {q | PWDomain q.1 q.2})
    (hwc : ∀ i, ContinuousOn (Function.uncurry (wr i)) {q | PWDomain q.1 q.2})
    (hpos : ∀ i p w, PWDomain p w → 0 < wr i p w) :
    ContinuousOn (Function.uncurry (ruleDemand xs wr)) {q | PWDomain q.1 q.2} := by
  have : Function.uncurry (ruleDemand xs wr) =
      fun q => ∑ i, Function.uncurry (xs i) (q.1, Function.uncurry (wr i) q) := by
    funext q
    rfl
  rw [this]
  refine continuousOn_finsetSum _ fun i _ => ?_
  refine (hx i).comp (continuousOn_fst.prodMk (hwc i)) ?_
  intro q hq
  exact ⟨hq.1, hpos i q.1 q.2 hq⟩

/-- **Section 4.C** (MWG, p. 109, footnote 7). With demands homogeneous of degree zero, a
proportional change `t > 0` in every consumer's wealth is a proportional change `1/t` in prices:
`∑ᵢ xᵢ(p, t wᵢ) = ∑ᵢ xᵢ(t⁻¹ p, wᵢ)`. -/
theorem footnote_4_C_7 {xs : Fin I → DemandFunction L} (hx : ∀ i, HomogeneousZero (xs i))
    {p : Fin L → ℝ} (hp : StrictlyPositive p) {ws : Fin I → ℝ} (hws : ∀ i, 0 < ws i) {t : ℝ}
    (ht : 0 < t) :
    aggDemand xs p (fun i => t * ws i) = aggDemand xs (t⁻¹ • p) ws := by
  unfold aggDemand
  refine Finset.sum_congr rfl fun i _ => ?_
  have hd : PWDomain p (t * ws i) := ⟨hp, mul_pos ht (hws i)⟩
  have := hx i p (t * ws i) t⁻¹ hd (inv_pos.mpr ht)
  rw [← this, ← mul_assoc, inv_mul_cancel₀ ht.ne', one_mul]

end MWG.AggregateDemand
