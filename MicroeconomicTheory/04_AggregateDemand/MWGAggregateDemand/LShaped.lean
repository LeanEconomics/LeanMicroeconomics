import MWGAggregateDemand.LawOfDemand
import MWGClassicalDemand.UMPBasic

/-!
# L-shaped indifference curves and the counterexamples of Section 4.C

MWG, Section 4.C, Example 4.C.1 (p. 110) and Exercises 4.C.3, 4.C.12, 4.C.13 (pp. 124-125).

Two goods. The utility `u(x) = min(φ(x₁), ψ(x₂))` with `φ`, `ψ` strictly increasing has
L-shaped indifference curves with kinks on the curve `φ(x₁) = ψ(x₂)`; with no substitution
effects, demand is the point of the kink curve on the budget line (`walrasianDemand_minUtility`),
so demands can be computed exactly. Piecewise-linear kink curves (written with `min`/`max` of
affine functions) produce the book's graphical examples with exact rational numbers.

* `weakAxiom_of_unique_demand`: a demand function generated by a utility with single-valued
  demand satisfies the weak axiom (the individual demands of Example 4.C.1 do).
* `example_4_C_1`: two consumers with equal wealth whose individual demands satisfy the weak
  axiom while aggregate demand violates it (both inequalities strict, as in Figure 4.C.1).
* `exercise_4_C_3`: a preference-generated demand that violates the ULD.
* `exercise_4_C_12`: identical preferences, wealths `1` and `3` (shares `1/4`, `3/4`):
  aggregate demand violates the weak axiom.
* `exercise_4_C_13`: two homothetic (Leontief) consumers, wealth rule
  `w₁ = w p₁/(p₁ + p₂)`, `w₂ = w p₂/(p₁ + p₂)`: each satisfies the ULD, the aggregate violates
  the weak axiom. Proposition 4.C.1 does not apply because the rule depends on prices.
-/

namespace MWG.AggregateDemand

open MWG.ConsumerChoice MWG.ClassicalDemand

variable {L : ℕ}

/-- A demand function selection exists for a utility continuous on `ℝ^L_+` (MWG
Proposition 3.D.1). -/
theorem exists_demandFunction {u : (Fin L → ℝ) → ℝ} (hu : ContinuousOn u (nonnegOrthant L)) :
    ∃ xf : DemandFunction L, ∀ p w, PWDomain p w → xf p w ∈ walrasianDemand u p w := by
  classical
  refine ⟨fun p w => if h : PWDomain p w then (proposition_3_D_1 hu h.1 h.2.le).some else 0,
    fun p w hd => ?_⟩
  simp only [hd, dite_true]
  exact (proposition_3_D_1 hu hd.1 hd.2.le).some_mem

/-- **Section 4.C** (MWG, p. 110). If a utility has a single-valued Walrasian demand
`x(p, w)` at every `(p, w)`, then `x(·, ·)` satisfies the weak axiom (if `x(p', w')` is
affordable at `(p, w)` and differs from `x(p, w)`, it is strictly worse, so `x(p, w)` cannot be
affordable at `(p', w')`). -/
theorem weakAxiom_of_unique_demand {u : (Fin L → ℝ) → ℝ} {xf : DemandFunction L}
    (hxf : ∀ p w, PWDomain p w → walrasianDemand u p w = {xf p w}) : WeakAxiom xf := by
  intro p w p' w' hd hd' hle hne
  have hx : xf p w ∈ walrasianDemand u p w := by rw [hxf p w hd]; rfl
  have hx' : xf p' w' ∈ walrasianDemand u p' w' := by rw [hxf p' w' hd']; rfl
  have hB : xf p' w' ∈ budgetSet p w := ⟨hx'.1.1, hle⟩
  have hlt : u (xf p' w') < u (xf p w) := by
    rcases (hx.2 _ hB).lt_or_eq with h | h
    · exact h
    · exfalso
      have hmem : xf p' w' ∈ walrasianDemand u p w :=
        ⟨hB, fun y hy => (hx.2 y hy).trans h.ge⟩
      rw [hxf p w hd] at hmem
      exact hne hmem
  by_contra hcon
  push Not at hcon
  have := hx'.2 _ ⟨hx.1.1, hcon⟩
  linarith

/-- Pointwise minimum of strictly increasing functions is strictly increasing. -/
theorem strictMono_min_fun {f g : ℝ → ℝ} (hf : StrictMono f) (hg : StrictMono g) :
    StrictMono fun t => min (f t) (g t) :=
  fun _ _ h => min_lt_min (hf h) (hg h)

/-- Pointwise maximum of strictly increasing functions is strictly increasing. -/
theorem strictMono_max_fun {f g : ℝ → ℝ} (hf : StrictMono f) (hg : StrictMono g) :
    StrictMono fun t => max (f t) (g t) :=
  fun _ _ h => max_lt_max (hf h) (hg h)

/-- A strictly increasing affine function. -/
theorem strictMono_affine {a b : ℝ} (ha : 0 < a) : StrictMono fun t : ℝ => a * t + b :=
  fun _ _ h => by simp only; nlinarith

/-- The two-good utility `min(φ(x₁), ψ(x₂))`, with L-shaped indifference curves when `φ`, `ψ`
are strictly increasing; its kinks lie on the curve `φ(x₁) = ψ(x₂)`. -/
def minUtility (φ ψ : ℝ → ℝ) (x : Fin 2 → ℝ) : ℝ := min (φ (x 0)) (ψ (x 1))

/-- `min(φ(x₁), ψ(x₂))` is continuous when `φ` and `ψ` are. -/
theorem continuous_minUtility {φ ψ : ℝ → ℝ} (hφ : Continuous φ) (hψ : Continuous ψ) :
    Continuous (minUtility φ ψ) := by
  unfold minUtility
  fun_prop

/-- The dot product on `ℝ²`. -/
theorem dotProduct_two (p x : Fin 2 → ℝ) : p ⬝ᵥ x = p 0 * x 0 + p 1 * x 1 := by
  simp [dotProduct, Fin.sum_univ_two]

/-- **Section 4.C** (MWG, p. 110; Exercise 4.C.4). With L-shaped indifference curves, the
Walrasian demand at `(p, w)` is the unique point `y ≥ 0` of the kink curve `φ(y₁) = ψ(y₂)` on
the budget line `p·y = w`. -/
theorem walrasianDemand_minUtility {φ ψ : ℝ → ℝ} (hφ : StrictMono φ) (hψ : StrictMono ψ)
    {p : Fin 2 → ℝ} (hp : StrictlyPositive p) {w : ℝ} {y : Fin 2 → ℝ} (hy0 : 0 ≤ y 0)
    (hy1 : 0 ≤ y 1) (hk : φ (y 0) = ψ (y 1)) (hb : p ⬝ᵥ y = w) :
    walrasianDemand (minUtility φ ψ) p w = {y} := by
  have hyB : y ∈ budgetSet p w := ⟨fun l => by fin_cases l <;> assumption, hb.le⟩
  have hp0 := hp 0
  have hp1 := hp 1
  have hmax : ∀ z ∈ budgetSet p w, minUtility φ ψ z ≤ minUtility φ ψ y := by
    intro z hz
    by_contra hlt
    push Not at hlt
    simp only [minUtility, hk, min_self, lt_min_iff] at hlt
    have h0 : y 0 < z 0 := hφ.lt_iff_lt.mp (hk ▸ hlt.1)
    have h1 : y 1 < z 1 := hψ.lt_iff_lt.mp hlt.2
    have := hz.2
    rw [dotProduct_two] at this hb
    nlinarith
  ext z
  constructor
  · intro hz
    have hge := hz.2 y hyB
    simp only [minUtility, hk, min_self, le_min_iff] at hge
    have h0 : y 0 ≤ z 0 := hφ.le_iff_le.mp (hk ▸ hge.1)
    have h1 : y 1 ≤ z 1 := hψ.le_iff_le.mp hge.2
    have hzb := hz.1.2
    rw [dotProduct_two] at hzb hb
    have e0 : z 0 = y 0 := by nlinarith
    have e1 : z 1 = y 1 := by nlinarith
    change z = y
    funext l
    fin_cases l
    · exact e0
    · exact e1
  · rintro rfl
    exact ⟨hyB, hmax⟩

/-! ### Example 4.C.1 -/

/-- The kink curve of consumer 1 in Example 4.C.1: `φ(t) = min(4t, t/4 + 15/8)` (slope `4` up to
`t = 1/2`, then slope `1/4`). -/
noncomputable def ex41Kink (t : ℝ) : ℝ := min (4 * t) (t / 4 + 15 / 8)

theorem strictMono_ex41Kink : StrictMono ex41Kink := by
  have h1 : StrictMono fun t : ℝ => 4 * t + 0 := strictMono_affine (by norm_num)
  have h2 : StrictMono fun t : ℝ => (1 / 4) * t + 15 / 8 := strictMono_affine (by norm_num)
  have := strictMono_min_fun h1 h2
  convert this using 2 with t
  simp only [ex41Kink, add_zero]
  ring_nf

theorem continuous_ex41Kink : Continuous ex41Kink := by
  unfold ex41Kink
  fun_prop

/-- Consumer 1 of Example 4.C.1: `u₁(x) = min(φ(x₁), x₂)`. -/
noncomputable def ex41U1 : (Fin 2 → ℝ) → ℝ := minUtility ex41Kink id

/-- Consumer 2 of Example 4.C.1, the mirror image: `u₂(x) = min(x₁, φ(x₂))`. -/
noncomputable def ex41U2 : (Fin 2 → ℝ) → ℝ := minUtility id ex41Kink

theorem continuousOn_ex41U1 : ContinuousOn ex41U1 (nonnegOrthant 2) :=
  (continuous_minUtility continuous_ex41Kink continuous_id).continuousOn

theorem continuousOn_ex41U2 : ContinuousOn ex41U2 (nonnegOrthant 2) :=
  (continuous_minUtility continuous_id continuous_ex41Kink).continuousOn

/-- The price vector `p = (1, 1/2)` of Example 4.C.1. -/
noncomputable def ex41P : Fin 2 → ℝ := ![1, 1 / 2]

/-- The price vector `p' = (1/2, 1)` of Example 4.C.1. -/
noncomputable def ex41P' : Fin 2 → ℝ := ![1 / 2, 1]

theorem ex41P_pos : StrictlyPositive ex41P := by
  intro l; fin_cases l <;> simp [ex41P]

theorem ex41P'_pos : StrictlyPositive ex41P' := by
  intro l; fin_cases l <;> simp [ex41P']

/-- **Example 4.C.1** (MWG, p. 110; Figure 4.C.1). Two consumers with L-shaped preferences
`u₁ = min(φ(x₁), x₂)`, `u₂ = min(x₁, φ(x₂))`, `φ(t) = min(4t, t/4 + 15/8)`, and equal wealth
`w/2` each. Any demand functions `x₁`, `x₂` they generate satisfy the weak axiom, but at
`w = 4`, `p = (1, 1/2)`, `p' = (1/2, 1)` the aggregate `x(p, w) = x₁(p, w/2) + x₂(p, w/2)` has
`p·x(p', w) < w` and `p'·x(p, w) < w` with `x(p, w) ≠ x(p', w)`: aggregate demand violates the
weak axiom. -/
theorem example_4_C_1 {x1 x2 : DemandFunction 2}
    (hx1 : ∀ p w, PWDomain p w → x1 p w ∈ walrasianDemand ex41U1 p w)
    (hx2 : ∀ p w, PWDomain p w → x2 p w ∈ walrasianDemand ex41U2 p w) :
    shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P 4 = ![49 / 18, 23 / 9] ∧
      shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P' 4 = ![23 / 9, 49 / 18] ∧
      ex41P ⬝ᵥ shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P' 4 < 4 ∧
      ex41P' ⬝ᵥ shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P 4 < 4 ∧
      ¬ WeakAxiom (shareDemand ![x1, x2] ![1 / 2, 1 / 2]) := by
  have hk := strictMono_ex41Kink
  have hid : StrictMono (id : ℝ → ℝ) := strictMono_id
  have d1 : x1 ex41P 2 = ![17 / 18, 19 / 9] := by
    have h := walrasianDemand_minUtility hk hid ex41P_pos (w := 2) (y := ![17 / 18, 19 / 9])
      (by norm_num) (by norm_num) (by norm_num [ex41Kink, min_def])
      (by norm_num [dotProduct_two, ex41P])
    have := hx1 ex41P 2 ⟨ex41P_pos, by norm_num⟩
    rw [ex41U1, h] at this
    exact this
  have d2 : x2 ex41P 2 = ![16 / 9, 4 / 9] := by
    have h := walrasianDemand_minUtility hid hk ex41P_pos (w := 2) (y := ![16 / 9, 4 / 9])
      (by norm_num) (by norm_num) (by norm_num [ex41Kink, min_def])
      (by norm_num [dotProduct_two, ex41P])
    have := hx2 ex41P 2 ⟨ex41P_pos, by norm_num⟩
    rw [ex41U2, h] at this
    exact this
  have d1' : x1 ex41P' 2 = ![4 / 9, 16 / 9] := by
    have h := walrasianDemand_minUtility hk hid ex41P'_pos (w := 2) (y := ![4 / 9, 16 / 9])
      (by norm_num) (by norm_num) (by norm_num [ex41Kink, min_def])
      (by norm_num [dotProduct_two, ex41P'])
    have := hx1 ex41P' 2 ⟨ex41P'_pos, by norm_num⟩
    rw [ex41U1, h] at this
    exact this
  have d2' : x2 ex41P' 2 = ![19 / 9, 17 / 18] := by
    have h := walrasianDemand_minUtility hid hk ex41P'_pos (w := 2) (y := ![19 / 9, 17 / 18])
      (by norm_num) (by norm_num) (by norm_num [ex41Kink, min_def])
      (by norm_num [dotProduct_two, ex41P'])
    have := hx2 ex41P' 2 ⟨ex41P'_pos, by norm_num⟩
    rw [ex41U2, h] at this
    exact this
  have hagg : shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P 4 = ![49 / 18, 23 / 9] := by
    simp only [shareDemand, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
    norm_num [d1, d2]
  have hagg' : shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P' 4 = ![23 / 9, 49 / 18] := by
    simp only [shareDemand, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
    norm_num [d1', d2']
  have h1 : ex41P ⬝ᵥ shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P' 4 < 4 := by
    rw [hagg', dotProduct_two]
    norm_num [ex41P]
  have h2 : ex41P' ⬝ᵥ shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P 4 < 4 := by
    rw [hagg, dotProduct_two]
    norm_num [ex41P']
  refine ⟨hagg, hagg', h1, h2, fun hWA => ?_⟩
  have hne : shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P' 4 ≠
      shareDemand ![x1, x2] ![1 / 2, 1 / 2] ex41P 4 := by
    rw [hagg, hagg']
    intro h
    have := congrFun h 0
    norm_num at this
  have := hWA ex41P 4 ex41P' 4 ⟨ex41P_pos, by norm_num⟩ ⟨ex41P'_pos, by norm_num⟩ h1.le hne
  linarith

/-- **Example 4.C.1** (MWG, p. 110). The individual demands in the example satisfy the weak
axiom: L-shaped preferences have single-valued demand at every `(p, w)`, and
`weakAxiom_of_unique_demand` applies. Here for consumer 1 (consumer 2 is its mirror image). -/
theorem example_4_C_1_individual_weakAxiom {x1 : DemandFunction 2}
    (hx1 : ∀ p w, PWDomain p w → walrasianDemand ex41U1 p w = {x1 p w}) : WeakAxiom x1 :=
  weakAxiom_of_unique_demand hx1

/-- The demand functions of Example 4.C.1 exist (the utilities are continuous). -/
theorem example_4_C_1_demands_exist :
    (∃ x1 : DemandFunction 2, ∀ p w, PWDomain p w → x1 p w ∈ walrasianDemand ex41U1 p w) ∧
      ∃ x2 : DemandFunction 2, ∀ p w, PWDomain p w → x2 p w ∈ walrasianDemand ex41U2 p w :=
  ⟨exists_demandFunction continuousOn_ex41U1, exists_demandFunction continuousOn_ex41U2⟩

/-- **Exercise 4.C.3** (MWG, p. 124). A preference relation (consumer 1 of Example 4.C.1,
L-shaped indifference curves bending along `φ(t) = min(4t, t/4 + 15/8)`) whose Walrasian demand
does not satisfy the ULD: at `w = 3`, `p = (1, 1/2)`, `p' = (1/2, 1)`,
`x(p, w) = (11/6, 7/3)`, `x(p', w) = (3/2, 9/4)` and `(p' - p)·[x(p', w) - x(p, w)] = 1/8 > 0`.
Interpretation: with no substitution effects, the price change acts only through wealth
effects, which move demand along the bent expansion path in the "wrong" direction. -/
theorem exercise_4_C_3 {x1 : DemandFunction 2}
    (hx1 : ∀ p w, PWDomain p w → x1 p w ∈ walrasianDemand ex41U1 p w) :
    (ex41P' - ex41P) ⬝ᵥ (x1 ex41P' 3 - x1 ex41P 3) = 1 / 8 ∧
      ¬ UncompensatedLawOfDemand x1 := by
  have hk := strictMono_ex41Kink
  have hid : StrictMono (id : ℝ → ℝ) := strictMono_id
  have d1 : x1 ex41P 3 = ![11 / 6, 7 / 3] := by
    have h := walrasianDemand_minUtility hk hid ex41P_pos (w := 3) (y := ![11 / 6, 7 / 3])
      (by norm_num) (by norm_num) (by norm_num [ex41Kink, min_def])
      (by norm_num [dotProduct_two, ex41P])
    have := hx1 ex41P 3 ⟨ex41P_pos, by norm_num⟩
    rw [ex41U1, h] at this
    exact this
  have d1' : x1 ex41P' 3 = ![3 / 2, 9 / 4] := by
    have h := walrasianDemand_minUtility hk hid ex41P'_pos (w := 3) (y := ![3 / 2, 9 / 4])
      (by norm_num) (by norm_num) (by norm_num [ex41Kink, min_def])
      (by norm_num [dotProduct_two, ex41P'])
    have := hx1 ex41P' 3 ⟨ex41P'_pos, by norm_num⟩
    rw [ex41U1, h] at this
    exact this
  have hval : (ex41P' - ex41P) ⬝ᵥ (x1 ex41P' 3 - x1 ex41P 3) = 1 / 8 := by
    rw [d1, d1', dotProduct_two]
    norm_num [ex41P, ex41P']
  refine ⟨hval, fun hU => ?_⟩
  have := (hU ex41P ex41P' 3 ⟨ex41P_pos, by norm_num⟩ ex41P'_pos).1
  linarith

/-! ### Exercise 4.C.12 -/

/-- The kink curve of Exercise 4.C.12: `φ(t) = min(max(t, 4t - 3/2), 2t)` (slopes `1`, `4`, `2`
with kinks at `t = 1/2` and `t = 3/4`). -/
noncomputable def ex412Kink (t : ℝ) : ℝ := min (max t (4 * t - 3 / 2)) (2 * t)

theorem strictMono_ex412Kink : StrictMono ex412Kink := by
  have h1 : StrictMono fun t : ℝ => 1 * t + 0 := strictMono_affine one_pos
  have h2 : StrictMono fun t : ℝ => 4 * t + -(3 / 2) := strictMono_affine (by norm_num)
  have h3 : StrictMono fun t : ℝ => 2 * t + 0 := strictMono_affine (by norm_num)
  have := strictMono_min_fun (strictMono_max_fun h1 h2) h3
  convert this using 2 with t
  simp only [ex412Kink, one_mul, add_zero]
  ring_nf

/-- The common utility of Exercise 4.C.12: `u(x) = min(φ(x₁), x₂)`. -/
noncomputable def ex412U : (Fin 2 → ℝ) → ℝ := minUtility ex412Kink id

/-- **Exercise 4.C.12** (MWG, p. 125). Two consumers with identical preferences
`u = min(φ(x₁), x₂)`, `φ(t) = min(max(t, 4t - 3/2), 2t)`, and wealths in the ratio `1 : 3`
(shares `1/4`, `3/4`; wealths exactly `1` and `3` at `w = 4`). Aggregate demand is a function of
the wealth distribution, yet it violates the weak axiom: at `p = (1, 1)`, `w = 4` and
`p' = (1/3, 1)`, `w' = 3`, `x(p, w) = (3/2, 5/2)`, `x(p', w') = (135/91, 228/91)`,
`p·x(p', w') ≤ w` and `p'·x(p, w) ≤ w'`. -/
theorem exercise_4_C_12 {x : DemandFunction 2}
    (hx : ∀ p w, PWDomain p w → x p w ∈ walrasianDemand ex412U p w) :
    shareDemand ![x, x] ![1 / 4, 3 / 4] ![1, 1] 4 = ![3 / 2, 5 / 2] ∧
      shareDemand ![x, x] ![1 / 4, 3 / 4] ![1 / 3, 1] 3 = ![135 / 91, 228 / 91] ∧
      ¬ WeakAxiom (shareDemand ![x, x] ![1 / 4, 3 / 4]) := by
  have hk := strictMono_ex412Kink
  have hid : StrictMono (id : ℝ → ℝ) := strictMono_id
  have hp : StrictlyPositive (![1, 1] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hp' : StrictlyPositive (![1 / 3, 1] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have dem : ∀ (q : Fin 2 → ℝ) (v : ℝ) (y : Fin 2 → ℝ), StrictlyPositive q → 0 < v →
      0 ≤ y 0 → 0 ≤ y 1 → ex412Kink (y 0) = y 1 → q ⬝ᵥ y = v → x q v = y := by
    intro q v y hq hv hy0 hy1 hky hb
    have h := walrasianDemand_minUtility hk hid hq hy0 hy1 hky hb
    have := hx q v ⟨hq, hv⟩
    rw [ex412U, h] at this
    exact this
  have a1 : x ![1, 1] (1 / 4 * 4) = ![1 / 2, 1 / 2] :=
    dem _ _ _ hp (by norm_num) (by norm_num) (by norm_num) (by norm_num [ex412Kink, min_def,
      max_def]) (by norm_num [dotProduct_two])
  have a2 : x ![1, 1] (3 / 4 * 4) = ![1, 2] :=
    dem _ _ _ hp (by norm_num) (by norm_num) (by norm_num) (by norm_num [ex412Kink, min_def,
      max_def]) (by norm_num [dotProduct_two])
  have b1 : x ![1 / 3, 1] (1 / 4 * 3) = ![27 / 52, 15 / 26] :=
    dem _ _ _ hp' (by norm_num) (by norm_num) (by norm_num) (by norm_num [ex412Kink, min_def,
      max_def]) (by norm_num [dotProduct_two])
  have b2 : x ![1 / 3, 1] (3 / 4 * 3) = ![27 / 28, 27 / 14] :=
    dem _ _ _ hp' (by norm_num) (by norm_num) (by norm_num) (by norm_num [ex412Kink, min_def,
      max_def]) (by norm_num [dotProduct_two])
  have hA : shareDemand ![x, x] ![1 / 4, 3 / 4] ![1, 1] 4 = ![3 / 2, 5 / 2] := by
    simp only [shareDemand, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one]
    rw [a1, a2]
    funext l
    fin_cases l <;> norm_num
  have hB : shareDemand ![x, x] ![1 / 4, 3 / 4] ![1 / 3, 1] 3 = ![135 / 91, 228 / 91] := by
    simp only [shareDemand, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one]
    rw [b1, b2]
    funext l
    fin_cases l <;> norm_num
  refine ⟨hA, hB, fun hWA => ?_⟩
  have hne : shareDemand ![x, x] ![1 / 4, 3 / 4] ![1 / 3, 1] 3 ≠
      shareDemand ![x, x] ![1 / 4, 3 / 4] ![1, 1] 4 := by
    rw [hA, hB]
    intro h
    have := congrFun h 0
    norm_num at this
  have h1 : (![1, 1] : Fin 2 → ℝ) ⬝ᵥ shareDemand ![x, x] ![1 / 4, 3 / 4] ![1 / 3, 1] 3 ≤ 4 := by
    rw [hB, dotProduct_two]
    norm_num
  have := hWA ![1, 1] 4 ![1 / 3, 1] 3 ⟨hp, by norm_num⟩ ⟨hp', by norm_num⟩ h1 hne
  rw [hA, dotProduct_two] at this
  norm_num at this

/-! ### Exercise 4.C.13 -/

/-- Leontief utility `min(x₁/a₁, x₂/a₂)` with kink ray `a ≫ 0` (homogeneous of degree one). -/
noncomputable def leontiefU (a : Fin 2 → ℝ) : (Fin 2 → ℝ) → ℝ :=
  minUtility (fun t => t / a 0) (fun t => t / a 1)

/-- The Leontief demand `x(p, w) = (w/(p·a)) a`. -/
noncomputable def leontiefRayDemand (a : Fin 2 → ℝ) : DemandFunction 2 :=
  fun p w => (w / (p ⬝ᵥ a)) • a

/-- The Leontief demand is the unique Walrasian demand of `min(x₁/a₁, x₂/a₂)`. -/
theorem walrasianDemand_leontiefU {a : Fin 2 → ℝ} (ha : StrictlyPositive a) {p : Fin 2 → ℝ}
    (hp : StrictlyPositive p) {w : ℝ} (hw : 0 ≤ w) :
    walrasianDemand (leontiefU a) p w = {leontiefRayDemand a p w} := by
  have hpa : 0 < p ⬝ᵥ a := by
    rw [dotProduct_two]
    nlinarith [hp 0, hp 1, ha 0, ha 1]
  have h0 := ha 0
  have h1 := ha 1
  apply walrasianDemand_minUtility (fun s t h => div_lt_div_of_pos_right h h0)
    (fun s t h => div_lt_div_of_pos_right h h1) hp
  · simp only [leontiefRayDemand, Pi.smul_apply, smul_eq_mul]
    exact mul_nonneg (div_nonneg hw hpa.le) h0.le
  · simp only [leontiefRayDemand, Pi.smul_apply, smul_eq_mul]
    exact mul_nonneg (div_nonneg hw hpa.le) h1.le
  · simp only [leontiefRayDemand, Pi.smul_apply, smul_eq_mul]
    field_simp
  · simp only [leontiefRayDemand, dotProduct_smul, smul_eq_mul]
    field_simp

/-- The Leontief utility is homogeneous of degree one on `ℝ²_+`. -/
theorem leontiefU_homogeneousOne (a : Fin 2 → ℝ) : HomogeneousOneOn (leontiefU a) := by
  intro x _ t ht
  simp only [leontiefU, minUtility, Pi.smul_apply, smul_eq_mul]
  rw [mul_div_assoc, mul_div_assoc, mul_min_of_nonneg _ _ ht.le]

/-- A Leontief demand satisfies Walras' law. -/
theorem leontiefRayDemand_walrasLaw {a : Fin 2 → ℝ} (ha : StrictlyPositive a) :
    WalrasLaw (leontiefRayDemand a) := by
  intro p w hd
  have hpa : 0 < p ⬝ᵥ a := by
    rw [dotProduct_two]
    nlinarith [hd.1 0, hd.1 1, ha 0, ha 1]
  simp only [leontiefRayDemand, dotProduct_smul, smul_eq_mul]
  field_simp

/-- A Leontief consumer (homothetic preferences) satisfies the ULD, by Proposition 4.C.2. -/
theorem leontiefRayDemand_uld {a : Fin 2 → ℝ} (ha : StrictlyPositive a) :
    UncompensatedLawOfDemand (leontiefRayDemand a) := by
  apply proposition_4_C_2 (leontiefU_homogeneousOne a)
  · intro y hy
    simp only [leontiefU, minUtility, lt_min_iff]
    exact ⟨div_pos (hy 0) (ha 0), div_pos (hy 1) (ha 1)⟩
  · intro p w hd
    rw [walrasianDemand_leontiefU ha hd.1 hd.2.le]
    exact Set.subsingleton_singleton
  · intro p w hd
    rw [walrasianDemand_leontiefU ha hd.1 hd.2.le]
    rfl
  · exact leontiefRayDemand_walrasLaw ha

/-- The price-dependent wealth rule of Exercise 4.C.13:
`w₁(p, w) = w p₁/(p₁ + p₂)`, `w₂(p, w) = w p₂/(p₁ + p₂)`. -/
noncomputable def ex413Rule : Fin 2 → (Fin 2 → ℝ) → ℝ → ℝ :=
  ![fun p w => w * p 0 / (p 0 + p 1), fun p w => w * p 1 / (p 0 + p 1)]

/-- The rule of Exercise 4.C.13 is a wealth distribution rule (at prices with `p₁ + p₂ ≠ 0`). -/
theorem ex413Rule_sum {p : Fin 2 → ℝ} (hp : p 0 + p 1 ≠ 0) (w : ℝ) :
    ∑ i, ex413Rule i p w = w := by
  simp only [ex413Rule, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one]
  field_simp

/-- **Exercise 4.C.13** (MWG, p. 125). Two consumers with homothetic (Leontief) preferences,
kink rays `(3, 1)` and `(1, 3)`, and the price-dependent wealth rule
`w₁ = w p₁/(p₁ + p₂)`, `w₂ = w p₂/(p₁ + p₂)`. Each consumer's demand satisfies the ULD
(Proposition 4.C.2), but at `p = (1, 1/3)`, `p' = (1/3, 1)`, `w = w' = 1` aggregate demand is
`(4/5, 3/5)` and `(3/5, 4/5)`, with `p·x(p', 1) = 13/15 < 1` and `p'·x(p, 1) = 13/15 < 1`:
the weak axiom fails. Proposition 4.C.1 does not apply because the wealth shares depend on
prices: a price change redistributes real wealth between the consumers. -/
theorem exercise_4_C_13 :
    UncompensatedLawOfDemand (leontiefRayDemand ![3, 1]) ∧
      UncompensatedLawOfDemand (leontiefRayDemand ![1, 3]) ∧
      ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]] ex413Rule
        ![1, 1 / 3] 1 = ![4 / 5, 3 / 5] ∧
      ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]] ex413Rule
        ![1 / 3, 1] 1 = ![3 / 5, 4 / 5] ∧
      ¬ WeakAxiom (ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]]
        ex413Rule) := by
  have ha : StrictlyPositive (![3, 1] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hb : StrictlyPositive (![1, 3] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hp : StrictlyPositive (![1, 1 / 3] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hp' : StrictlyPositive (![1 / 3, 1] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hA : ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]] ex413Rule
      ![1, 1 / 3] 1 = ![4 / 5, 3 / 5] := by
    funext l
    fin_cases l <;>
    · simp [ruleDemand, ex413Rule, leontiefRayDemand, Fin.sum_univ_two]
      norm_num
  have hB : ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]] ex413Rule
      ![1 / 3, 1] 1 = ![3 / 5, 4 / 5] := by
    funext l
    fin_cases l <;>
    · simp [ruleDemand, ex413Rule, leontiefRayDemand, Fin.sum_univ_two]
      norm_num
  refine ⟨leontiefRayDemand_uld ha, leontiefRayDemand_uld hb, hA, hB, fun hWA => ?_⟩
  have hne : ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]] ex413Rule
      ![1 / 3, 1] 1 ≠ ruleDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]]
        ex413Rule ![1, 1 / 3] 1 := by
    rw [hA, hB]
    intro h
    have := congrFun h 0
    norm_num at this
  have h1 : (![1, 1 / 3] : Fin 2 → ℝ) ⬝ᵥ ruleDemand ![leontiefRayDemand ![3, 1],
      leontiefRayDemand ![1, 3]] ex413Rule ![1 / 3, 1] 1 ≤ 1 := by
    rw [hB, dotProduct_two]
    norm_num
  have := hWA ![1, 1 / 3] 1 ![1 / 3, 1] 1 ⟨hp, by norm_num⟩ ⟨hp', by norm_num⟩ h1 hne
  rw [hA, dotProduct_two] at this
  norm_num at this

end MWG.AggregateDemand
