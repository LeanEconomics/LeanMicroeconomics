import MWGAggregateDemand.Representative

/-!
# The weak axiom versus invariance, and the strong axiom

MWG, Section 4.C, p. 115 (two remarks).

* `homothetic_weakAxiom_not_invariant`: aggregate demand may satisfy the weak axiom for a fixed
  wealth distribution without being invariant to redistribution: two homothetic (Leontief)
  consumers with different preferences.
* `identical_consumers_strongAxiom`: with identical preferences and equal wealth, aggregate
  demand satisfies the strong axiom: `x(p, w) = I x̃(p, w/I)` is the demand of `ũ(y) = u(y/I)`,
  a positive representative consumer.
-/

namespace MWG.AggregateDemand

open MWG.ConsumerChoice MWG.ClassicalDemand Kreps.PreferenceProperties

variable {L I : ℕ}

/-- A Leontief demand is homogeneous of degree zero. -/
theorem leontiefRayDemand_homogeneousZero (a : Fin 2 → ℝ) :
    HomogeneousZero (leontiefRayDemand a) := by
  intro p w t _ ht
  simp only [leontiefRayDemand, smul_dotProduct, smul_eq_mul]
  rw [mul_div_mul_left _ _ ht.ne']

/-- **Section 4.C** (MWG, p. 115). Aggregate demand satisfying the weak axiom for a fixed
distribution of wealth need not be invariant to redistribution: two consumers with homothetic
but different (Leontief, rays `(3, 1)` and `(1, 3)`) preferences and equal shares. The aggregate
satisfies the weak axiom (Propositions 4.C.1-4.C.2), but at `p = (1, 1)` moving wealth from
`(1, 1)` to `(3/2, 1/2)` changes aggregate demand from `(1, 1)` to `(5/4, 3/4)`. -/
theorem homothetic_weakAxiom_not_invariant :
    WeakAxiom (shareDemand ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]]
      ![1 / 2, 1 / 2]) ∧
      ¬ RedistributionInvariant ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]] := by
  have ha : StrictlyPositive (![3, 1] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hb : StrictlyPositive (![1, 3] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
  have hxs : ∀ i, StrictlyPositive (![![3, 1], ![1, 3]] i : Fin 2 → ℝ) := by
    intro i; fin_cases i
    · exact ha
    · exact hb
  constructor
  · have h := proposition_4_C_1 (xs := ![leontiefRayDemand ![3, 1], leontiefRayDemand ![1, 3]])
      (α := ![1 / 2, 1 / 2]) (fun i => by fin_cases i <;> norm_num)
      (by simp [Fin.sum_univ_two]; norm_num)
      (fun i => by fin_cases i <;> exact leontiefRayDemand_homogeneousZero _)
      (fun i => by fin_cases i
                   · exact leontiefRayDemand_walrasLaw ha
                   · exact leontiefRayDemand_walrasLaw hb)
      (fun i => by fin_cases i
                   · exact leontiefRayDemand_uld ha
                   · exact leontiefRayDemand_uld hb)
    exact h.2
  · intro hinv
    have hp : StrictlyPositive (![1, 1] : Fin 2 → ℝ) := by intro l; fin_cases l <;> simp
    have := hinv ![1, 1] hp ![1, 1] ![3 / 2, 1 / 2] (fun i => by fin_cases i <;> norm_num)
      (fun i => by fin_cases i <;> norm_num) (by simp [Fin.sum_univ_two]; norm_num)
    have h0 := congrFun this 0
    simp [aggDemand, leontiefRayDemand, Fin.sum_univ_two] at h0
    norm_num at h0

/-- **Section 4.C** (MWG, p. 115). With identical preferences and equal wealths `w/I`, if the
common utility `u` has single-valued demand `x̃(p, w)`, then aggregate demand
`x(p, w) = ∑ᵢ x̃(p, w/I) = I x̃(p, w/I)` is generated by the utility `ũ(y) = u(y/I)`: a positive
representative consumer. Hence aggregate demand satisfies the strong axiom. -/
theorem identical_consumers_strongAxiom (hI : 0 < I) {u : (Fin L → ℝ) → ℝ}
    {x : DemandFunction L} (hx : ∀ p w, PWDomain p w → walrasianDemand u p w = {x p w}) :
    IsPositiveRepresentative (utilityPref fun y => u ((I : ℝ)⁻¹ • y))
        (shareDemand (fun _ : Fin I => x) fun _ => 1 / (I : ℝ)) ∧
      StrongAxiom (shareDemand (fun _ : Fin I => x) fun _ => 1 / (I : ℝ)) := by
  have hIr : (0 : ℝ) < I := by exact_mod_cast hI
  have hX : ∀ p w, shareDemand (fun _ : Fin I => x) (fun _ => 1 / (I : ℝ)) p w =
      (I : ℝ) • x p (w / I) := by
    intro p w
    simp only [shareDemand, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      Nat.cast_smul_eq_nsmul]
    congr 2
    ring
  have hpr : IsPositiveRepresentative (utilityPref fun y => u ((I : ℝ)⁻¹ • y))
      (shareDemand (fun _ : Fin I => x) fun _ => 1 / (I : ℝ)) := by
    refine ⟨(representsOn_utilityPref _ _).rationalOn, fun p w hd => ?_⟩
    have hdI : PWDomain p (w / I) := ⟨hd.1, div_pos hd.2 hIr⟩
    have hmem : x p (w / I) ∈ walrasianDemand u p (w / I) := by rw [hx p _ hdI]; rfl
    rw [hX]
    refine ⟨⟨fun l => by simpa using mul_nonneg hIr.le (hmem.1.1 l), ?_⟩, fun y hy hne => ?_⟩
    · rw [dotProduct_smul, smul_eq_mul]
      have := hmem.1.2
      rw [le_div_iff₀ hIr] at this
      linarith
    · have hyI : (I : ℝ)⁻¹ • y ∈ budgetSet p (w / I) := by
        refine ⟨fun l => by simpa using mul_nonneg (inv_pos.mpr hIr).le (hy.1 l), ?_⟩
        rw [dotProduct_smul, smul_eq_mul, div_eq_inv_mul]
        exact mul_le_mul_of_nonneg_left hy.2 (inv_pos.mpr hIr).le
      have hback : (I : ℝ)⁻¹ • ((I : ℝ) • x p (w / I)) = x p (w / I) := by
        rw [smul_smul, inv_mul_cancel₀ hIr.ne', one_smul]
      have hle := hmem.2 _ hyI
      rw [Strict, utilityPref, utilityPref, hback]
      refine ⟨hle, fun hge => hne ?_⟩
      have hin : (I : ℝ)⁻¹ • y ∈ walrasianDemand u p (w / I) :=
        ⟨hyI, fun z hz => (hmem.2 z hz).trans hge⟩
      rw [hx p _ hdI] at hin
      have : y = (I : ℝ) • ((I : ℝ)⁻¹ • y) := by
        rw [smul_smul, mul_inv_cancel₀ hIr.ne', one_smul]
      rw [this, Set.mem_singleton_iff.mp hin]
  exact ⟨hpr, strongAxiom_of_positiveRepresentative hpr (rational_utilityPref _)⟩

end MWG.AggregateDemand
