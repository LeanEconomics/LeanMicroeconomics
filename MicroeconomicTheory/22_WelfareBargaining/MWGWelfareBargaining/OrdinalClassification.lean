import MWGWelfareBargaining.OrdinalInvariance
import Mathlib.Topology.Order.IntermediateValue
import Mathlib.Topology.Algebra.Order.Field
import Mathlib.Order.Filter.AtTopBot.Basic

/-!
# Ordinal invariance with two agents; Example 22.D.1; separability

MWG, Exercise 22.D.8(d), second part (p. 853), Example 22.D.1 and the small-type discussion of
independence of irrelevant individuals (p. 838).

* `exercise_22_D_8d_classification`: for `I = 2`, a continuous increasing social welfare
  function whose functional is invariant to common ordinal transformations represents the
  ordering of `u₁`, of `u₂`, of `min` or of `max` (dictatorial, Rawlsian or anti-Rawlsian).
  On `{u₁ < u₂}` the comparison of `(a, b)` with `(a, c)` (and of `(a, c)` with `(b, c)`) has the
  same outcome for all `a < b < c` (a piecewise linear `γ` maps any such triple to any other);
  continuity, the intermediate value theorem and part (d)'s no-crossing result rule out
  dependence on both coordinates, monotonicity rules out dependence on neither; the region
  `{u₂ < u₁}` is the same after swapping the agents, and continuity glues the regions along
  the diagonal.
* `example_22_D_1`: the functional `V(x) = ∑ gᵢ(ũᵢ(x) - ũᵢ(x*))` is a social welfare functional
  invariant to independent changes of origins; with `gᵢ(t) = t³` it is not pairwise independent,
  hence not generated by any social welfare function (in particular neither utilitarian nor
  dictatorial).
* `additive_independent_irrelevant`: additively separable social welfare functions are
  independent of irrelevant individuals (the easy half of Debreu's theorem quoted on p. 838).
  Debreu's converse, that a continuous increasing `W` with `I > 2` independent of irrelevant
  individuals is additively separable up to an increasing transformation, is in
  `DebreuSeparability` (with corrected and added hypotheses).
-/

namespace MWG.WelfareBargaining

variable {X : Type*}

/-- Invariance of the ordering of a social welfare function on `ℝ²` to common strictly
increasing transformations. -/
def OrdInvVec (W : (Fin 2 → ℝ) → ℝ) : Prop :=
  ∀ γ : ℝ → ℝ, StrictMono γ → ∀ u u' : Fin 2 → ℝ,
    (W (fun i => γ (u' i)) ≤ W (fun i => γ (u i)) ↔ W u' ≤ W u)

/-- A functional invariant to common ordinal transformations (with two alternatives) gives a
social welfare function with an invariant ordering. -/
theorem ordInvVec_of {W : (Fin 2 → ℝ) → ℝ} (hX : ∃ x y : X, x ≠ y)
    (h : InvCommonOrdinal (swfFunctional (X := X) W)) : OrdInvVec W := by
  obtain ⟨x, y, hxy⟩ := hX
  exact fun γ hγ u u' => transfer_invariance (swfFunctional_generatedBy W) hxy
    (fun v i => γ (v i)) (fun ũ => h γ hγ ũ) u u'

/-- Part (d)'s no-crossing result for a social welfare function with an invariant ordering. -/
theorem ordInvVec_noCross {W : (Fin 2 → ℝ) → ℝ} (hW : IsIncreasingSWF W) (hI : OrdInvVec W)
    {u u' : Fin 2 → ℝ} (heq : W u = W u') (h1 : u' 0 < u 0) (h2 : u 0 < u 1)
    (h3 : u 1 < u' 1) : False :=
  exercise_22_D_8d (X := Bool) ⟨true, false, by decide⟩ hW heq h1 h2 h3 fun γ hγ ũ =>
    invariance_of_relation (swfFunctional_generatedBy W) (fun v i => γ (v i))
      (fun u u' => hI γ hγ u u') ũ

/-- A strictly increasing piecewise linear map sending `a < b < c` to `a' < b' < c'`. -/
theorem exists_strictMono_three {a b c a' b' c' : ℝ} (h1 : a < b) (h2 : b < c) (h1' : a' < b')
    (h2' : b' < c') : ∃ γ : ℝ → ℝ, StrictMono γ ∧ γ a = a' ∧ γ b = b' ∧ γ c = c' := by
  set k₁ := (b' - a') / (b - a) with hk₁
  set k₂ := (c' - b') / (c - b) with hk₂
  have hk₁0 : 0 < k₁ := div_pos (by linarith) (by linarith)
  have hk₂0 : 0 < k₂ := div_pos (by linarith) (by linarith)
  have hba : b - a ≠ 0 := (sub_pos.2 h1).ne'
  have hcb : c - b ≠ 0 := (sub_pos.2 h2).ne'
  have e₁ : (b - a) * k₁ = b' - a' := by rw [hk₁]; field_simp
  have e₂ : (c - b) * k₂ = c' - b' := by rw [hk₂]; field_simp
  refine ⟨fun t => if t ≤ b then a' + (t - a) * k₁ else b' + (t - b) * k₂, ?_, ?_, ?_, ?_⟩
  · intro s t hst
    simp only
    split_ifs with hs ht ht
    · nlinarith
    · nlinarith
    · linarith
    · nlinarith
  · simp [h1.le]
  · simp only [le_refl, ↓reduceIte]; linarith
  · simp only [not_le.2 h2, ↓reduceIte]; linarith

theorem comp_vec2 (γ : ℝ → ℝ) (a b : ℝ) : (fun i => γ ((![a, b] : Fin 2 → ℝ) i)) = ![γ a, γ b] := by
  funext i; fin_cases i <;> rfl

/-- The comparison `W(a, b) = W(a, c)` has the same truth value for all `a < b < c`. -/
theorem ordInv_transfer₁ {W : (Fin 2 → ℝ) → ℝ} (hI : OrdInvVec W) {a b c a' b' c' : ℝ}
    (h1 : a < b) (h2 : b < c) (h1' : a' < b') (h2' : b' < c') (h : W ![a, b] = W ![a, c]) :
    W ![a', b'] = W ![a', c'] := by
  obtain ⟨γ, hγ, ha, hb, hc⟩ := exists_strictMono_three h1 h2 h1' h2'
  have t1 := hI γ hγ ![a, b] ![a, c]
  have t2 := hI γ hγ ![a, c] ![a, b]
  rw [comp_vec2, comp_vec2, ha, hb, hc] at t1 t2
  exact le_antisymm (t2.2 h.le) (t1.2 h.ge)

/-- The comparison `W(a, c) = W(b, c)` has the same truth value for all `a < b < c`. -/
theorem ordInv_transfer₂ {W : (Fin 2 → ℝ) → ℝ} (hI : OrdInvVec W) {a b c a' b' c' : ℝ}
    (h1 : a < b) (h2 : b < c) (h1' : a' < b') (h2' : b' < c') (h : W ![a, c] = W ![b, c]) :
    W ![a', c'] = W ![b', c'] := by
  obtain ⟨γ, hγ, ha, hb, hc⟩ := exists_strictMono_three h1 h2 h1' h2'
  have t1 := hI γ hγ ![a, c] ![b, c]
  have t2 := hI γ hγ ![b, c] ![a, c]
  rw [comp_vec2, comp_vec2, ha, hb, hc] at t1 t2
  exact le_antisymm (t2.2 h.le) (t1.2 h.ge)

theorem vec2_le {a b a' b' : ℝ} (h0 : a ≤ a') (h1 : b ≤ b') :
    ∀ i, (![a, b] : Fin 2 → ℝ) i ≤ (![a', b'] : Fin 2 → ℝ) i := by
  intro i; fin_cases i
  · exact h0
  · exact h1

theorem vec2_lt {a b a' b' : ℝ} (h0 : a < a') (h1 : b < b') :
    ∀ i, (![a, b] : Fin 2 → ℝ) i < (![a', b'] : Fin 2 → ℝ) i := by
  intro i; fin_cases i
  · exact h0
  · exact h1

theorem continuous_vec2_snd (a : ℝ) : Continuous fun t : ℝ => (![a, t] : Fin 2 → ℝ) :=
  continuous_pi fun i => by
    fin_cases i
    · exact continuous_const
    · exact continuous_id

theorem continuous_vec2_fst (b : ℝ) : Continuous fun t : ℝ => (![t, b] : Fin 2 → ℝ) :=
  continuous_pi fun i => by
    fin_cases i
    · exact continuous_id
    · exact continuous_const

open Filter Topology in
/-- The analysis of the region `{u₁ ≤ u₂}`: `W(a, b)` depends only on `a` there, or only on
`b`. -/
theorem ordInv_upper {W : (Fin 2 → ℝ) → ℝ} (hc : Continuous W) (hW : IsIncreasingSWF W)
    (hI : OrdInvVec W) :
    (∀ a b, a ≤ b → W ![a, b] = W ![a, a]) ∨ (∀ a b, a ≤ b → W ![a, b] = W ![b, b]) := by
  -- the two dichotomies
  have mono₂ : ∀ a b c, b ≤ c → W ![a, b] ≤ W ![a, c] := fun a b c h =>
    hW.1 _ _ (vec2_le le_rfl h)
  have mono₁ : ∀ a b c, a ≤ b → W ![a, c] ≤ W ![b, c] := fun a b c h =>
    hW.1 _ _ (vec2_le h le_rfl)
  -- E1 ∨ S1 and E2 ∨ S2
  have d₁ : (∀ a b c, a < b → b < c → W ![a, b] = W ![a, c]) ∨
      (∀ a b c, a < b → b < c → W ![a, b] < W ![a, c]) := by
    by_cases h : W ![0, 1] = W ![0, 2]
    · exact Or.inl fun a b c h1 h2 => ordInv_transfer₁ hI (by norm_num) (by norm_num) h1 h2 h
    · refine Or.inr fun a b c h1 h2 => lt_of_le_of_ne (mono₂ a b c h2.le) fun h' => h ?_
      exact ordInv_transfer₁ hI h1 h2 (by norm_num) (by norm_num) h'
  have d₂ : (∀ a b c, a < b → b < c → W ![a, c] = W ![b, c]) ∨
      (∀ a b c, a < b → b < c → W ![a, c] < W ![b, c]) := by
    by_cases h : W ![0, 2] = W ![1, 2]
    · exact Or.inl fun a b c h1 h2 => ordInv_transfer₂ hI (by norm_num) (by norm_num) h1 h2 h
    · refine Or.inr fun a b c h1 h2 => lt_of_le_of_ne (mono₁ a b c h1.le) fun h' => h ?_
      exact ordInv_transfer₂ hI h1 h2 (by norm_num) (by norm_num) h'
  rcases d₁ with E₁ | S₁
  · -- `W(a, b)` does not depend on `b > a`; continuity at the diagonal
    left
    intro a b hab
    rcases hab.lt_or_eq with hab | hab
    · have hlim : Tendsto (fun t => W ![a, t]) (𝓝[>] a) (𝓝 (W ![a, a])) :=
        ((hc.comp (continuous_vec2_snd a)).tendsto a).mono_left nhdsWithin_le_nhds
      have hev : ∀ᶠ t in 𝓝[>] a, W ![a, t] = W ![a, b] := by
        filter_upwards [Ioo_mem_nhdsGT hab] with t ht using E₁ a t b ht.1 ht.2
      exact (tendsto_nhds_unique (hlim.congr' hev) tendsto_const_nhds).symm
    · rw [hab]
  rcases d₂ with E₂ | S₂
  · right
    intro a b hab
    rcases hab.lt_or_eq with hab | hab
    · have hlim : Tendsto (fun t => W ![t, b]) (𝓝[<] b) (𝓝 (W ![b, b])) :=
        ((hc.comp (continuous_vec2_fst b)).tendsto b).mono_left nhdsWithin_le_nhds
      have hev : ∀ᶠ t in 𝓝[<] b, W ![t, b] = W ![a, b] := by
        filter_upwards [Ioo_mem_nhdsLT hab] with t ht using (E₂ a t b ht.1 ht.2).symm
      exact (tendsto_nhds_unique (hlim.congr' hev) tendsto_const_nhds).symm
    · rw [hab]
  -- both strict: impossible
  exfalso
  -- for `a < b < c < t`: `W(a, t) < W(b, c)`, by the intermediate value theorem and no-crossing
  have key : ∀ a b c t, a < b → b < c → c < t → W ![a, t] < W ![b, c] := by
    intro a b c t h1 h2 h3
    by_contra hge
    have hge : W ![b, c] ≤ W ![a, t] := not_lt.1 hge
    have hlow : W ![a, c] < W ![b, c] := S₂ a b c h1 h2
    obtain ⟨s, hs, hseq⟩ := intermediate_value_Icc h3.le
      ((hc.comp (continuous_vec2_snd a)).continuousOn) ⟨hlow.le, hge⟩
    have hsc : c < s := lt_of_le_of_ne hs.1 fun h => by
      simp only [Function.comp] at hseq; rw [← h] at hseq; linarith
    simp only [Function.comp] at hseq
    exact ordInvVec_noCross hW hI hseq.symm (by simpa using h1) (by simpa using h2)
      (by simpa using hsc)
  -- let `a ↑ b`: `W(b, t) ≤ W(b, c)`, contradicting `S₁`
  have hlt' : W ![1, 2] < W ![1, 3] := S₁ 1 2 3 (by norm_num) (by norm_num)
  have hlim : Tendsto (fun a => W ![a, 3]) (𝓝[<] 1) (𝓝 (W ![1, 3])) :=
    ((hc.comp (continuous_vec2_fst 3)).tendsto 1).mono_left nhdsWithin_le_nhds
  have hev : ∀ᶠ a in 𝓝[<] (1 : ℝ), W ![a, 3] < W ![1, 2] := by
    filter_upwards [self_mem_nhdsWithin] with a ha using key a 1 2 3 ha (by norm_num)
      (by norm_num)
  have := le_of_tendsto hlim (hev.mono fun a ha => ha.le)
  linarith

/-- The diagonal is strictly increasing. -/
theorem diag2_strictMono {W : (Fin 2 → ℝ) → ℝ} (hW : IsIncreasingSWF W) :
    StrictMono fun t : ℝ => W ![t, t] :=
  fun _ _ hst => hW.2 _ _ (vec2_lt hst hst)

theorem swap_vec2 (a b : ℝ) : (fun i => (![a, b] : Fin 2 → ℝ) (Equiv.swap 0 1 i)) = ![b, a] := by
  funext i; fin_cases i <;> rfl

theorem vec2_eta (u : Fin 2 → ℝ) : u = ![u 0, u 1] := by
  funext i; fin_cases i <;> rfl

/-- **Exercise 22.D.8(d)** (MWG, p. 853), the classification. For `I = 2`, a continuous,
increasing social welfare function whose functional is invariant to common ordinal
transformations represents the ordering of `u₁` or of `u₂` (dictatorial), of `min`
(Rawlsian) or of `max` (anti-Rawlsian): `W = h ∘ f` with `h` strictly increasing. -/
theorem exercise_22_D_8d_classification (hX : ∃ x y : X, x ≠ y) {W : (Fin 2 → ℝ) → ℝ}
    (hc : Continuous W) (hW : IsIncreasingSWF W)
    (hinv : InvCommonOrdinal (swfFunctional (X := X) W)) :
    ∃ f : (Fin 2 → ℝ) → ℝ, (f = (fun u => u 0) ∨ f = (fun u => u 1) ∨
        f = (fun u => min (u 0) (u 1)) ∨ f = (fun u => max (u 0) (u 1))) ∧
      ∀ u u' : Fin 2 → ℝ, (W u ≤ W u' ↔ f u ≤ f u') := by
  have hI := ordInvVec_of hX hinv
  set h : ℝ → ℝ := fun t => W ![t, t] with hh
  have hhm : StrictMono h := diag2_strictMono hW
  -- the swapped social welfare function
  set W' : (Fin 2 → ℝ) → ℝ := fun u => W (fun i => u (Equiv.swap 0 1 i)) with hW'
  have hc' : Continuous W' := hc.comp (continuous_pi fun i => continuous_apply _)
  have hW'inc : IsIncreasingSWF W' :=
    ⟨fun u u' hle => hW.1 _ _ fun i => hle _, fun u u' hlt => hW.2 _ _ fun i => hlt _⟩
  have hI' : OrdInvVec W' := fun γ hγ u u' =>
    hI γ hγ (fun i => u (Equiv.swap 0 1 i)) (fun i => u' (Equiv.swap 0 1 i))
  have hW'v : ∀ a b, W' ![a, b] = W ![b, a] := fun a b => by simp only [hW', swap_vec2]
  -- the formula on `{u₀ ≤ u₁}` and on `{u₁ ≤ u₀}`
  have up : (∀ u : Fin 2 → ℝ, u 0 ≤ u 1 → W u = h (u 0)) ∨
      (∀ u : Fin 2 → ℝ, u 0 ≤ u 1 → W u = h (u 1)) := by
    rcases ordInv_upper hc hW hI with H | H
    · exact Or.inl fun u hu => by rw [vec2_eta u]; exact H _ _ hu
    · exact Or.inr fun u hu => by rw [vec2_eta u]; exact H _ _ hu
  have lo : (∀ u : Fin 2 → ℝ, u 1 ≤ u 0 → W u = h (u 1)) ∨
      (∀ u : Fin 2 → ℝ, u 1 ≤ u 0 → W u = h (u 0)) := by
    rcases ordInv_upper hc' hW'inc hI' with H | H
    · refine Or.inl fun u hu => ?_
      have := H (u 1) (u 0) hu
      rw [hW'v, hW'v, ← vec2_eta] at this
      exact this
    · refine Or.inr fun u hu => ?_
      have := H (u 1) (u 0) hu
      rw [hW'v, hW'v, ← vec2_eta] at this
      exact this
  -- `W = h ∘ f`
  have rep : ∀ f : (Fin 2 → ℝ) → ℝ, (∀ u, W u = h (f u)) →
      ∀ u u' : Fin 2 → ℝ, (W u ≤ W u' ↔ f u ≤ f u') := fun f hf u u' => by
    rw [hf, hf]; exact hhm.le_iff_le
  rcases up with U | U <;> rcases lo with L | L
  · refine ⟨_, Or.inr (Or.inr (Or.inl rfl)), rep _ fun u => ?_⟩
    rcases le_total (u 0) (u 1) with hu | hu
    · rw [U u hu, min_eq_left hu]
    · rw [L u hu, min_eq_right hu]
  · refine ⟨_, Or.inl rfl, rep _ fun u => ?_⟩
    rcases le_total (u 0) (u 1) with hu | hu
    · exact U u hu
    · exact L u hu
  · refine ⟨_, Or.inr (Or.inl rfl), rep _ fun u => ?_⟩
    rcases le_total (u 0) (u 1) with hu | hu
    · exact U u hu
    · exact L u hu
  · refine ⟨_, Or.inr (Or.inr (Or.inr rfl)), rep _ fun u => ?_⟩
    rcases le_total (u 0) (u 1) with hu | hu
    · rw [U u hu, max_eq_right hu]
    · rw [L u hu, max_eq_left hu]

/-- **Exercise 22.D.8(d)**, instance (MWG, p. 853): `W = min` satisfies the hypotheses. -/
theorem exercise_22_D_8d_classification_instance :
    Continuous (fun u : Fin 2 → ℝ => min (u 0) (u 1)) ∧
      IsIncreasingSWF (fun u : Fin 2 → ℝ => min (u 0) (u 1)) ∧
      InvCommonOrdinal (swfFunctional (X := Bool) fun u : Fin 2 → ℝ => min (u 0) (u 1)) := by
  refine ⟨(continuous_apply 0).min (continuous_apply 1), ⟨fun u u' h => min_le_min (h 0) (h 1),
    fun u u' h => lt_min (min_lt_of_left_lt (h 0)) (min_lt_of_right_lt (h 1))⟩, ?_⟩
  intro γ hγ ũ
  refine invariance_of_relation (swfFunctional_generatedBy _) (fun v i => γ (v i))
    (fun u u' => ?_) ũ
  change min (γ (u' 0)) (γ (u' 1)) ≤ min (γ (u 0)) (γ (u 1)) ↔ _
  rw [← hγ.monotone.map_min, ← hγ.monotone.map_min]
  exact hγ.le_iff_le

/-! ### Example 22.D.1 -/

/-- **Example 22.D.1** (MWG, p. 838). Fix `x*`; `F(ũ)` is the preference generated by
`V(x) = ∑ᵢ gᵢ(ũᵢ(x) - ũᵢ(x*))`. -/
def example22D1F {ι : Type*} [Fintype ι] (g : ι → ℝ → ℝ) (xstar : X) :
    UProfile ι X → X → X → Prop :=
  fun ũ x y => ∑ i, g i (ũ i y - ũ i xstar) ≤ ∑ i, g i (ũ i x - ũ i xstar)

/-- **Example 22.D.1** (MWG, p. 838). `F` is a social welfare functional (each `F(ũ)` is
rational) and is invariant to independent changes of origins. -/
theorem example_22_D_1 {ι : Type*} [Fintype ι] (g : ι → ℝ → ℝ) (xstar : X) :
    IsUSWF (example22D1F g xstar) ∧ InvIndepOrigins (example22D1F g xstar) := by
  refine ⟨fun ũ => ⟨fun x y => le_total _ _, fun x y z h1 h2 => h2.trans h1⟩,
    fun α ũ => ?_⟩
  funext x y
  simp only [example22D1F, add_sub_add_right_eq_sub]

/-- **Example 22.D.1** (MWG, p. 838). With two agents, `gᵢ(t) = t³`, `X = {x*, x, y}`, the
ranking of `x` and `y` depends on the utilities of `x*`: with `ũ(x) = (0, 2)`, `ũ(y) = (1, 0)`,
`x ≻ y` when `ũ(x*) = (0, 0)` and `y ≻ x` when `ũ(x*) = (-10, 0)`. So `F` is not pairwise
independent, and hence not generated by any social welfare function (neither utilitarian nor
dictatorial). -/
theorem example_22_D_1_not_pairwise :
    ¬UPairwiseIndependent (example22D1F (ι := Fin 2) (fun _ t => t ^ 3) (0 : Fin 3)) ∧
      ¬∃ W : (Fin 2 → ℝ) → ℝ,
        GeneratedBy (example22D1F (ι := Fin 2) (fun _ t => t ^ 3) (0 : Fin 3))
          (fun u u' => W u' ≤ W u) := by
  have hnot : ¬UPairwiseIndependent (example22D1F (ι := Fin 2) (fun _ t => t ^ 3) (0 : Fin 3)) := by
    intro h
    set ũ : UProfile (Fin 2) (Fin 3) := fun i z => ![![0, 0, 1], ![0, 2, 0]] i z
    set ũ' : UProfile (Fin 2) (Fin 3) := fun i z => ![![-10, 0, 1], ![0, 2, 0]] i z
    have := h ũ ũ' 1 2 (fun i => by fin_cases i <;> rfl) (fun i => by fin_cases i <;> rfl)
    simp only [example22D1F, ũ, ũ', Fin.sum_univ_two] at this
    norm_num at this
  exact ⟨hnot, fun ⟨W, hW⟩ => hnot (generatedBy_pairwiseIndependent hW)⟩

/-! ### Independence of irrelevant individuals (p. 838) -/

/-- **Section 22.D, small type** (MWG, p. 838). `W` is independent of irrelevant individuals: for
every group `S`, the ranking of two vectors that agree outside `S` depends only on their entries
in `S`, not on the common entries outside `S`. -/
def IndepIrrelevantIndividuals {ι : Type*} (W : (ι → ℝ) → ℝ) : Prop :=
  ∀ (S : Set ι) (a b c d : ι → ℝ), (∀ i ∈ S, a i = c i ∧ b i = d i) →
    (∀ i ∉ S, a i = b i ∧ c i = d i) → (W b ≤ W a ↔ W d ≤ W c)

/-- **Section 22.D, small type** (MWG, p. 838). An additively separable (generalized
utilitarian) `W(u) = ∑ gᵢ(uᵢ)` is independent of irrelevant individuals: the difference
`W(a) - W(b)` only involves the agents where `a` and `b` differ. -/
theorem additive_independent_irrelevant {ι : Type*} [Fintype ι] (g : ι → ℝ → ℝ) :
    IndepIrrelevantIndividuals (fun u : ι → ℝ => ∑ i, g i (u i)) := by
  intro S a b c d hS hSc
  classical
  have key : ∑ i, g i (a i) - ∑ i, g i (b i) = ∑ i, g i (c i) - ∑ i, g i (d i) := by
    rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    by_cases hi : i ∈ S
    · rw [(hS i hi).1, (hS i hi).2]
    · rw [(hSc i hi).1, (hSc i hi).2, sub_self, sub_self]
  constructor <;> intro h <;> linarith

end MWG.WelfareBargaining
