import MWGWelfareBargaining.Invariance
import MWGClassicalDemand.UtilityRepresentation
import ChoicePreferenceUtility.Rationalization

/-!
# Exercises 22.D.1, 22.D.4 and 22.D.5, and non-vacuity of Section 22.D

MWG, pp. 832-837 and 852-853.

* Exercise 22.D.1(a)-(c): each of the three hypotheses of Proposition 22.D.1 (at least three
  alternatives, Pareto, pairwise independence) is indispensable.
* Exercise 22.D.4(a)-(b): lexically dictatorial functionals are Paretian, pairwise independent
  and allow no interpersonal comparisons; one with a list of `n ≥ 2` distinct agents is not
  generated by any social welfare function (via Example 3.C.1 of MWG Chapter 3), while `n = 1`
  is generated by `W(u) = uₕ`.
* Exercise 22.D.5: from a Chapter 21 social welfare functional `F` (on `𝓡^I`) we build
  `F'(ũ) = F(≿(ũ))`. `F'` is a social welfare functional, satisfies the strict half of
  Definition 22.D.2 and pairwise independence, allows no interpersonal comparisons, and a
  dictator of `F'` is a dictator of `F`. **Correction**: the weak half of Definition 22.D.2 is
  *not* inherited from the (strict) Pareto property of Definition 21.C.2
  (`exercise_22_D_5_weak_not_inherited`); with the extra unanimity condition the route of
  p. 837 proves Arrow's theorem (`exercise_22_D_5`).
* Non-vacuity of Propositions 22.D.1-22.D.3.
-/

namespace MWG.WelfareBargaining

open Kreps.ChoicePreferenceUtility MWG.SocialChoice

/-! ### Exercise 22.D.1 -/

/-- **Exercise 22.D.1(a)** (MWG, p. 852). Two alternatives `x = true`, `y = false` and three
agents: `x F y` iff every agent weakly prefers `x`, and `y F x` iff some agent weakly prefers
`y`. -/
def e22D1aF : UProfile (Fin 3) Bool → Bool → Bool → Prop := fun ũ a b =>
  if a = b then True else if a = true then ∀ i, ũ i false ≤ ũ i true
  else ∃ i, ũ i true ≤ ũ i false

theorem e22D1aF_tf (ũ : UProfile (Fin 3) Bool) :
    e22D1aF ũ true false ↔ ∀ i, ũ i false ≤ ũ i true := by simp [e22D1aF]

theorem e22D1aF_ft (ũ : UProfile (Fin 3) Bool) :
    e22D1aF ũ false true ↔ ∃ i, ũ i true ≤ ũ i false := by simp [e22D1aF]

theorem e22D1aF_refl (ũ : UProfile (Fin 3) Bool) (a : Bool) : e22D1aF ũ a a := by
  simp [e22D1aF]

/-- **Exercise 22.D.1(a)** (MWG, p. 852). The functional is a Paretian, pairwise independent
social welfare functional (the social preference is always complete), it has only two
alternatives, and no relation on `ℝ^I` generates it. -/
theorem exercise_22_D_1a :
    IsUSWF e22D1aF ∧ UParetian e22D1aF ∧ UPairwiseIndependent e22D1aF ∧
      Fintype.card Bool = 2 ∧ ¬∃ R, GeneratedBy e22D1aF R := by
  have hc : ∀ ũ : UProfile (Fin 3) Bool, e22D1aF ũ true false ∨ e22D1aF ũ false true := by
    intro ũ
    rw [e22D1aF_tf, e22D1aF_ft]
    by_cases h : ∀ i, ũ i false ≤ ũ i true
    · exact Or.inl h
    · push Not at h
      obtain ⟨i, hi⟩ := h
      exact Or.inr ⟨i, hi.le⟩
  refine ⟨fun ũ => ⟨fun a b => ?_, fun a b c h1 h2 => ?_⟩, fun ũ a b => ⟨fun h => ?_, fun h => ?_⟩,
    fun ũ ũ' a b ha hb => ?_, rfl, ?_⟩
  · rcases a with _ | _ <;> rcases b with _ | _
    · exact Or.inl (e22D1aF_refl ũ _)
    · exact (hc ũ).symm
    · exact hc ũ
    · exact Or.inl (e22D1aF_refl ũ _)
  · rcases a with _ | _ <;> rcases c with _ | _
    · exact e22D1aF_refl ũ _
    · rcases b with _ | _
      · exact h2
      · exact h1
    · rcases b with _ | _
      · exact h1
      · exact h2
    · exact e22D1aF_refl ũ _
  · rcases a with _ | _ <;> rcases b with _ | _
    · exact e22D1aF_refl ũ _
    · exact (e22D1aF_ft ũ).2 ⟨0, h 0⟩
    · exact (e22D1aF_tf ũ).2 h
    · exact e22D1aF_refl ũ _
  · rcases a with _ | _ <;> rcases b with _ | _
    · exact absurd (h 0) (lt_irrefl _)
    · refine ⟨(e22D1aF_ft ũ).2 ⟨0, (h 0).le⟩, fun h' => ?_⟩
      rw [e22D1aF_tf] at h'
      exact absurd (h' 0) (not_le.2 (h 0))
    · refine ⟨(e22D1aF_tf ũ).2 fun i => (h i).le, fun h' => ?_⟩
      rw [e22D1aF_ft] at h'
      obtain ⟨i, hi⟩ := h'
      exact absurd hi (not_le.2 (h i))
    · exact absurd (h 0) (lt_irrefl _)
  · rcases a with _ | _ <;> rcases b with _ | _
    · exact iff_of_true (e22D1aF_refl ũ _) (e22D1aF_refl ũ' _)
    · rw [e22D1aF_ft, e22D1aF_ft]
      simp only [hb, ha]
    · rw [e22D1aF_tf, e22D1aF_tf]
      simp only [hb, ha]
    · exact iff_of_true (e22D1aF_refl ũ _) (e22D1aF_refl ũ' _)
  · rintro ⟨R, hR⟩
    -- `x` with values `(1,0,0)` against `y` with values `(0,1,0)`, and the mirror profile
    let p : Fin 3 → ℝ := ![1, 0, 0]
    let q : Fin 3 → ℝ := ![0, 1, 0]
    let ũ : UProfile (Fin 3) Bool := fun i z => if z then p i else q i
    let ũ' : UProfile (Fin 3) Bool := fun i z => if z then q i else p i
    have h1 := hR ũ true false
    have h2 := hR ũ' false true
    have e1 : uvec ũ true = p := rfl
    have e2 : uvec ũ false = q := rfl
    have e3 : uvec ũ' false = p := rfl
    have e4 : uvec ũ' true = q := rfl
    rw [e1, e2] at h1
    rw [e3, e4] at h2
    have hn : ¬e22D1aF ũ true false := by
      rw [e22D1aF_tf]
      intro h
      have := h 1
      norm_num [ũ, p, q] at this
    have hy : e22D1aF ũ' false true := by
      rw [e22D1aF_ft]
      exact ⟨0, by simp [ũ', p, q]⟩
    exact hn (h1.2 (h2.1 hy))

/-- **Exercise 22.D.1(b)** (MWG, p. 852). Three alternatives and the constant functional
`x ≻ y ≻ z` (here `0 ≻ 1 ≻ 2`). -/
def e22D1bF : UProfile (Fin 3) (Fin 3) → Fin 3 → Fin 3 → Prop := fun _ a b => a ≤ b

/-- **Exercise 22.D.1(b)** (MWG, p. 852). The constant functional is a pairwise independent
social welfare functional with three alternatives, it is not Paretian, and it is not generated
by any relation on `ℝ^I`. -/
theorem exercise_22_D_1b :
    IsUSWF e22D1bF ∧ UPairwiseIndependent e22D1bF ∧ ¬UParetian e22D1bF ∧
      ¬∃ R, GeneratedBy e22D1bF R := by
  refine ⟨fun _ => ⟨fun a b => le_total a b, fun a b c h1 h2 => le_trans h1 h2⟩,
    fun _ _ _ _ _ _ => Iff.rfl, fun hP => ?_, fun ⟨R, hR⟩ => ?_⟩
  · have := ((hP (fun _ z => (z : ℝ)) 2 0).2 fun _ => by norm_num).1
    exact absurd this (by unfold e22D1bF; decide)
  · have h1 := hR 0 0 1
    have h2 := hR 0 1 0
    have e : ∀ z : Fin 3, uvec (0 : UProfile (Fin 3) (Fin 3)) z = 0 := fun _ => rfl
    rw [e, e] at h1 h2
    exact absurd (h2.2 (h1.1 (by unfold e22D1bF; decide))) (by unfold e22D1bF; decide)

/-- The weight of agent `1` in Exercise 22.D.1(c): it depends on the utility of the third
alternative `2`. -/
noncomputable def e22D1cWeight (ũ : UProfile (Fin 2) (Fin 3)) : ℝ :=
  if 0 < ũ 0 2 then 2 else 1

/-- **Exercise 22.D.1(c)** (MWG, p. 852). `x F(ũ) y` iff `ũ₀(x) + t(ũ) ũ₁(x) ≥ ũ₀(y) + t(ũ) ũ₁(y)`,
where the weight `t(ũ) ∈ {1, 2}` depends on agent `0`'s utility of the third alternative. -/
noncomputable def e22D1cF : UProfile (Fin 2) (Fin 3) → Fin 3 → Fin 3 → Prop := fun ũ a b =>
  ũ 0 b + e22D1cWeight ũ * ũ 1 b ≤ ũ 0 a + e22D1cWeight ũ * ũ 1 a

/-- **Exercise 22.D.1(c)** (MWG, p. 852). A Paretian social welfare functional on three
alternatives for which only pairwise independence fails; it is not generated by any relation
on `ℝ^I`. -/
theorem exercise_22_D_1c :
    IsUSWF e22D1cF ∧ UParetian e22D1cF ∧ Fintype.card (Fin 3) = 3 ∧
      ¬UPairwiseIndependent e22D1cF ∧ ¬∃ R, GeneratedBy e22D1cF R := by
  have ht : ∀ ũ, 0 < e22D1cWeight ũ := fun ũ => by
    unfold e22D1cWeight; split_ifs <;> norm_num
  have hnotPI : ¬UPairwiseIndependent e22D1cF := by
    intro hI
    let ũ : UProfile (Fin 2) (Fin 3) := ![![1, 0, 1], ![0, 3 / 4, 0]]
    let ũ' : UProfile (Fin 2) (Fin 3) := ![![1, 0, -1], ![0, 3 / 4, 0]]
    have h := hI ũ ũ' 0 1 (fun i => by fin_cases i <;> rfl) (fun i => by fin_cases i <;> rfl)
    have hw : e22D1cWeight ũ = 2 := by simp [e22D1cWeight, ũ]
    have hw' : e22D1cWeight ũ' = 1 := by simp [e22D1cWeight, ũ']
    simp only [e22D1cF, hw, hw'] at h
    simp [ũ, ũ'] at h
    norm_num at h
  refine ⟨fun ũ => ⟨fun a b => le_total _ _, fun a b c h1 h2 => h2.trans h1⟩,
    fun ũ a b => ⟨fun h => ?_, fun h => ⟨?_, ?_⟩⟩, rfl, hnotPI,
    fun ⟨R, hR⟩ => hnotPI (generatedBy_pairwiseIndependent hR)⟩
  · have := mul_le_mul_of_nonneg_left (h 1) (ht ũ).le
    unfold e22D1cF; linarith [h 0]
  · have := mul_le_mul_of_nonneg_left (h 1).le (ht ũ).le
    unfold e22D1cF; linarith [h 0]
  · have := mul_lt_mul_of_pos_left (h 1) (ht ũ)
    unfold e22D1cF; intro h'; linarith [h 0]

/-! ### Exercise 22.D.4: lexical dictatorship -/

variable {ι X : Type*}

/-- The lexicographic comparison of utility vectors along the list of agents `h₁, …, hₙ`. -/
def lexRel : List ι → (ι → ℝ) → (ι → ℝ) → Prop
  | [], _, _ => True
  | h :: t, u, u' => u' h < u h ∨ (u h = u' h ∧ lexRel t u u')

/-- **Exercise 22.D.4** (MWG, p. 852). The lexically dictatorial functional with the list of
agents `hs`: the strict preference of `h₁` prevails, then that of `h₂` among `h₁`-indifferent
alternatives, and so on. -/
def lexDictatorial (hs : List ι) : UProfile ι X → X → X → Prop :=
  fun ũ x y => lexRel hs (uvec ũ x) (uvec ũ y)

theorem lexRel_refl (hs : List ι) (u : ι → ℝ) : lexRel hs u u := by
  induction hs with
  | nil => trivial
  | cons h t ih => exact Or.inr ⟨rfl, ih⟩

theorem lexRel_rational (hs : List ι) : Rational (lexRel hs) := by
  induction hs with
  | nil => exact ⟨fun _ _ => Or.inl trivial, fun _ _ _ _ _ => trivial⟩
  | cons h t ih =>
    refine ⟨fun u u' => ?_, fun u u' u'' h1 h2 => ?_⟩
    · rcases lt_trichotomy (u h) (u' h) with hlt | heq | hgt
      · exact Or.inr (Or.inl hlt)
      · rcases ih.1 u u' with h' | h'
        · exact Or.inl (Or.inr ⟨heq, h'⟩)
        · exact Or.inr (Or.inr ⟨heq.symm, h'⟩)
      · exact Or.inl (Or.inl hgt)
    · rcases h1 with h1 | ⟨e1, h1⟩ <;> rcases h2 with h2 | ⟨e2, h2⟩
      · exact Or.inl (h2.trans h1)
      · exact Or.inl (e2 ▸ h1)
      · exact Or.inl (e1 ▸ h2)
      · exact Or.inr ⟨e1.trans e2, ih.2 _ _ _ h1 h2⟩

theorem lexRel_affine (hs : List ι) (β α : ι → ℝ) (hβ : ∀ i, 0 < β i) (u u' : ι → ℝ) :
    lexRel hs (fun i => β i * u i + α i) (fun i => β i * u' i + α i) ↔ lexRel hs u u' := by
  induction hs with
  | nil => exact Iff.rfl
  | cons h t ih =>
    simp only [lexRel, ih]
    have h1 : β h * u' h + α h < β h * u h + α h ↔ u' h < u h := by
      rw [add_lt_add_iff_right]; exact mul_lt_mul_iff_of_pos_left (hβ h)
    have h2 : β h * u h + α h = β h * u' h + α h ↔ u h = u' h := by
      rw [add_left_inj]; exact mul_right_inj' (hβ h).ne'
    rw [h1, h2]

/-- **Exercise 22.D.4(a)** (MWG, p. 852). A lexically dictatorial functional (with `n > 0`
agents) is a Paretian, pairwise independent social welfare functional that does not allow
interpersonal comparisons of utility, and `h₁`'s strict preference prevails. -/
theorem exercise_22_D_4a (h : ι) (t : List ι) :
    IsUSWF (lexDictatorial (X := X) (h :: t)) ∧ UParetian (lexDictatorial (X := X) (h :: t)) ∧
      UPairwiseIndependent (lexDictatorial (X := X) (h :: t)) ∧
      NoInterpersonalComparisons (lexDictatorial (X := X) (h :: t)) ∧
      ∀ (ũ : UProfile ι X) (x y : X), ũ h y < ũ h x →
        Strict (lexDictatorial (h :: t) ũ) x y := by
  have hgen : GeneratedBy (lexDictatorial (X := X) (h :: t)) (lexRel (h :: t)) :=
    fun _ _ _ => Iff.rfl
  have hmono : ∀ (s : List ι) (u u' : ι → ℝ), (∀ i, u' i ≤ u i) → lexRel s u u' := by
    intro s u u' hle
    induction s with
    | nil => trivial
    | cons k s ih => rcases (hle k).lt_or_eq with hlt | heq
                     · exact Or.inl hlt
                     · exact Or.inr ⟨heq.symm, ih⟩
  refine ⟨fun _ => ⟨fun _ _ => (lexRel_rational _).1 _ _, fun _ _ _ => (lexRel_rational _).2 _ _ _⟩,
    fun ũ x y => ⟨fun hle => hmono _ _ _ hle, fun hlt => ?_⟩,
    generatedBy_pairwiseIndependent hgen, fun β α hβ ũ => ?_, fun ũ x y hlt => ?_⟩
  · exact ⟨Or.inl (hlt h), fun h' => by
      rcases h' with h' | ⟨e, -⟩
      · exact lt_asymm h' (hlt h)
      · exact (hlt h).ne e⟩
  · exact invariance_of_relation hgen (fun v i => β i * v i + α i)
      (fun u u' => lexRel_affine _ β α hβ u u') ũ
  · exact ⟨Or.inl hlt, fun h' => by
      rcases h' with h' | ⟨e, -⟩
      · exact lt_asymm h' hlt
      · exact hlt.ne e⟩

/-- **Exercise 22.D.4(b)** (MWG, p. 852), the case `n = 1`: the dictatorial functional of a
single agent `h` is generated by the social welfare function `W(u) = uₕ`. -/
theorem exercise_22_D_4b_single (h : ι) :
    GeneratedBy (lexDictatorial (X := X) [h]) (fun u u' => u' h ≤ u h) := by
  intro ũ x y
  simp only [lexDictatorial, lexRel, and_true]
  constructor
  · rintro (h1 | h1)
    · exact h1.le
    · exact h1.ge
  · intro h1
    rcases h1.lt_or_eq with h2 | h2
    · exact Or.inl h2
    · exact Or.inr h2.symm

theorem lexRel_of_eq_on (s : List ι) {u u' : ι → ℝ} (h : ∀ j ∈ s, u j = u' j) :
    lexRel s u u' := by
  induction s with
  | nil => trivial
  | cons k s ih =>
    exact Or.inr ⟨h k (List.mem_cons_self ..), ih fun j hj => h j (List.mem_cons_of_mem _ hj)⟩

/-- **Exercise 22.D.4(b)** (MWG, p. 852), the case `n ≥ 2`: a lexically dictatorial functional
whose list starts with two distinct agents (in particular any list of `n ≥ 2` distinct agents)
cannot be generated by any social welfare function `W : ℝ^I → ℝ` (with two alternatives); it
would represent the lexicographic order of Example 3.C.1. -/
theorem exercise_22_D_4b_not_generated (hX : ∃ x y : X, x ≠ y) {h₁ h₂ : ι} (t : List ι)
    (hnd : (h₁ :: h₂ :: t).Nodup) :
    ¬∃ W : (ι → ℝ) → ℝ, GeneratedBy (lexDictatorial (X := X) (h₁ :: h₂ :: t))
      (fun u u' => W u' ≤ W u) := by
  classical
  rintro ⟨W, hW⟩
  obtain ⟨x, y, hxy⟩ := hX
  have h12 : h₁ ≠ h₂ := by
    intro e; rw [e] at hnd; simp at hnd
  have h1t : h₁ ∉ t := by intro h; simp_all
  have h2t : h₂ ∉ t := by intro h; simp_all
  -- the two relations agree on all vectors
  have hagree : ∀ u u' : ι → ℝ, W u' ≤ W u ↔ lexRel (h₁ :: h₂ :: t) u u' := by
    intro u u'
    have := hW (profile3 x y u u' u') x y
    simp only [lexDictatorial] at this
    rw [profile3_a, profile3_b hxy] at this
    exact this.symm
  let e : (Fin 2 → ℝ) → ι → ℝ := fun v i => if i = h₁ then v 0 else if i = h₂ then v 1 else 0
  apply MWG.ClassicalDemand.example_3_C_1_not_representable
  refine ⟨fun v => W (e v), fun v _ v' _ => ?_⟩
  rw [hagree]
  have hrest : lexRel t (e v) (e v') := lexRel_of_eq_on t fun j hj => by
    have hj1 : j ≠ h₁ := fun hj' => h1t (hj' ▸ hj)
    have hj2 : j ≠ h₂ := fun hj' => h2t (hj' ▸ hj)
    simp [e, hj1, hj2]
  have e1 : ∀ w : Fin 2 → ℝ, e w h₁ = w 0 := fun w => by simp [e]
  have e2 : ∀ w : Fin 2 → ℝ, e w h₂ = w 1 := fun w => by simp [e, Ne.symm h12]
  simp only [lexRel, e1, e2, MWG.ClassicalDemand.lexPref]
  constructor
  · rintro (h | ⟨h, h'⟩)
    · exact Or.inl h
    · rcases h'.lt_or_eq with h'' | h''
      · exact Or.inr ⟨h, Or.inl h''⟩
      · exact Or.inr ⟨h, Or.inr ⟨h''.symm, hrest⟩⟩
  · rintro (h | ⟨h, h' | ⟨h', -⟩⟩)
    · exact Or.inl h
    · exact Or.inr ⟨h, h'.le⟩
    · exact Or.inr ⟨h, h'.ge⟩

end MWG.WelfareBargaining
