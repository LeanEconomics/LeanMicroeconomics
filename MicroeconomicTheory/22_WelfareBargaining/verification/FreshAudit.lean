/-!
# Harsanyi's theorem for any number of individuals

MWG, Exercise 22.C.3(d) (p. 851), corrected (correction 10), for every finite set of
individuals. The proof uses Farkas's lemma (`MWG.Production.farkas`, imported from MWG Chapter 5,
Appendix M.M) for the cone generated by the `uᵢ` and `±𝟙`: if `u` were outside it, a direction
`y` with `∑ yₙ = 0`, `uᵢ·y ≤ 0` and `u·y > 0` would combine with the agreement direction `d₀`
into a direction that every individual strictly prefers while `U` does not.
-/

namespace MWG.WelfareBargaining

/-- `U` is Paretian in the directions of the simplex, for any finite set of individuals. -/
theorem harsanyi_direction_gen {ι : Type*} {N : ℕ} {u : Fin N → ℝ} {us : ι → Fin N → ℝ}
    (hP : HarsanyiParetian u us) (hN : 0 < N) {d : Fin N → ℝ} (hd : ∑ n, d n = 0)
    (hpos : ∀ i, 0 < eu (us i) d) : 0 < eu u d := by
  obtain ⟨q, hq, ε, hε, hqd⟩ := lottery_direction hN d hd
  have h := hP _ hqd q hq fun i => by
    rw [eu_add, eu_smul]; nlinarith [hpos i]
  rw [eu_add, eu_smul] at h
  nlinarith

open Matrix in
/-- **Exercise 22.C.3(d)**, corrected, any number of individuals (Harsanyi's theorem, MWG,
p. 851). If `U` is Paretian with respect to `U₁, …, U_I` (expected utility functions on the
simplex of lotteries over `N` outcomes) and some pair of lotteries is strictly preferred by
every individual, then `U = ∑ βᵢUᵢ + c` on the simplex with `β ≥ 0`, `β ≠ 0`. -/
theorem exercise_22_C_3d_general {ι : Type*} [Fintype ι] {N : ℕ} {u : Fin N → ℝ}
    {us : ι → Fin N → ℝ} (hP : HarsanyiParetian u us)
    (hagree : ∃ p ∈ lotteries N, ∃ p' ∈ lotteries N, ∀ i, eu (us i) p' < eu (us i) p) :
    ∃ (β : ι → ℝ) (c : ℝ), 0 ≤ β ∧ β ≠ 0 ∧
      ∀ p ∈ lotteries N, eu u p = ∑ i, β i * eu (us i) p + c := by
  obtain ⟨p, hp, p', hp', hlt⟩ := hagree
  have hN : 0 < N := by
    rcases Nat.eq_zero_or_pos N with h | h
    · subst h; simp [lotteries] at hp
    · exact h
  set d₀ := p - p'
  have hd₀ : ∑ n, d₀ n = 0 := by simp [d₀, Finset.sum_sub_distrib, hp.2, hp'.2]
  have hpos : ∀ i, 0 < eu (us i) d₀ := fun i => by rw [eu_sub]; linarith [hlt i]
  -- generators: the `uᵢ`, `𝟙` and `-𝟙`
  set a : ι ⊕ Fin 2 → Fin N → ℝ := fun k => Sum.elim us (fun j => if j = 0 then
    (fun _ => (1 : ℝ)) else fun _ => -1) k with ha
  have heu : ∀ v w : Fin N → ℝ, eu v w = w ⬝ᵥ v := fun v w => by
    simp [eu, dotProduct, mul_comm]
  have hcone : ∃ lam : ι ⊕ Fin 2 → ℝ, 0 ≤ lam ∧ u = ∑ k, lam k • a k := by
    rw [MWG.Production.farkas]
    rintro ⟨y, hy, hyu⟩
    have hy1 := hy (Sum.inr 0)
    have hy2 := hy (Sum.inr 1)
    simp only [ha, Sum.elim_inr, ↓reduceIte, Fin.isValue, one_ne_zero] at hy1 hy2
    have hsy : ∑ n, y n = 0 := by
      have e1 : y ⬝ᵥ (fun _ => (1 : ℝ)) = ∑ n, y n := by simp [dotProduct]
      have e2 : y ⬝ᵥ (fun _ => (-1 : ℝ)) = -∑ n, y n := by simp [dotProduct]
      rw [e1] at hy1; rw [e2] at hy2; linarith
    -- the direction `d₀ + K(-y)` is strictly preferred by everybody, but not by `U`
    set K := (|eu u d₀| + 1) / (y ⬝ᵥ u) with hK
    have hKpos : 0 < K := by positivity
    have hdir : ∑ n, (d₀ + K • (-y)) n = 0 := by
      simp [Finset.sum_add_distrib, ← Finset.mul_sum, hd₀, hsy]
    have hU := harsanyi_direction_gen hP hN hdir fun i => by
      have := hy (Sum.inl i)
      simp only [ha, Sum.elim_inl] at this
      rw [eu_add, eu_smul, heu (us i) (-y), neg_dotProduct]
      nlinarith [hpos i]
    rw [eu_add, eu_smul, heu u (-y), neg_dotProduct] at hU
    have : K * (y ⬝ᵥ u) = |eu u d₀| + 1 := by rw [hK, div_mul_cancel₀ _ hyu.ne']
    linarith [le_abs_self (eu u d₀)]
  obtain ⟨lam, hlam, hu⟩ := hcone
  have hval : ∀ q, eu u q = ∑ i, lam (Sum.inl i) * eu (us i) q +
      (lam (Sum.inr 0) - lam (Sum.inr 1)) * ∑ n, q n := by
    intro q
    have h1 : eu u q = ∑ k, lam k * eu (a k) q := by
      rw [hu]
      simp only [eu, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_mul,
        Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun n _ => by ring
    have e1 : eu (fun _ => (1 : ℝ)) q = ∑ n, q n := by simp [eu]
    have e2 : eu (fun _ => (-1 : ℝ)) q = -∑ n, q n := by simp [eu]
    rw [h1, Fintype.sum_sum_type, Fin.sum_univ_two]
    simp only [ha, Sum.elim_inl, Sum.elim_inr, Fin.isValue, ↓reduceIte, one_ne_zero, e1, e2]
    ring
  refine ⟨fun i => lam (Sum.inl i), lam (Sum.inr 0) - lam (Sum.inr 1), fun i => hlam _, ?_,
    fun q hq => by rw [hval, hq.2, mul_one]⟩
  intro h0
  have h := harsanyi_direction_gen hP hN hd₀ hpos
  rw [hval, hd₀] at h
  simp only [mul_zero, add_zero] at h
  have : ∀ i, lam (Sum.inl i) = 0 := fun i => congrFun h0 i
  simp [this] at h

/-- **Exercise 22.C.3(d)**, general version, instance (MWG, p. 851): the two-individual
instance `exercise_22_C_3d_instance`. -/
theorem exercise_22_C_3d_general_instance :
    HarsanyiParetian (![1, 1, 0] : Fin 3 → ℝ) ![![1, 0, 0], ![0, 1, 0]] ∧
      ∃ p ∈ lotteries 3, ∃ p' ∈ lotteries 3, ∀ i : Fin 2,
        eu ((![![1, 0, 0], ![0, 1, 0]] : Fin 2 → Fin 3 → ℝ) i) p' <
          eu ((![![1, 0, 0], ![0, 1, 0]] : Fin 2 → Fin 3 → ℝ) i) p := by
  obtain ⟨h1, p, hp, p', hp', h0, h1'⟩ := exercise_22_C_3d_instance
  exact ⟨h1, p, hp, p', hp', fun i => by fin_cases i; exacts [h0, h1']⟩

end MWG.WelfareBargaining

