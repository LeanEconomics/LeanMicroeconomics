/-!
# Independence of the axioms, linearity and consistency

MWG, Section 22.E, small type (i) and (iii) (pp. 845-846), Exercises 22.E.7, 22.E.8 and 22.E.9
(p. 854).

* `exercise_22_E_9`: the five assumptions of Proposition 22.E.1 (IUO, IUU, P, S, IIA) are
  independent: for each there is a bargaining solution violating it and satisfying the other
  four. The new examples: a Nash solution whose weights depend on the sign pattern of the threat
  point (violates IUO only), the threat point itself (violates P only), and the weighted Nash
  solution with weights `(1, 2)` (violates S only); `egal` and `ks` violate IUU and IIA.
* `linearity_fails`: the egalitarian, Nash and Kalai-Smorodinsky solutions are not additive:
  `f(U + U') ≠ f(U) + f(U')` for `U = {u ≤ (1, 3)}`, `U' = {u₁ + u₂ ≤ 2}`;
  `sequential_settlement`: under IUO, `f(U' + {f(U)}) = f(U') + f(U)`.
* `exercise_22_E_7`: solutions generated by maximizing `∑ᵢ g(uᵢ)` are consistent: the
  restriction of a maximizer to any group of agents maximizes `∑ g` over the reduced problem
  obtained by fixing the other agents' utilities, uniquely if the original maximizer is unique
  (`isGUMax_unique`: strict concavity gives uniqueness); `nash_isGUMax`: the Nash solution is of
  this form (`g = ln` on normalized problems), hence consistent.
* `exercise_22_E_8`: the Kalai-Smorodinsky solution is not consistent (three agents).
-/

namespace MWG.WelfareBargaining

open BargainingProblem

variable {ι : Type*} [Fintype ι]

/-- The weighted Nash solution of a half-space problem: `ûᵢ = αᵢ r/((∑ⱼ αⱼ) cᵢ)`. -/
theorem nashSol_halfSpace [Nonempty ι] {α : ι → ℝ} (hα : ∀ i, 0 < α i) (c : ι → ℝ)
    (hc : ∀ i, 0 < c i) (r : ℝ) (hr : 0 < r) :
    nashSol α (halfSpace c hc r hr) = fun i => α i * r / ((∑ j, α j) * c i) := by
  set A := ∑ j, α j with hA
  have hApos : 0 < A := Finset.sum_pos (fun j _ => hα j) Finset.univ_nonempty
  set û : ι → ℝ := fun i => α i * r / (A * c i) with hû
  have hûpos : ∀ i, 0 < û i := fun i => by simp only [hû]; have := hα i; have := hc i; positivity
  have hcu : ∀ i, c i * û i = α i * r / A := fun i => by
    simp only [hû]; field_simp [(hc i).ne']
  apply nashSol_eq hα
  refine ⟨?_, fun i => by simpa [halfSpace_d] using hûpos i, fun u hu hdu => ?_⟩
  · rw [halfSpace_U]
    simp only [hcu, ← Finset.sum_div, ← Finset.sum_mul, ← hA]
    field_simp; rfl
  · rw [halfSpace_U] at hu
    have hdu' : ∀ i, 0 < u i := fun i => by simpa [halfSpace_d] using hdu i
    simp only [nashObj, halfSpace_d, Pi.zero_apply, sub_zero]
    have hlog : ∀ i, α i * Real.log (u i) ≤ α i * Real.log (û i) + (A / r) * (c i * u i) - α i := by
      intro i
      have h := Real.log_le_sub_one_of_pos (div_pos (hdu' i) (hûpos i))
      rw [Real.log_div (hdu' i).ne' (hûpos i).ne'] at h
      have e : α i * (u i / û i) = (A / r) * (c i * u i) := by
        simp only [hû]; field_simp [(hα i).ne', (hc i).ne']
      nlinarith [hα i]
    calc ∑ i, α i * Real.log (u i) ≤ ∑ i, (α i * Real.log (û i) + (A / r) * (c i * u i) - α i) :=
          Finset.sum_le_sum fun i _ => hlog i
      _ = ∑ i, α i * Real.log (û i) + ((A / r) * ∑ i, c i * u i - A) := by
          simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, hA]; ring
      _ ≤ ∑ i, α i * Real.log (û i) := by
          have : (A / r) * ∑ i, c i * u i ≤ (A / r) * r :=
            mul_le_mul_of_nonneg_left hu (div_pos hApos hr).le
          rw [div_mul_cancel₀ _ hr.ne'] at this
          linarith

/-- The symmetric half-space `{u₁ + u₂ ≤ r}`. -/
noncomputable def symHalf (r : ℝ) (hr : 0 < r) : BargainingProblem (Fin 2) :=
  halfSpace (fun _ => 1) (fun _ => one_pos) r hr

theorem mem_symHalf {r : ℝ} {hr : 0 < r} (u : Fin 2 → ℝ) :
    u ∈ (symHalf r hr).U ↔ u 0 + u 1 ≤ r := by
  simp [symHalf, halfSpace_U, Fin.sum_univ_two]

theorem symHalf_symmetric (r : ℝ) (hr : 0 < r) : IsSymmetricSet (symHalf r hr).U :=
  halfSpace_symmetric 1 one_pos r hr

/-! ### Exercise 22.E.9: independence of the axioms -/

/-- The weights of the IUO violator: `2` for an agent whose threat payoff is positive while some
other agent's is not, `1` otherwise. They depend only on the sign pattern of `u*`. -/
noncomputable def signWeights (d : Fin 2 → ℝ) : Fin 2 → ℝ := by
  classical
  exact fun i => if 0 < d i ∧ ∃ j, d j ≤ 0 then 2 else 1

theorem signWeights_pos (d : Fin 2 → ℝ) (i : Fin 2) : 0 < signWeights d i := by
  unfold signWeights; split_ifs <;> norm_num

theorem signWeights_scale (d β : Fin 2 → ℝ) (hβ : ∀ i, 0 < β i) :
    signWeights (fun i => β i * d i) = signWeights d := by
  funext i
  have h1 : ∀ k, 0 < β k * d k ↔ 0 < d k := fun k => mul_pos_iff_of_pos_left (hβ k)
  have h2 : ∀ k, β k * d k ≤ 0 ↔ d k ≤ 0 := fun k => by
    rw [← not_lt, h1, not_lt]
  simp only [signWeights, h1, h2]

theorem signWeights_sym {d : Fin 2 → ℝ} (hd : ∀ i j, d i = d j) : signWeights d = fun _ => 1 := by
  funext i
  simp only [signWeights]
  split_ifs with h
  · obtain ⟨hpos, j, hj⟩ := h
    rw [hd j i] at hj; linarith
  · rfl

/-- **Exercise 22.E.9** (MWG, p. 854), the IUO violator: the Nash solution with the weights
`signWeights u*`. -/
noncomputable def signNash (P : BargainingProblem (Fin 2)) : Fin 2 → ℝ :=
  nashSol (signWeights P.d) P

/-- **Exercise 22.E.9** (MWG, p. 854). `signNash` is a bargaining solution satisfying IUU, P, S
and IIA but not IUO. -/
theorem signNash_props :
    IsBargainingSolution signNash ∧ ¬IUO signNash ∧ IUU signNash ∧ ParetoBS signNash ∧
      SymmetricBS signNash ∧ IIA signNash := by
  refine ⟨fun P => nashSol_isBargainingSolution (signWeights_pos P.d) P, ?_, fun P β hβ => ?_,
    fun P => nashSol_pareto (signWeights_pos P.d) P, fun P hsym hd i j => ?_,
    fun P P' hsub hd hmem => ?_⟩
  · intro h
    have e := h (symHalf 2 two_pos) ![1, 0]
    have hd0 : (symHalf 2 two_pos).d = 0 := rfl
    have hw : signWeights ((symHalf 2 two_pos).translate ![1, 0]).d = ![2, 1] := by
      rw [translate_d, hd0, zero_add]
      funext i; fin_cases i <;> simp [signWeights]
    have hw0 : signWeights (symHalf 2 two_pos).d = fun _ => 1 := by
      rw [hd0]; exact signWeights_sym fun _ _ => rfl
    simp only [signNash, hw, hw0] at e
    rw [nashSol_IUO (fun i => by fin_cases i <;> norm_num), symHalf,
      nashSol_halfSpace (fun i => by fin_cases i <;> norm_num),
      nashSol_halfSpace (fun _ => one_pos)] at e
    have := congrFun e 1
    simp [Fin.sum_univ_two] at this
    norm_num at this
  · simp only [signNash, scale_d, signWeights_scale _ _ hβ]
    exact nashSol_IUU (signWeights_pos P.d) P β hβ
  · simp only [signNash, signWeights_sym hd]
    exact nashSol_symmetric one_pos P hsym hd i j
  · simp only [signNash, hd]
    exact nashSol_IIA (signWeights_pos P.d) P P' hsub hd hmem

/-- **Exercise 22.E.9** (MWG, p. 854), the Pareto violator: the threat point. -/
theorem threat_props :
    IsBargainingSolution (fun P : BargainingProblem (Fin 2) => P.d) ∧
      IUO (fun P : BargainingProblem (Fin 2) => P.d) ∧
      IUU (fun P : BargainingProblem (Fin 2) => P.d) ∧
      ¬ParetoBS (fun P : BargainingProblem (Fin 2) => P.d) ∧
      SymmetricBS (fun P : BargainingProblem (Fin 2) => P.d) ∧
      IIA (fun P : BargainingProblem (Fin 2) => P.d) := by
  refine ⟨fun P => P.d_mem, fun P a => rfl, fun P β hβ => rfl, fun h => ?_,
    fun P _ hd i j => hd i j, fun P P' _ hd _ => hd⟩
  obtain ⟨ε, hε, hmem⟩ := (symHalf 2 two_pos).exists_gt
  exact h (symHalf 2 two_pos) ⟨_, hmem, fun i => by simp [hε]⟩

/-- **Exercise 22.E.9** (MWG, p. 854), the symmetry violator: the weighted Nash solution with
weights `(1, 2)`; on `{u₁ + u₂ ≤ 2}` it gives `(2/3, 4/3)`. -/
theorem weightedNash_props :
    IsBargainingSolution (nashSol (![1, 2] : Fin 2 → ℝ)) ∧ IUO (nashSol (![1, 2] : Fin 2 → ℝ)) ∧
      IUU (nashSol (![1, 2] : Fin 2 → ℝ)) ∧ ParetoBS (nashSol (![1, 2] : Fin 2 → ℝ)) ∧
      ¬SymmetricBS (nashSol (![1, 2] : Fin 2 → ℝ)) ∧ IIA (nashSol (![1, 2] : Fin 2 → ℝ)) := by
  have hα : ∀ i, 0 < (![1, 2] : Fin 2 → ℝ) i := fun i => by fin_cases i <;> norm_num
  refine ⟨nashSol_isBargainingSolution hα, nashSol_IUO hα, nashSol_IUU hα, nashSol_pareto hα,
    fun h => ?_, nashSol_IIA hα⟩
  have := h (symHalf 2 two_pos) (symHalf_symmetric 2 two_pos) (fun _ _ => rfl) 0 1
  rw [symHalf, nashSol_halfSpace hα] at this
  simp [Fin.sum_univ_two] at this
  norm_num at this

/-- **Exercise 22.E.9** (MWG, p. 854). The five assumptions of Proposition 22.E.1 are
independent: for each one there is a bargaining solution (two agents) violating it and
satisfying the other four. -/
theorem exercise_22_E_9 :
    (∃ f : BargainingProblem (Fin 2) → Fin 2 → ℝ, IsBargainingSolution f ∧
      ¬IUO f ∧ IUU f ∧ ParetoBS f ∧ SymmetricBS f ∧ IIA f) ∧
    (∃ f : BargainingProblem (Fin 2) → Fin 2 → ℝ, IsBargainingSolution f ∧
      IUO f ∧ ¬IUU f ∧ ParetoBS f ∧ SymmetricBS f ∧ IIA f) ∧
    (∃ f : BargainingProblem (Fin 2) → Fin 2 → ℝ, IsBargainingSolution f ∧
      IUO f ∧ IUU f ∧ ¬ParetoBS f ∧ SymmetricBS f ∧ IIA f) ∧
    (∃ f : BargainingProblem (Fin 2) → Fin 2 → ℝ, IsBargainingSolution f ∧
      IUO f ∧ IUU f ∧ ParetoBS f ∧ ¬SymmetricBS f ∧ IIA f) ∧
    (∃ f : BargainingProblem (Fin 2) → Fin 2 → ℝ, IsBargainingSolution f ∧
      IUO f ∧ IUU f ∧ ParetoBS f ∧ SymmetricBS f ∧ ¬IIA f) := by
  obtain ⟨e1, e2, e3, e4, -, e6⟩ := example_22_E_1 (ι := Fin 2)
  obtain ⟨k1, k2, k3, k4, k5, -⟩ := example_22_E_4 (ι := Fin 2)
  exact ⟨⟨signNash, signNash_props⟩, ⟨egal, e1, e2, egal_not_IUU, e3, e4, e6⟩,
    ⟨_, threat_props⟩, ⟨_, weightedNash_props⟩, ⟨ks, k1, k2, k3, k4, k5, ks_not_IIA.1⟩⟩

/-! ### Small type (i): linearity -/

/-- The box `{u ≤ (1, 3)}`. -/
noncomputable def box13 : BargainingProblem (Fin 2) :=
  boxProblem ![1, 3] (fun i => by fin_cases i <;> norm_num)

theorem egal_box13 : egal box13 = fun _ => 1 := by
  have hd : box13.d = 0 := rfl
  have hlev : box13.rayLevel (fun _ => 1) = 1 := by
    apply box13.rayLevel_eq (fun _ => one_pos) ⟨zero_le_one, fun i => by
      fin_cases i <;> simp [box13, boxProblem]⟩
    rintro t ⟨-, ht⟩
    have := ht 0
    simp [box13, boxProblem] at this
    linarith
  funext i; simp [egal, rayPoint, hlev, hd]

theorem egal_symHalf (r : ℝ) (hr : 0 < r) : egal (symHalf r hr) = fun _ => r / 2 := by
  have hd : (symHalf r hr).d = 0 := rfl
  have hlev : (symHalf r hr).rayLevel (fun _ => 1) = r / 2 := by
    apply (symHalf r hr).rayLevel_eq (fun _ => one_pos) ⟨by positivity, by
      rw [mem_symHalf]; simp [hd]⟩
    rintro t ⟨-, ht⟩
    rw [mem_symHalf] at ht
    simp [hd] at ht
    linarith
  funext i; simp [egal, rayPoint, hlev, hd]

open scoped Pointwise in
/-- `{u ≤ (1, 3)} + {u₁ + u₂ ≤ 2} = {u₁ + u₂ ≤ 6}`. -/
theorem box13_add_symHalf : box13.U + (symHalf 2 two_pos).U = (symHalf 6 (by norm_num)).U := by
  ext w
  simp only [Set.mem_add, mem_symHalf]
  constructor
  · rintro ⟨u, hu, v, hv, rfl⟩
    have h0 := hu 0; have h1 := hu 1
    norm_num at h0 h1
    simp only [Pi.add_apply]
    linarith
  · intro hw
    refine ⟨![1, 3], fun i => by fin_cases i <;> simp, w - ![1, 3], ?_, add_sub_cancel _ _⟩
    simp; linarith

open scoped Pointwise in
/-- **Section 22.E, small type (i)** (MWG, p. 845). Linearity fails for the egalitarian, Nash and
Kalai-Smorodinsky solutions: with `U = {u ≤ (1, 3)}` and `U' = {u₁ + u₂ ≤ 2}` (threat points
`0`), `U + U' = {u₁ + u₂ ≤ 6}` and each solution gives `(3, 3)` there, while
`f(U) + f(U')` is `(2, 2)` (egalitarian) or `(2, 4)` (Nash, Kalai-Smorodinsky). -/
theorem linearity_fails :
    box13.U + (symHalf 2 two_pos).U = (symHalf 6 (by norm_num)).U ∧
      egal (symHalf 6 (by norm_num)) ≠ egal box13 + egal (symHalf 2 two_pos) ∧
      nash (symHalf 6 (by norm_num)) ≠ nash box13 + nash (symHalf 2 two_pos) ∧
      ks (symHalf 6 (by norm_num)) ≠ ks box13 + ks (symHalf 2 two_pos) := by
  refine ⟨box13_add_symHalf, fun h => ?_, fun h => ?_, fun h => ?_⟩
  · have := congrFun h 0
    rw [egal_symHalf, egal_symHalf, egal_box13] at this
    norm_num at this
  · have := congrFun h 0
    rw [symHalf, symHalf, box13, nash_halfSpace, nash_halfSpace, nash_box] at this
    norm_num at this
  · have := congrFun h 0
    rw [symHalf, symHalf, box13, ks_halfSpace, ks_halfSpace, ks_box] at this
    norm_num at this

/-- **Section 22.E, small type (i)** (MWG, p. 845). By IUO the sequential settlement
`f(U' + {f(U)})` equals `f(U') + f(U)`. -/
theorem sequential_settlement {f : BargainingProblem ι → ι → ℝ} (hf : IUO f)
    (P P' : BargainingProblem ι) : f (P'.translate (f P)) = f P' + f P := hf P' (f P)

/-! ### Small type (iii), Exercises 22.E.7-22.E.8: consistency -/

/-- `û` maximizes the generalized utilitarian `∑ᵢ g(uᵢ)` on `U`. -/
def IsGUMax {κ : Type*} [Fintype κ] (g : ℝ → ℝ) (U : Set (κ → ℝ)) (û : κ → ℝ) : Prop :=
  û ∈ U ∧ ∀ u ∈ U, ∑ i, g (u i) ≤ ∑ i, g (û i)

/-- **Section 22.E, small type (iii)** (MWG, p. 845). The reduced problem of the group `p`: the
utility vectors of the group that are feasible when every other agent `i` keeps `ûᵢ`. -/
def reduceSet {κ : Type*} (p : κ → Prop) [DecidablePred p] (U : Set (κ → ℝ)) (û : κ → ℝ) :
    Set ({i // p i} → ℝ) :=
  {v | (fun i => if h : p i then v ⟨i, h⟩ else û i) ∈ U}

theorem sum_join {κ : Type*} [Fintype κ] (p : κ → Prop) [DecidablePred p] (g : ℝ → ℝ)
    (û : κ → ℝ) (v : {i // p i} → ℝ) :
    ∑ i, g ((fun i => if h : p i then v ⟨i, h⟩ else û i) i) =
      ∑ i : {i // p i}, g (v i) + ∑ i : {i // ¬p i}, g (û i) := by
  rw [← Fintype.sum_subtype_add_sum_subtype p]
  congr 1
  · exact Finset.sum_congr rfl fun i _ => by simp [i.2]
  · exact Finset.sum_congr rfl fun i _ => by simp [i.2]

/-- **Exercise 22.E.7** (MWG, pp. 845-846, 854). A family of solutions generated by maximizing
`∑ g(uᵢ)` (the same `g` for every set of agents) is consistent: if `û` maximizes `∑ g` on `U`,
then for any group `p` of agents the restriction of `û` maximizes `∑ g` on the reduced problem,
and it is the unique maximizer there when `û` is the unique maximizer on `U`. -/
theorem exercise_22_E_7 {κ : Type*} [Fintype κ] (p : κ → Prop) [DecidablePred p]
    {g : ℝ → ℝ} {U : Set (κ → ℝ)} {û : κ → ℝ} (h : IsGUMax g U û) :
    IsGUMax g (reduceSet p U û) (fun i : {i // p i} => û i.1) ∧
      ((∀ w, IsGUMax g U w → w = û) →
        ∀ v, IsGUMax g (reduceSet p U û) v → v = fun i : {i // p i} => û i.1) := by
  have hjoin : (fun i => if h : p i then (fun j : {i // p i} => û j) ⟨i, h⟩ else û i) = û := by
    funext i; split_ifs <;> rfl
  have hmem : (fun i : {i // p i} => û i) ∈ reduceSet p U û := by
    change (fun i => if h : p i then _ else _) ∈ U
    rw [hjoin]; exact h.1
  have hopt : ∀ v ∈ reduceSet p U û, ∑ i, g (v i) ≤ ∑ i : {i // p i}, g (û i) := by
    intro v hv
    have := h.2 _ hv
    rw [sum_join, ← Fintype.sum_subtype_add_sum_subtype p (fun i => g (û i))] at this
    linarith
  refine ⟨⟨hmem, hopt⟩, fun huniq v hv => ?_⟩
  have heq : ∑ i, g (v i) = ∑ i : {i // p i}, g (û i) :=
    le_antisymm (hopt v hv.1) (hv.2 _ hmem)
  have hjv := huniq _ ⟨hv.1, fun u hu => by
    rw [sum_join, heq, Fintype.sum_subtype_add_sum_subtype p (fun i => g (û i))]
    exact h.2 u hu⟩
  funext i
  have := congrFun hjv i.1
  simpa [i.2] using this

/-- **Exercise 22.E.7** (MWG, p. 854). With `g` strictly concave and `U` convex the maximizer of
`∑ g(uᵢ)` is unique, so the generated solution is well defined. -/
theorem isGUMax_unique {κ : Type*} [Fintype κ] {g : ℝ → ℝ} (hg : StrictConcaveOn ℝ Set.univ g)
    {U : Set (κ → ℝ)} (hU : Convex ℝ U) {w w' : κ → ℝ} (hw : IsGUMax g U w)
    (hw' : IsGUMax g U w') : w = w' := by
  by_contra hne
  obtain ⟨j, hj⟩ := Function.ne_iff.1 hne
  have hm := hU hw.1 hw'.1 (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num)
  have hlt : (∑ k, g (w k) + ∑ k, g (w' k)) / 2 <
      ∑ k, g (((1 / 2 : ℝ) • w + (1 / 2 : ℝ) • w') k) := by
    rw [← Finset.sum_add_distrib, Finset.sum_div]
    refine Finset.sum_lt_sum (fun k _ => ?_) ⟨j, Finset.mem_univ j, ?_⟩
    · have := hg.concaveOn.2 (Set.mem_univ (w k)) (Set.mem_univ (w' k))
        (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)
      simp only [smul_eq_mul, Pi.add_apply, Pi.smul_apply] at this ⊢
      linarith
    · have := hg.2 (Set.mem_univ (w j)) (Set.mem_univ (w' j)) hj
        (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num)
      simp only [smul_eq_mul, Pi.add_apply, Pi.smul_apply] at this ⊢
      linarith
  have h1 := hw.2 _ hm
  have h2 := hw'.2 w hw.1
  linarith

/-- **Exercise 22.E.7**, instance (MWG, p. 854): `g(t) = -e^{-t}` (increasing), `U = {u ≤ 0}`;
`0` is the unique maximizer. -/
theorem exercise_22_E_7_instance :
    IsGUMax (fun t => -Real.exp (-t)) {u : Fin 2 → ℝ | u ≤ 0} 0 ∧
      ∀ w, IsGUMax (fun t => -Real.exp (-t)) {u : Fin 2 → ℝ | u ≤ 0} w → w = 0 := by
  have hle : ∀ u : Fin 2 → ℝ, u ≤ 0 → ∀ k, -Real.exp (-u k) ≤ -Real.exp (-(0 : Fin 2 → ℝ) k) :=
    fun u hu k => by
      simp only [Pi.zero_apply, neg_zero, Real.exp_zero, neg_le_neg_iff, Real.one_le_exp_iff]
      have := hu k; simp at this; linarith
  refine ⟨⟨show (0 : Fin 2 → ℝ) ≤ 0 from le_rfl, fun u hu => Finset.sum_le_sum fun k _ =>
    hle u hu k⟩, fun w hw => ?_⟩
  funext k
  by_contra hne
  have hlt : w k < 0 := lt_of_le_of_ne (hw.1 k) hne
  have hs : ∑ i, -Real.exp (-w i) < ∑ i, -Real.exp (-(0 : Fin 2 → ℝ) i) :=
    Finset.sum_lt_sum (fun i _ => hle w hw.1 i) ⟨k, Finset.mem_univ k, by
      simp only [Pi.zero_apply, neg_zero, Real.exp_zero, neg_lt_neg_iff]
      exact Real.one_lt_exp_iff.2 (by linarith)⟩
  have := hw.2 0 (show (0 : Fin 2 → ℝ) ≤ 0 from le_rfl)
  linarith

/-- **Section 22.E, small type (iii)** (MWG, p. 846). The Nash solution of a normalized problem
maximizes `∑ ln uᵢ` on `U ∩ ℝ^I₊₊`, so by `exercise_22_E_7` it is consistent. -/
theorem nash_isGUMax [Nonempty ι] (P : BargainingProblem ι) (hd : P.d = 0) :
    IsGUMax Real.log (P.U ∩ {u | ∀ i, 0 < u i}) (nash P) := by
  have h : IsNashPoint (fun _ => 1) P (nash P) := nashSol_spec (fun _ => one_pos) P
  refine ⟨⟨h.1, fun i => by simpa [hd] using h.2.1 i⟩, fun u hu => ?_⟩
  have := h.2.2 u hu.1 fun i => by simpa [hd] using hu.2 i
  simpa [nashObj, hd] using this

/-- The three-agent problem of `exercise_22_E_8`: `{u₁ + u₂ + u₃ ≤ 3, u₃ ≤ 1}`. -/
noncomputable def ks3 : BargainingProblem (Fin 3) :=
  interHalf (halfSpace (fun _ => 1) (fun _ => one_pos) 3 (by norm_num)) ![0, 0, 1]
    (fun i => by fin_cases i <;> norm_num) 1 (by simp [halfSpace_d])

theorem mem_ks3 (u : Fin 3 → ℝ) : u ∈ ks3.U ↔ u 0 + u 1 + u 2 ≤ 3 ∧ u 2 ≤ 1 := by
  simp [ks3, interHalf, halfSpace_U, Fin.sum_univ_three]

/-- The reduced two-agent problem of `exercise_22_E_8`: `{v₁ + v₂ ≤ 12/7, v₂ ≤ 1}`. -/
noncomputable def ks3red : BargainingProblem (Fin 2) :=
  interHalf (halfSpace (fun _ => 1) (fun _ => one_pos) (12 / 7) (by norm_num)) ![0, 1]
    (fun i => by fin_cases i <;> norm_num) 1 (by simp [halfSpace_d])

theorem mem_ks3red (v : Fin 2 → ℝ) : v ∈ ks3red.U ↔ v 0 + v 1 ≤ 12 / 7 ∧ v 1 ≤ 1 := by
  simp [ks3red, interHalf, halfSpace_U, Fin.sum_univ_two]

theorem ks_ks3 : ks ks3 = ![9 / 7, 9 / 7, 3 / 7] := by
  have hd : ks3.d = 0 := rfl
  have hi0 : ks3.ideal 0 = 3 := ks3.ideal_eq 0 ⟨![3, 0, 0], by rw [mem_ks3]; norm_num,
    fun i => by fin_cases i <;> simp [hd], rfl⟩ fun u hu hdu => by
      rw [mem_ks3] at hu; have := hdu 1; have := hdu 2; simp [hd] at *; linarith
  have hi1 : ks3.ideal 1 = 3 := ks3.ideal_eq 1 ⟨![0, 3, 0], by rw [mem_ks3]; norm_num,
    fun i => by fin_cases i <;> simp [hd], rfl⟩ fun u hu hdu => by
      rw [mem_ks3] at hu; have := hdu 0; have := hdu 2; simp [hd] at *; linarith
  have hi2 : ks3.ideal 2 = 1 := ks3.ideal_eq 2 ⟨![0, 0, 1], by rw [mem_ks3]; norm_num,
    fun i => by fin_cases i <;> simp [hd], rfl⟩ fun u hu _ => by
      rw [mem_ks3] at hu; exact hu.2
  have hgap : ks3.idealGap = ![3, 3, 1] := by
    funext i; fin_cases i <;> simp [idealGap, hi0, hi1, hi2, hd]
  have hw : ∀ i, (0 : ℝ) < ![3, 3, 1] i := fun i => by fin_cases i <;> norm_num
  have hlev : ks3.rayLevel ![3, 3, 1] = 3 / 7 := by
    apply ks3.rayLevel_eq hw ⟨by norm_num, by rw [mem_ks3]; simp [hd]; norm_num⟩
    rintro t ⟨-, ht⟩
    rw [mem_ks3] at ht
    simp [hd] at ht
    linarith [ht.1]
  funext i
  fin_cases i <;> norm_num [ks, rayPoint, hgap, hlev, hd]

theorem ks_ks3red : ks ks3red = ![144 / 133, 12 / 19] := by
  have hd : ks3red.d = 0 := rfl
  have hi0 : ks3red.ideal 0 = 12 / 7 := ks3red.ideal_eq 0 ⟨![12 / 7, 0],
    by rw [mem_ks3red]; norm_num, fun i => by fin_cases i <;> simp [hd]; norm_num, rfl⟩
    fun u hu hdu => by rw [mem_ks3red] at hu; have := hdu 1; simp [hd] at this; linarith
  have hi1 : ks3red.ideal 1 = 1 := ks3red.ideal_eq 1 ⟨![0, 1], by rw [mem_ks3red]; norm_num,
    fun i => by fin_cases i <;> simp [hd], rfl⟩ fun u hu _ => by
      rw [mem_ks3red] at hu; exact hu.2
  have hgap : ks3red.idealGap = ![12 / 7, 1] := by
    funext i; fin_cases i <;> simp [idealGap, hi0, hi1, hd]
  have hw : ∀ i, (0 : ℝ) < ![12 / 7, 1] i := fun i => by fin_cases i <;> norm_num
  have hlev : ks3red.rayLevel ![12 / 7, 1] = 12 / 19 := by
    apply ks3red.rayLevel_eq hw ⟨by norm_num, by rw [mem_ks3red]; simp [hd]; norm_num⟩
    rintro t ⟨-, ht⟩
    rw [mem_ks3red] at ht
    simp [hd] at ht
    linarith [ht.1]
  funext i
  fin_cases i <;> norm_num [ks, rayPoint, hgap, hlev, hd]

/-- **Exercise 22.E.8** (MWG, p. 854). The Kalai-Smorodinsky solution is not consistent. For
`U = {u₁ + u₂ + u₃ ≤ 3, u₃ ≤ 1}` it gives `(9/7, 9/7, 3/7)`. Fixing agent 1 at `9/7`, the
reduced problem of agents 2 and 3 is `{v₂ + v₃ ≤ 12/7, v₃ ≤ 1}` (same threat point `0`), whose
Kalai-Smorodinsky solution is `(144/133, 12/19) ≠ (9/7, 3/7)`. -/
theorem exercise_22_E_8 :
    ks ks3 = ![9 / 7, 9 / 7, 3 / 7] ∧
      (∀ v : Fin 2 → ℝ, v ∈ ks3red.U ↔ ![ks ks3 0, v 0, v 1] ∈ ks3.U) ∧
      ks3red.d = ![ks3.d 1, ks3.d 2] ∧ ks ks3red ≠ ![ks ks3 1, ks ks3 2] := by
  refine ⟨ks_ks3, fun v => ?_, ?_, ?_⟩
  · rw [mem_ks3red, mem_ks3, ks_ks3]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.tail_cons, Matrix.head_cons]
    constructor <;> rintro ⟨h1, h2⟩ <;> exact ⟨by linarith, h2⟩
  · funext i; fin_cases i <;> rfl
  · rw [ks_ks3red, ks_ks3]
    intro h
    have := congrFun h 0
    norm_num at this

end MWG.WelfareBargaining

