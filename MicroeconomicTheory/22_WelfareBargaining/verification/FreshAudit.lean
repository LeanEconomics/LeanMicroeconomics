/-!
# Social welfare functionals on utility profiles

MWG, Section 22.D, pp. 831-834: Definitions 22.D.1-22.D.3, Proposition 22.D.1 with its proof
(footnote 17 and Exercise 22.D.2), Exercise 22.D.3 and Exercise 22.D.1(a)-(c).

A utility profile assigns to every agent `i : ι` a utility function `X → ℝ` (`UProfile`). A
social welfare functional (Definition 22.D.1) is a map `F` from utility profiles to rational
preference relations on `X` (Kreps's `Rational`, as in Chapter 21). `UParetian` is the two-part
Pareto property of Definition 22.D.2 and `UPairwiseIndependent` is Definition 22.D.3.
`GeneratedBy F R` says that the relation `R` on `ℝ^I` generates `F`:
`x F(ũ) y ↔ (ũᵢ(x))ᵢ R (ũᵢ(y))ᵢ`.

Proposition 22.D.1 (`proposition_22_D_1`): with at least three alternatives, a Paretian and
pairwise independent social welfare functional is generated by a rational relation on `ℝ^I`.
The proof follows the book: the relation is read off one pair of alternatives, and the chains
of replacements of footnote 17 (the replacement `(x, y) → (x, z)` of the text and the
replacement `(x, y) → (z, y)` of Exercise 22.D.2) show that every pair gives the same relation.
Exercise 22.D.3 (`exercise_22_D_3`): the generating relation is monotone. Exercise 22.D.1 shows
that neither the Pareto property, nor the number of alternatives, nor pairwise independence can
be dropped. No departures from the book.
-/

namespace MWG.WelfareBargaining

open Kreps.ChoicePreferenceUtility

variable {ι X : Type*}

/-- A profile of utility functions `(ũ₁, …, ũ_I)` on `X` (MWG, p. 831). -/
abbrev UProfile (ι X : Type*) := ι → X → ℝ

/-- The vector of utility values `(ũ₁(x), …, ũ_I(x)) ∈ ℝ^I` of an alternative. -/
def uvec (ũ : UProfile ι X) (x : X) : ι → ℝ := fun i => ũ i x

/-- **Definition 22.D.1** (MWG, p. 832). A social welfare functional assigns a rational
preference relation `F ũ` on `X` to every profile of utility functions. -/
def IsUSWF (F : UProfile ι X → X → X → Prop) : Prop := ∀ ũ, Rational (F ũ)

/-- **Definition 22.D.2** (MWG, p. 832). The (weak) Pareto property: if every agent weakly
prefers `x` to `y` then `x` is socially weakly preferred, and if every agent strictly prefers
`x` then `x` is socially strictly preferred. -/
def UParetian (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ ũ x y, ((∀ i, ũ i y ≤ ũ i x) → F ũ x y) ∧ ((∀ i, ũ i y < ũ i x) → Strict (F ũ) x y)

/-- **Definition 22.D.3** (MWG, p. 832). Pairwise independence: the social ranking of `x` and
`y` depends only on the utility values of `x` and `y`. -/
def UPairwiseIndependent (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ ũ ũ' x y, (∀ i, ũ i x = ũ' i x) → (∀ i, ũ i y = ũ' i y) → (F ũ x y ↔ F ũ' x y)

/-- **Section 22.D** (MWG, p. 833). The relation `R` on `ℝ^I` generates `F`:
`x F(ũ) y ↔ (ũᵢ(x))ᵢ R (ũᵢ(y))ᵢ` for every profile and every pair. -/
def GeneratedBy (F : UProfile ι X → X → X → Prop) (R : (ι → ℝ) → (ι → ℝ) → Prop) : Prop :=
  ∀ ũ x y, F ũ x y ↔ R (uvec ũ x) (uvec ũ y)

/-- **Section 22.D** (MWG, p. 832). The functional generated by a social welfare function
`W : ℝ^I → ℝ`: `x F(ũ) y ↔ W(ũ(x)) ≥ W(ũ(y))`. -/
def swfFunctional (W : (ι → ℝ) → ℝ) : UProfile ι X → X → X → Prop :=
  fun ũ x y => W (uvec ũ y) ≤ W (uvec ũ x)

/-- The functional generated by `W` is generated by the relation `W(u) ≥ W(u')`. -/
theorem swfFunctional_generatedBy (W : (ι → ℝ) → ℝ) :
    GeneratedBy (swfFunctional (X := X) W) (fun u u' => W u' ≤ W u) :=
  fun _ _ _ => Iff.rfl

/-- The functional generated by a social welfare function is a social welfare functional. -/
theorem swfFunctional_isUSWF (W : (ι → ℝ) → ℝ) : IsUSWF (swfFunctional (X := X) W) :=
  fun _ => ⟨fun _ _ => le_total _ _, fun _ _ _ h1 h2 => h2.trans h1⟩

/-- **Section 22.D** (MWG, p. 832). A generated functional is pairwise independent: this is
the necessary condition singled out in the text. -/
theorem generatedBy_pairwiseIndependent {F : UProfile ι X → X → X → Prop}
    {R : (ι → ℝ) → (ι → ℝ) → Prop} (h : GeneratedBy F R) : UPairwiseIndependent F := by
  intro ũ ũ' x y hx hy
  have ex : uvec ũ x = uvec ũ' x := funext hx
  have ey : uvec ũ y = uvec ũ' y := funext hy
  rw [h, h, ex, ey]

/-- A profile with prescribed utility vectors `u`, `v`, `w` at `a`, `b` and every other
alternative. -/
noncomputable def profile3 (a b : X) (u v w : ι → ℝ) : UProfile ι X := by
  classical
  exact fun i z => if z = a then u i else if z = b then v i else w i

theorem profile3_a (a b : X) (u v w : ι → ℝ) : uvec (profile3 a b u v w) a = u := by
  classical
  funext i
  simp [uvec, profile3]

theorem profile3_b {a b : X} (hab : a ≠ b) (u v w : ι → ℝ) :
    uvec (profile3 a b u v w) b = v := by
  classical
  funext i
  simp [uvec, profile3, hab.symm]

theorem profile3_c {a b c : X} (hac : a ≠ c) (hbc : b ≠ c) (u v w : ι → ℝ) :
    uvec (profile3 a b u v w) c = w := by
  classical
  funext i
  simp [uvec, profile3, hac.symm, hbc.symm]

/-- The relation on `ℝ^I` read off the pair `(x, y)`: `u R_{xy} u'` iff `x F(ũ) y` for the
profile with `ũ(x) = u` and `ũ(y) = u'` (MWG, p. 833). -/
def pairRel (F : UProfile ι X → X → X → Prop) (x y : X) (u u' : ι → ℝ) : Prop :=
  F (profile3 x y u u' u') x y

variable {F : UProfile ι X → X → X → Prop}

/-- By pairwise independence, `R_{xy}` can be read off any profile with the given values. -/
theorem pairRel_iff (hI : UPairwiseIndependent F) {x y : X} (hxy : x ≠ y) (ũ : UProfile ι X) :
    F ũ x y ↔ pairRel F x y (uvec ũ x) (uvec ũ y) := by
  unfold pairRel
  apply hI
  · intro i
    have := congrFun (profile3_a x y (uvec ũ x) (uvec ũ y) (uvec ũ y)) i
    rw [uvec] at this
    exact this.symm
  · intro i
    have := congrFun (profile3_b hxy (uvec ũ x) (uvec ũ y) (uvec ũ y)) i
    rw [uvec] at this
    exact this.symm

/-- **Proposition 22.D.1, proof** (MWG, p. 833). The replacement `(x, y) → (x, z)`: a conclusion
`u ≿ u'` reached with the pair `(x, y)` is reached with `(x, z)`. -/
theorem pairRel_replace_snd (hF : IsUSWF F) (hP : UParetian F) (hI : UPairwiseIndependent F)
    {x y z : X} (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) {u u' : ι → ℝ}
    (h : pairRel F x y u u') : pairRel F x z u u' := by
  have ex := profile3_a x y u u' u'
  have ey := profile3_b hxy u u' u'
  have ez := profile3_c hxz hyz u u' u'
  set ũ := profile3 x y u u' u'
  have h1 : F ũ x y := by rw [pairRel_iff hI hxy, ex, ey]; exact h
  have h2 : F ũ y z := (hP ũ y z).1 fun i => by
    change uvec ũ z i ≤ uvec ũ y i
    rw [ez, ey]
  have h3 : F ũ x z := (hF ũ).2 x y z h1 h2
  rw [pairRel_iff hI hxz, ex, ez] at h3
  exact h3

/-- **Exercise 22.D.2** (MWG, pp. 833, 852). The replacement `(x, y) → (z, y)`: a conclusion
`u ≿ u'` reached with the pair `(x, y)` is reached with `(z, y)`. -/
theorem exercise_22_D_2 (hF : IsUSWF F) (hP : UParetian F) (hI : UPairwiseIndependent F)
    {x y z : X} (hxy : x ≠ y) (hzx : z ≠ x) (hzy : z ≠ y) {u u' : ι → ℝ}
    (h : pairRel F x y u u') : pairRel F z y u u' := by
  have ez := profile3_a z x u u u'
  have ex := profile3_b hzx u u u'
  have ey := profile3_c hzy hxy u u u'
  set ũ := profile3 z x u u u'
  have h1 : F ũ x y := by rw [pairRel_iff hI hxy, ex, ey]; exact h
  have h2 : F ũ z x := (hP ũ z x).1 fun i => by
    change uvec ũ x i ≤ uvec ũ z i
    rw [ex, ez]
  have h3 : F ũ z y := (hF ũ).2 z x y h2 h1
  rw [pairRel_iff hI hzy, ez, ey] at h3
  exact h3

/-- Both replacements are equivalences. -/
theorem pairRel_snd_eq (hF : IsUSWF F) (hP : UParetian F) (hI : UPairwiseIndependent F)
    {x y z : X} (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) :
    pairRel F x y = pairRel F x z := by
  funext u u'
  exact propext ⟨pairRel_replace_snd hF hP hI hxy hxz hyz,
    pairRel_replace_snd hF hP hI hxz hxy hyz.symm⟩

theorem pairRel_fst_eq (hF : IsUSWF F) (hP : UParetian F) (hI : UPairwiseIndependent F)
    {x y z : X} (hxy : x ≠ y) (hzx : z ≠ x) (hzy : z ≠ y) :
    pairRel F x y = pairRel F z y := by
  funext u u'
  exact propext ⟨exercise_22_D_2 hF hP hI hxy hzx hzy,
    exercise_22_D_2 hF hP hI hzy hzx.symm hxy⟩

/-- **Footnote 17** (MWG, p. 833). With a third alternative available for every pair, all
pairs of distinct alternatives give the same relation, by the chains of replacements
`(x, y) → (v, y) → (v, w)`, `(x, y) → (x, w) → (v, w)` and `(x, y) → (x, z) → (y, z) → (y, x)`. -/
theorem footnote_22_17 (hF : IsUSWF F) (hP : UParetian F) (hI : UPairwiseIndependent F)
    (h3 : ∀ x y : X, ∃ z, z ≠ x ∧ z ≠ y) {x y v w : X} (hxy : x ≠ y) (hvw : v ≠ w) :
    pairRel F x y = pairRel F v w := by
  by_cases hvy : v = y
  · rw [hvy] at hvw ⊢
    by_cases hwx : w = x
    · rw [hwx]
      obtain ⟨z, hzx, hzy⟩ := h3 x y
      rw [pairRel_snd_eq hF hP hI hxy (Ne.symm hzx) (Ne.symm hzy),
        pairRel_fst_eq hF hP hI (Ne.symm hzx) (Ne.symm hxy) (Ne.symm hzy),
        ← pairRel_snd_eq hF hP hI hxy.symm (Ne.symm hzy) (Ne.symm hzx)]
    · rw [pairRel_snd_eq hF hP hI hxy (Ne.symm hwx) hvw,
        pairRel_fst_eq hF hP hI (Ne.symm hwx) hxy.symm hvw]
  · by_cases hvx : v = x
    · rw [hvx] at hvw ⊢
      by_cases hwy : w = y
      · rw [hwy]
      · exact pairRel_snd_eq hF hP hI hxy hvw (Ne.symm hwy)
    · rw [pairRel_fst_eq hF hP hI hxy hvx hvy]
      by_cases hwy : w = y
      · rw [hwy]
      · exact pairRel_snd_eq hF hP hI hvy hvw (Ne.symm hwy)

/-- **Proposition 22.D.1** (MWG, p. 833). If `X` has at least three alternatives and the
Paretian social welfare functional `F` satisfies pairwise independence, then a rational
preference relation `≿` on `ℝ^I` generates `F`:
`x F(ũ) y ↔ (ũ₁(x), …, ũ_I(x)) ≿ (ũ₁(y), …, ũ_I(y))`. -/
theorem proposition_22_D_1 (hX : ∃ a b c : X, a ≠ b ∧ a ≠ c ∧ b ≠ c) (hF : IsUSWF F)
    (hP : UParetian F) (hI : UPairwiseIndependent F) :
    ∃ R : (ι → ℝ) → (ι → ℝ) → Prop, Rational R ∧ GeneratedBy F R := by
  obtain ⟨a, b, c, hab, hac, hbc⟩ := hX
  have h3 : ∀ x y : X, ∃ z, z ≠ x ∧ z ≠ y := by
    intro x y
    by_cases h1 : a ≠ x ∧ a ≠ y
    · exact ⟨a, h1.1, h1.2⟩
    by_cases h2 : b ≠ x ∧ b ≠ y
    · exact ⟨b, h2.1, h2.2⟩
    refine ⟨c, ?_, ?_⟩ <;> intro hc <;> subst hc <;> grind
  have hsame := fun {x y : X} (hxy : x ≠ y) => footnote_22_17 hF hP hI h3 hxy hab
  refine ⟨pairRel F a b, ⟨fun u u' => ?_, fun u u' u'' h1 h2 => ?_⟩, fun ũ x y => ?_⟩
  · -- completeness, from the completeness of `F(ũ)`
    set ũ := profile3 a b u u' u'
    rcases (hF ũ).1 a b with h | h
    · left
      rw [pairRel_iff hI hab, profile3_a, profile3_b hab] at h
      exact h
    · right
      rw [pairRel_iff hI hab.symm, profile3_a, profile3_b hab, hsame hab.symm] at h
      exact h
  · -- transitivity, from the transitivity of `F(ũ)` on three alternatives
    set ũ := profile3 a b u u' u''
    have e1 : F ũ a b := by rw [pairRel_iff hI hab, profile3_a, profile3_b hab]; exact h1
    have e2 : F ũ b c := by
      rw [pairRel_iff hI hbc, profile3_b hab, profile3_c hac hbc, hsame hbc]; exact h2
    have e3 := (hF ũ).2 a b c e1 e2
    rw [pairRel_iff hI hac, profile3_a, profile3_c hac hbc, hsame hac] at e3
    exact e3
  · by_cases hxy : x = y
    · subst hxy
      have hrefl : F ũ x x := ((hF ũ).1 x x).elim id id
      refine ⟨fun _ => ?_, fun _ => hrefl⟩
      unfold pairRel
      apply (hP _ a b).1
      intro i
      exact le_of_eq ((congrFun (profile3_b hab (uvec ũ x) (uvec ũ x) (uvec ũ x)) i).trans
        (congrFun (profile3_a a b (uvec ũ x) (uvec ũ x) (uvec ũ x)) i).symm)
    · rw [pairRel_iff hI hxy, hsame hxy]

/-- **Exercise 22.D.3** (MWG, pp. 833-834). If `F` is Paretian, a relation generating `F` is
monotone: `u' ≥ u` implies `u' ≿ u`, and `u' ≫ u` implies `u' ≻ u` (two distinct alternatives
are needed to transfer the Pareto property to `ℝ^I`). -/
theorem exercise_22_D_3 (hX : ∃ x y : X, x ≠ y) {R : (ι → ℝ) → (ι → ℝ) → Prop}
    (hP : UParetian F) (hR : GeneratedBy F R) {u u' : ι → ℝ} :
    ((∀ i, u i ≤ u' i) → R u' u) ∧ ((∀ i, u i < u' i) → Strict R u' u) := by
  obtain ⟨x, y, hxy⟩ := hX
  have ex := profile3_a x y u' u u
  have ey := profile3_b hxy u' u u
  set ũ := profile3 x y u' u u
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have := (hP ũ x y).1 fun i => by
      change uvec ũ y i ≤ uvec ũ x i
      rw [ex, ey]; exact h i
    rw [hR, ex, ey] at this
    exact this
  · have := (hP ũ x y).2 fun i => by
      change uvec ũ y i < uvec ũ x i
      rw [ex, ey]; exact h i
    rw [Strict, hR, hR, ex, ey] at this
    exact this

end MWG.WelfareBargaining

