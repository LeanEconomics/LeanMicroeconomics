/-!
# Invariance properties of social welfare functionals

MWG, Section 22.D, pp. 834-837: Definitions 22.D.4-22.D.5, the parallel-indifference claim of
p. 834, Propositions 22.D.2-22.D.3 with their proofs, the extension of the dictatorship part of
Proposition 22.D.3 to functionals generated by a social preference relation (p. 837), and
Exercise 22.D.4(c).

`IsIncreasingSWF W` is the Paretian property (ii) of p. 825. The invariance notions of
Definitions 22.D.4-22.D.5 are stated for transformations of every agent's utility function.
`transfer_invariance` turns an invariance of `F` into the same invariance of any relation
generating `F` (two alternatives suffice).

Proposition 22.D.2 is proved by the book's construction: `eqLevel W u` is the unique `α` with
`W(αe) = W(u)` (continuity, monotonicity and the intermediate value theorem), it represents the
social preference, shifts by `t` under `u ↦ u + te` and, with common units, is homogeneous of
degree one; `g(s) = -eqLevel W s`. For Proposition 22.D.3 we show that with independent changes
of origins `eqLevel W` is additive; being monotone and translation equivariant it is
1-Lipschitz, hence a continuous additive map, hence linear: `eqLevel W u = ∑ bᵢ uᵢ` with
`bᵢ ≥ 0` and `∑ bᵢ = 1`. The book's midpoint step (indifference sets are hyperplanes) is
`indiff_midpoint`.

The dictatorship part is proved for any rational relation `≿` on `ℝ^I` that is monotone and
invariant to independent changes of origins and units (`dictator_of_invariant_relation`), as
the remark on p. 837 asserts. The proof is ours: such a relation depends only on sign patterns,
the coalitions `S` whose pattern `(+ on S, − off S)` is strictly preferred to `0` form an
ultrafilter on the finite set of agents, hence a principal one, and its generator is the
dictator. The book's `ε`-argument (p. 837) is used for Exercise 22.D.4(c).

Departure: the proof of Proposition 22.D.2 says "invariance to identical changes of units" where
origins are meant, and p. 835 refers to "Proposition 23.D.2" for 22.D.2; both are misprints
(see `docs/corrections.md`).
-/

namespace MWG.WelfareBargaining

open Kreps.ChoicePreferenceUtility

variable {ι X : Type*}

/-- **Section 22.C, property (ii)** (MWG, p. 825). A social welfare function is increasing
(Paretian): `u ≤ u'` implies `W(u) ≤ W(u')` and `u ≪ u'` implies `W(u) < W(u')`. -/
def IsIncreasingSWF (W : (ι → ℝ) → ℝ) : Prop :=
  (∀ u u' : ι → ℝ, (∀ i, u i ≤ u' i) → W u ≤ W u') ∧
    ∀ u u' : ι → ℝ, (∀ i, u i < u' i) → W u < W u'

/-- **Definition 22.D.4** (MWG, p. 834). Invariance to common cardinal transformations. -/
def InvCommonCardinal (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ β α : ℝ, 0 < β → ∀ ũ : UProfile ι X, F (fun i x => β * ũ i x + α) = F ũ

/-- **Definition 22.D.4** (MWG, p. 834). Invariance to common changes of origin. -/
def InvCommonOrigins (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ α : ℝ, ∀ ũ : UProfile ι X, F (fun i x => ũ i x + α) = F ũ

/-- **Definition 22.D.4** (MWG, p. 834). Invariance to common changes of units. -/
def InvCommonUnits (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ β : ℝ, 0 < β → ∀ ũ : UProfile ι X, F (fun i x => β * ũ i x) = F ũ

/-- **Definition 22.D.5** (MWG, p. 836). `F` does not allow interpersonal comparisons of
utility: it is invariant to independent changes of origins and units. -/
def NoInterpersonalComparisons (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ β α : ι → ℝ, (∀ i, 0 < β i) → ∀ ũ : UProfile ι X, F (fun i x => β i * ũ i x + α i) = F ũ

/-- **Definition 22.D.5** (MWG, p. 836). Invariance to independent changes of origins. -/
def InvIndepOrigins (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ α : ι → ℝ, ∀ ũ : UProfile ι X, F (fun i x => ũ i x + α i) = F ũ

/-- **Definition 22.D.5** (MWG, p. 836). Invariance to independent changes of units. -/
def InvIndepUnits (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ β : ι → ℝ, (∀ i, 0 < β i) → ∀ ũ : UProfile ι X, F (fun i x => β i * ũ i x) = F ũ

/-- **Definition 22.D.4** (MWG, p. 834). Full invariance to common cardinal transformations is
invariance to common changes of origins and of units. -/
theorem invCommonCardinal_iff (F : UProfile ι X → X → X → Prop) :
    InvCommonCardinal F ↔ InvCommonOrigins F ∧ InvCommonUnits F := by
  refine ⟨fun h => ⟨fun α ũ => ?_, fun β hβ ũ => ?_⟩, fun ⟨hO, hU⟩ β α hβ ũ => ?_⟩
  · have := h 1 α one_pos ũ
    simp only [one_mul] at this
    exact this
  · have := h β 0 hβ ũ
    simp only [add_zero] at this
    exact this
  · rw [hO α (fun i x => β * ũ i x), hU β hβ ũ]

/-- **Definition 22.D.5** (MWG, p. 836). No interpersonal comparisons means invariance to
independent changes of origins and of units. -/
theorem noInterpersonalComparisons_iff (F : UProfile ι X → X → X → Prop) :
    NoInterpersonalComparisons F ↔ InvIndepOrigins F ∧ InvIndepUnits F := by
  refine ⟨fun h => ⟨fun α ũ => ?_, fun β hβ ũ => ?_⟩, fun ⟨hO, hU⟩ β α hβ ũ => ?_⟩
  · have := h (fun _ => 1) α (fun _ => one_pos) ũ
    simp only [one_mul] at this
    exact this
  · have := h β 0 hβ ũ
    simp only [Pi.zero_apply, add_zero] at this
    exact this
  · rw [hO α (fun i x => β i * ũ i x), hU β hβ ũ]

/-- The profile obtained by applying `τ : ℝ^I → ℝ^I` to the utility vector of every
alternative. All transformations of Definitions 22.D.4-22.D.5 are of this form. -/
def mapProfile (τ : (ι → ℝ) → (ι → ℝ)) (ũ : UProfile ι X) : UProfile ι X :=
  fun i x => τ (uvec ũ x) i

/-- An invariance of `F` is inherited by every relation generating `F` (with two distinct
alternatives). This is how invariance properties are read "in terms of `≿`" (MWG, pp. 834, 837).
-/
theorem transfer_invariance {F : UProfile ι X → X → X → Prop} {R : (ι → ℝ) → (ι → ℝ) → Prop}
    (hR : GeneratedBy F R) {x y : X} (hxy : x ≠ y) (τ : (ι → ℝ) → (ι → ℝ))
    (hτ : ∀ ũ, F (mapProfile τ ũ) = F ũ) (u u' : ι → ℝ) : R (τ u) (τ u') ↔ R u u' := by
  have ex := profile3_a x y u u' u'
  have ey := profile3_b hxy u u' u'
  have h := hR (mapProfile τ (profile3 x y u u' u')) x y
  rw [hτ, hR, ex, ey] at h
  have e1 : uvec (mapProfile τ (profile3 x y u u' u')) x = τ u := by
    funext i; simp only [uvec, mapProfile] at ex ⊢; rw [ex]
  have e2 : uvec (mapProfile τ (profile3 x y u u' u')) y = τ u' := by
    funext i; simp only [uvec, mapProfile] at ey ⊢; rw [ey]
  rw [e1, e2] at h
  exact h.symm

/-- Conversely, a functional generated by a `τ`-invariant relation is `τ`-invariant. -/
theorem invariance_of_relation {F : UProfile ι X → X → X → Prop}
    {R : (ι → ℝ) → (ι → ℝ) → Prop} (hR : GeneratedBy F R) (τ : (ι → ℝ) → (ι → ℝ))
    (hτ : ∀ u u', R (τ u) (τ u') ↔ R u u') (ũ : UProfile ι X) : F (mapProfile τ ũ) = F ũ := by
  funext x y
  exact propext (by rw [hR, hR]; exact hτ _ _)

/-- **Section 22.D** (MWG, p. 834). If `F` is generated by `W` and invariant to common changes
of origin, the indifference sets of `W` are parallel along `e`:
`W(u) = W(u')` implies `W(u + αe) = W(u' + αe)`. -/
theorem common_origin_parallel {F : UProfile ι X → X → X → Prop} {W : (ι → ℝ) → ℝ}
    (hX : ∃ x y : X, x ≠ y) (hgen : GeneratedBy F (fun u u' => W u' ≤ W u))
    (hO : InvCommonOrigins F) {u u' : ι → ℝ} (h : W u = W u') (α : ℝ) :
    W (fun i => u i + α) = W (fun i => u' i + α) := by
  obtain ⟨x, y, hxy⟩ := hX
  have t := transfer_invariance hgen hxy (fun v i => v i + α) (fun ũ => hO α ũ)
  exact le_antisymm ((t u' u).2 h.le) ((t u u').2 h.ge)

/-- The level `α` with `W(αe) = W(u)` (MWG, p. 835); `0` if there is none. -/
noncomputable def eqLevel (W : (ι → ℝ) → ℝ) (u : ι → ℝ) : ℝ := by
  classical
  exact if h : ∃ α : ℝ, W (fun _ => α) = W u then h.choose else 0

/-- `α ↦ W(αe)` is strictly increasing for an increasing `W` (with at least one agent). -/
theorem diag_strictMono [Nonempty ι] {W : (ι → ℝ) → ℝ} (hW : IsIncreasingSWF W) :
    StrictMono fun α : ℝ => W (fun _ : ι => α) :=
  fun _ _ h => hW.2 _ _ fun _ => h

/-- **Proposition 22.D.2, proof** (MWG, p. 835). For a continuous increasing `W` and every `u`
there is a level `α` with `u ∼ αe`, and `eqLevel W u` is such a level. -/
theorem eqLevel_spec [Finite ι] [Nonempty ι] {W : (ι → ℝ) → ℝ} (hc : Continuous W)
    (hW : IsIncreasingSWF W) (u : ι → ℝ) : W (fun _ => eqLevel W u) = W u := by
  cases nonempty_fintype ι
  have hne : (Finset.univ : Finset ι).Nonempty := Finset.univ_nonempty
  set m := Finset.univ.inf' hne u
  set M := Finset.univ.sup' hne u
  obtain ⟨i₀⟩ := ‹Nonempty ι›
  have hmM : m ≤ M := (Finset.inf'_le u (Finset.mem_univ i₀)).trans
    (Finset.le_sup' u (Finset.mem_univ i₀))
  have hf : Continuous fun α : ℝ => W (fun _ : ι => α) :=
    hc.comp (continuous_pi fun _ => continuous_id)
  have h1 : W (fun _ => m) ≤ W u := hW.1 _ _ fun i => Finset.inf'_le u (Finset.mem_univ i)
  have h2 : W u ≤ W (fun _ => M) := hW.1 _ _ fun i => Finset.le_sup' u (Finset.mem_univ i)
  obtain ⟨α, -, hα⟩ := intermediate_value_Icc hmM hf.continuousOn ⟨h1, h2⟩
  unfold eqLevel
  split_ifs with h
  · exact h.choose_spec
  · exact absurd ⟨α, hα⟩ h

/-- The level is unique. -/
theorem eqLevel_eq [Finite ι] [Nonempty ι] {W : (ι → ℝ) → ℝ} (hc : Continuous W)
    (hW : IsIncreasingSWF W) {u : ι → ℝ} {α : ℝ} (h : W (fun _ => α) = W u) :
    eqLevel W u = α :=
  (diag_strictMono hW).injective ((eqLevel_spec hc hW u).trans h.symm)

/-- **Proposition 22.D.2, proof** (MWG, p. 835). `eqLevel W` is a utility representation of
the social preference. -/
theorem eqLevel_le_iff [Finite ι] [Nonempty ι] {W : (ι → ℝ) → ℝ} (hc : Continuous W)
    (hW : IsIncreasingSWF W) (u u' : ι → ℝ) : W u' ≤ W u ↔ eqLevel W u' ≤ eqLevel W u := by
  rw [← eqLevel_spec hc hW u, ← eqLevel_spec hc hW u']
  exact (diag_strictMono hW).le_iff_le

/-- `eqLevel W (αe) = α`. -/
theorem eqLevel_const [Finite ι] [Nonempty ι] {W : (ι → ℝ) → ℝ} (hc : Continuous W)
    (hW : IsIncreasingSWF W) (α : ℝ) : eqLevel W (fun _ => α) = α :=
  eqLevel_eq hc hW rfl

/-- `eqLevel W` is monotone. -/
theorem eqLevel_mono [Finite ι] [Nonempty ι] {W : (ι → ℝ) → ℝ} (hc : Continuous W)
    (hW : IsIncreasingSWF W) {u u' : ι → ℝ} (h : ∀ i, u i ≤ u' i) :
    eqLevel W u ≤ eqLevel W u' :=
  (eqLevel_le_iff hc hW u' u).1 (hW.1 _ _ h)

/-- **Proposition 22.D.2, proof** (MWG, p. 835). If the social preference is invariant to common
changes of origin, `eqLevel W (u + te) = eqLevel W u + t`. -/
theorem eqLevel_add_const [Finite ι] [Nonempty ι] {W : (ι → ℝ) → ℝ} (hc : Continuous W)
    (hW : IsIncreasingSWF W)
    (htr : ∀ (t : ℝ) (u u' : ι → ℝ), W (fun i => u' i + t) ≤ W (fun i => u i + t) ↔ W u' ≤ W u)
    (u : ι → ℝ) (t : ℝ) : eqLevel W (fun i => u i + t) = eqLevel W u + t := by
  apply eqLevel_eq hc hW
  have h := eqLevel_spec hc hW u
  exact le_antisymm ((htr t u (fun _ => eqLevel W u)).2 h.le)
    ((htr t (fun _ => eqLevel W u) u).2 h.ge)

/-- The mean `ū = (1/I) ∑ᵢ uᵢ`. -/
noncomputable def mean [Fintype ι] (u : ι → ℝ) : ℝ := (∑ i, u i) / Fintype.card ι

/-- The form (22.D.1): `W(u) = ū - g(u₁ - ū, …, u_I - ū)`. -/
noncomputable def form22D1 [Fintype ι] (g : (ι → ℝ) → ℝ) (u : ι → ℝ) : ℝ :=
  mean u - g (fun i => u i - mean u)

/-- **Proposition 22.D.2** (MWG, p. 835). Let `F` be generated by a continuous increasing
social welfare function and invariant to common changes of origin. Then `F` is generated by a
social welfare function of the form (22.D.1), `W(u) = ū - g(u - ūe)`. Moreover, if `F` is also
invariant to common changes of units, `g` is homogeneous of degree one on its domain
`{s : ∑ sᵢ = 0}` (indeed on all of `ℝ^I`). -/
theorem proposition_22_D_2 [Fintype ι] [Nonempty ι] {F : UProfile ι X → X → X → Prop}
    {W : (ι → ℝ) → ℝ} (hX : ∃ x y : X, x ≠ y) (hc : Continuous W) (hW : IsIncreasingSWF W)
    (hgen : GeneratedBy F (fun u u' => W u' ≤ W u)) (hO : InvCommonOrigins F) :
    ∃ g : (ι → ℝ) → ℝ, GeneratedBy F (fun u u' => form22D1 g u' ≤ form22D1 g u) ∧
      (InvCommonUnits F → ∀ s : ι → ℝ, ∑ i, s i = 0 → ∀ β : ℝ, 0 < β →
        g (β • s) = β * g s) := by
  obtain ⟨x, y, hxy⟩ := hX
  have htr : ∀ (t : ℝ) (u u' : ι → ℝ),
      W (fun i => u' i + t) ≤ W (fun i => u i + t) ↔ W u' ≤ W u :=
    fun t u u' => transfer_invariance hgen hxy (fun v i => v i + t) (fun ũ => hO t ũ) u u'
  have hform : ∀ u, form22D1 (fun s => -eqLevel W s) u = eqLevel W u := by
    intro u
    have := eqLevel_add_const hc hW htr (fun i => u i - mean u) (mean u)
    simp only [sub_add_cancel] at this
    simp only [form22D1, this]
    ring
  refine ⟨fun s => -eqLevel W s, fun ũ a b => ?_, fun hU s _ β hβ => ?_⟩
  · rw [hgen]
    change W _ ≤ W _ ↔ form22D1 _ _ ≤ form22D1 _ _
    rw [hform, hform]
    exact eqLevel_le_iff hc hW _ _
  · have hsc : ∀ u u' : ι → ℝ, W (fun i => β * u' i) ≤ W (fun i => β * u i) ↔ W u' ≤ W u :=
      fun u u' => transfer_invariance hgen hxy (fun v i => β * v i) (fun ũ => hU β hβ ũ) u u'
    have key : eqLevel W (β • s) = β * eqLevel W s := by
      apply eqLevel_eq hc hW
      have h := eqLevel_spec hc hW s
      exact le_antisymm ((hsc s (fun _ => eqLevel W s)).2 h.le)
        ((hsc (fun _ => eqLevel W s) s).2 h.ge)
    simp only [key, mul_neg]

/-- **Proposition 22.D.3, proof** (MWG, p. 837). If a complete and transitive relation is
invariant to translations, indifference sets are closed under midpoints: `u ∼ u'` implies
`½u + ½u' ∼ u` (so they are hyperplanes once they are known to be closed). -/
theorem indiff_midpoint {R : (ι → ℝ) → (ι → ℝ) → Prop} (hR : Rational R)
    (htr : ∀ a u u' : ι → ℝ, R (u + a) (u' + a) ↔ R u u') {u u' : ι → ℝ}
    (h : Indifferent R u u') :
    Indifferent R ((1 / 2 : ℝ) • u + (1 / 2 : ℝ) • u') u := by
  set m := (1 / 2 : ℝ) • u + (1 / 2 : ℝ) • u'
  set a := (1 / 2 : ℝ) • (u' - u)
  have hum : u + a = m := by
    simp only [m, a]
    funext i
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    ring
  have hmu : m + a = u' := by
    simp only [m, a, smul_sub]
    funext i
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    ring
  have key : R u m ↔ R m u' := by rw [← htr a u m, hum, hmu]
  have key2 : R m u ↔ R u' m := by rw [← htr a m u, hmu, hum]
  by_cases hsm : R u m
  · exact ⟨hR.2 _ _ _ (key.1 hsm) h.2, hsm⟩
  · exfalso
    have hmu' : R m u := (hR.1 u m).resolve_left hsm
    exact hsm (hR.2 _ _ _ h.1 (key2.1 hmu'))

/-- **Proposition 22.D.3** (MWG, p. 837). If `F` is generated by a continuous increasing social
welfare function and is invariant to independent changes of origins, then `F` is generated by
a purely utilitarian, possibly nonsymmetric, social welfare function `∑ bᵢ uᵢ` with `bᵢ ≥ 0`,
not all zero (in fact `∑ bᵢ = 1`). -/
theorem proposition_22_D_3 [Fintype ι] [Nonempty ι] {F : UProfile ι X → X → X → Prop}
    {W : (ι → ℝ) → ℝ} (hX : ∃ x y : X, x ≠ y) (hc : Continuous W) (hW : IsIncreasingSWF W)
    (hgen : GeneratedBy F (fun u u' => W u' ≤ W u)) (hO : InvIndepOrigins F) :
    ∃ b : ι → ℝ, (∀ i, 0 ≤ b i) ∧ ∑ i, b i = 1 ∧
      GeneratedBy F (fun u u' => ∑ i, b i * u' i ≤ ∑ i, b i * u i) := by
  classical
  obtain ⟨x, y, hxy⟩ := hX
  have htrA : ∀ (a u u' : ι → ℝ),
      W (fun i => u' i + a i) ≤ W (fun i => u i + a i) ↔ W u' ≤ W u :=
    fun a u u' => transfer_invariance hgen hxy (fun v i => v i + a i) (fun ũ => hO a ũ) u u'
  have htr : ∀ (t : ℝ) (u u' : ι → ℝ),
      W (fun i => u' i + t) ≤ W (fun i => u i + t) ↔ W u' ≤ W u :=
    fun t u u' => htrA (fun _ => t) u u'
  -- additivity
  have hadd : ∀ u a : ι → ℝ, eqLevel W (u + a) = eqLevel W u + eqLevel W a := by
    intro u a
    set c := eqLevel W u
    have h : W (fun _ => c) = W u := eqLevel_spec hc hW u
    have e1 : W (fun i => u i + a i) ≤ W (fun i => c + a i) := (htrA a (fun _ => c) u).2 h.ge
    have e2 : W (fun i => c + a i) ≤ W (fun i => u i + a i) := (htrA a u (fun _ => c)).2 h.le
    have h1 : eqLevel W (fun i => u i + a i) = eqLevel W (fun i => c + a i) :=
      le_antisymm ((eqLevel_le_iff hc hW _ _).1 e1) ((eqLevel_le_iff hc hW _ _).1 e2)
    change eqLevel W (fun i => u i + a i) = c + eqLevel W a
    rw [h1, show (fun i => c + a i) = fun i => a i + c from funext fun i => add_comm _ _,
      eqLevel_add_const hc hW htr a c]
    ring
  have hzero : eqLevel W 0 = 0 := eqLevel_const hc hW 0
  have hmono : ∀ u u' : ι → ℝ, (∀ i, u i ≤ u' i) → eqLevel W u ≤ eqLevel W u' :=
    fun u u' h => eqLevel_mono hc hW h
  -- 1-Lipschitz, hence continuous
  have hlip : ∀ u u' : ι → ℝ, eqLevel W u ≤ eqLevel W u' + dist u u' := by
    intro u u'
    have := hmono u (fun i => u' i + dist u u') fun i => by
      have := dist_le_pi_dist u u' i
      rw [Real.dist_eq] at this
      linarith [le_abs_self (u i - u' i)]
    rwa [eqLevel_add_const hc hW htr] at this
  have hcont : Continuous (eqLevel W) := by
    refine (LipschitzWith.of_dist_le_mul fun u u' => ?_).continuous (K := 1)
    rw [Real.dist_eq, NNReal.coe_one, one_mul, abs_le]
    constructor
    · linarith [hlip u' u, dist_comm u u']
    · linarith [hlip u u']
  set L := eqLevel W
  let Lh : (ι → ℝ) →+ ℝ := ⟨⟨L, hzero⟩, hadd⟩
  let Ll := (Lh.toRealLinearMap hcont).toLinearMap
  set b' : ι → ℝ := fun i => L (fun j => if i = j then 1 else 0) with hb'
  have hlin : ∀ u, L u = ∑ i, b' i * u i := by
    intro u
    have := LinearMap.pi_apply_eq_sum_univ Ll u
    simp only [smul_eq_mul] at this
    rw [show Ll u = L u from rfl] at this
    rw [this]
    exact Finset.sum_congr rfl fun i _ => by rw [mul_comm]; rfl
  refine ⟨b', fun i => ?_, ?_, fun ũ a c => ?_⟩
  · have := hmono 0 (fun j => if i = j then 1 else 0) fun j => by
      simp only [Pi.zero_apply]
      split_ifs <;> norm_num
    rwa [hzero] at this
  · have := hlin (fun _ => 1)
    rw [show L (fun _ => 1) = 1 from eqLevel_const hc hW 1] at this
    simp only [mul_one] at this
    exact this.symm
  · rw [hgen]
    change W _ ≤ W _ ↔ _
    rw [eqLevel_le_iff hc hW]
    have h1 := hlin (uvec ũ a)
    have h2 := hlin (uvec ũ c)
    simp only [L] at h1 h2
    rw [h1, h2]

/-- `x ≻ y ≿ z` implies `x ≻ z` for a transitive relation. -/
theorem strict_of_strict_weak {Y : Type*} {r : Y → Y → Prop} (hr : TransitivePref r) {x y z : Y}
    (hxy : Strict r x y) (hyz : r y z) : Strict r x z :=
  ⟨hr x y z hxy.1 hyz, fun hzx => hxy.2 (hr y z x hyz hzx)⟩

/-- The sign pattern `(+1 on S, −1 off S)`. -/
noncomputable def signVec (S : Finset ι) : ι → ℝ := by
  classical
  exact fun i => if i ∈ S then 1 else -1

/-- Two vectors have the same sign pattern. -/
def SameSigns (d d' : ι → ℝ) : Prop := ∀ i, (0 < d i ↔ 0 < d' i) ∧ (d i < 0 ↔ d' i < 0)

/-- A relation invariant to independent changes of units compares `d` with `0` only through
the sign pattern of `d`. -/
theorem rel_zero_iff_of_sameSigns {R : (ι → ℝ) → (ι → ℝ) → Prop}
    (hsc : ∀ b : ι → ℝ, (∀ i, 0 < b i) → ∀ u u', R (b * u) (b * u') ↔ R u u')
    {d d' : ι → ℝ} (h : SameSigns d d') : (R d 0 ↔ R d' 0) ∧ (R 0 d ↔ R 0 d') := by
  classical
  set b : ι → ℝ := fun i => if d i = 0 then 1 else d' i / d i
  have hb : ∀ i, 0 < b i := by
    intro i
    simp only [b]
    split_ifs with h0
    · exact one_pos
    · rcases lt_or_gt_of_ne h0 with hn | hp
      · exact div_pos_of_neg_of_neg ((h i).2.1 hn) hn
      · exact div_pos ((h i).1.1 hp) hp
  have hbd : b * d = d' := by
    funext i
    simp only [Pi.mul_apply, b]
    split_ifs with h0
    · rw [h0]
      have h1 := (h i).1
      have h2 := (h i).2
      rw [h0] at h1 h2
      simp only [lt_irrefl, false_iff, not_lt] at h1 h2
      linarith
    · field_simp
  have hb0 : b * 0 = 0 := by simp
  constructor
  · rw [← hsc b hb d 0, hbd, hb0]
  · rw [← hsc b hb 0 d, hbd, hb0]

/-- **Proposition 22.D.3, extended** (MWG, p. 837). A rational relation `≿` on `ℝ^I` (finitely
many agents) that is monotone (weakly and strictly) and invariant to independent changes of
origins and of units is dictatorial: some agent's strict preference always prevails. -/
theorem dictator_of_invariant_relation [Finite ι] {R : (ι → ℝ) → (ι → ℝ) → Prop}
    (hR : Rational R) (htr : ∀ a u u' : ι → ℝ, R (u + a) (u' + a) ↔ R u u')
    (hsc : ∀ b : ι → ℝ, (∀ i, 0 < b i) → ∀ u u', R (b * u) (b * u') ↔ R u u')
    (hmono : ∀ u u' : ι → ℝ, (∀ i, u' i ≤ u i) → R u u')
    (hsmono : ∀ u u' : ι → ℝ, (∀ i, u' i < u i) → Strict R u u') :
    ∃ h : ι, ∀ u u' : ι → ℝ, u' h < u h → Strict R u u' := by
  cases nonempty_fintype ι
  classical
  -- sums of (strictly) preferred-to-zero vectors
  have hsum : ∀ d d' : ι → ℝ, R d 0 → R d' 0 → R (d + d') 0 := by
    intro d d' h1 h2
    have : R (d + d') (0 + d') := (htr d' d 0).2 h1
    rw [zero_add] at this
    exact hR.2 _ _ _ this h2
  have hssum : ∀ d d' : ι → ℝ, Strict R d 0 → R d' 0 → Strict R (d + d') 0 := by
    intro d d' h1 h2
    have : Strict R (d + d') (0 + d') := ⟨(htr d' d 0).2 h1.1, fun h => h1.2 ((htr d' 0 d).1 h)⟩
    rw [zero_add] at this
    exact strict_of_strict_weak hR.2 this h2
  have hneg : ∀ d : ι → ℝ, R 0 d ↔ R (-d) 0 := by
    intro d
    rw [← htr (-d) 0 d, zero_add, add_neg_cancel]
  have hneg_e : Strict R 0 (fun _ => -1) := hsmono _ _ fun _ => by norm_num
  have hsig : ∀ (S : Finset ι) (d : ι → ℝ), (∀ i, i ∈ S → 0 < d i) → (∀ i, i ∉ S → d i < 0) →
      SameSigns (signVec S) d := by
    intro S d h1 h2 i
    simp only [signVec]
    split_ifs with hi
    · have := h1 i hi
      exact ⟨⟨fun _ => this, fun _ => by norm_num⟩, ⟨fun h => by norm_num at h,
        fun h => by linarith⟩⟩
    · have := h2 i hi
      exact ⟨⟨fun h => by norm_num at h, fun h => by linarith⟩, ⟨fun _ => this,
        fun _ => by norm_num⟩⟩
  let Win : Finset ι → Prop := fun S => Strict R (signVec S) 0
  -- the transfer to an arbitrary vector of the same pattern
  have hwin : ∀ (S : Finset ι) (d : ι → ℝ), (∀ i, i ∈ S → 0 < d i) → (∀ i, i ∉ S → d i < 0) →
      (Win S ↔ Strict R d 0) := by
    intro S d h1 h2
    have := rel_zero_iff_of_sameSigns hsc (hsig S d h1 h2)
    simp only [Win, Strict]
    rw [this.1, this.2]
  have hcompl : ∀ S : Finset ι, -signVec S = signVec Sᶜ := by
    intro S
    funext i
    simp only [signVec, Pi.neg_apply, Finset.mem_compl]
    split_ifs <;> norm_num
  -- `v_S ∼ 0` is impossible
  have hnot_both : ∀ S : Finset ι, ¬(R (signVec S) 0 ∧ R (signVec Sᶜ) 0) := by
    rintro S ⟨h1, h2⟩
    set d1 : ι → ℝ := fun i => if i ∈ S then 1 else -2
    set d2 : ι → ℝ := fun i => if i ∈ S then -2 else 1
    have e1 : R d1 0 := by
      have := rel_zero_iff_of_sameSigns hsc (hsig S d1 (fun i hi => by simp [d1, hi])
        (fun i hi => by simp [d1, hi]))
      exact this.1.1 h1
    have e2 : R d2 0 := by
      have := rel_zero_iff_of_sameSigns hsc (hsig Sᶜ d2
        (fun i hi => by simp only [Finset.mem_compl] at hi; simp [d2, hi])
        (fun i hi => by simp only [Finset.mem_compl, not_not] at hi; simp [d2, hi]))
      exact this.1.1 h2
    have := hsum d1 d2 e1 e2
    have hsum_eq : d1 + d2 = fun _ => -1 := by
      funext i
      simp only [Pi.add_apply, d1, d2]
      split_ifs <;> norm_num
    rw [hsum_eq] at this
    exact hneg_e.2 this
  have hdich : ∀ S : Finset ι, Win S ∨ Win Sᶜ := by
    intro S
    rcases hR.1 (signVec S) 0 with h | h
    · left
      refine ⟨h, fun h' => hnot_both S ⟨h, ?_⟩⟩
      rw [hneg, hcompl] at h'
      exact h'
    · right
      rw [hneg, hcompl] at h
      refine ⟨h, fun h' => hnot_both S ⟨?_, h⟩⟩
      rw [hneg, hcompl, compl_compl] at h'
      exact h'
  have hempty : ¬Win ∅ := by
    intro h
    have e : signVec (∅ : Finset ι) = fun _ => -1 := by
      funext i; simp [signVec]
    rw [show Win ∅ = Strict R (signVec ∅) 0 from rfl, e] at h
    exact hneg_e.2 h.1
  have huniv : Win Finset.univ := by
    have e : signVec (Finset.univ : Finset ι) = fun _ => 1 := by
      funext i; simp [signVec]
    change Strict R (signVec Finset.univ) 0
    rw [e]
    exact hsmono _ _ fun _ => by norm_num
  have hinter : ∀ S T : Finset ι, Win S → Win T → Win (S ∩ T) := by
    intro S T hS hT
    set d1 : ι → ℝ := fun i => if i ∈ S then 1 else -3
    set d2 : ι → ℝ := fun i => if i ∈ T then 1 else -3
    have e1 : Strict R d1 0 :=
      (hwin S d1 (fun i hi => by simp [d1, hi]) (fun i hi => by simp [d1, hi])).1 hS
    have e2 : Strict R d2 0 :=
      (hwin T d2 (fun i hi => by simp [d2, hi]) (fun i hi => by simp [d2, hi])).1 hT
    have := hssum d1 d2 e1 e2.1
    refine (hwin (S ∩ T) (d1 + d2) (fun i hi => ?_) (fun i hi => ?_)).2 this
    · simp only [Finset.mem_inter] at hi
      simp [d1, d2, hi.1, hi.2]
    · simp only [Finset.mem_inter, not_and_or] at hi
      simp only [Pi.add_apply, d1, d2]
      rcases hi with h | h <;> split_ifs <;> norm_num
  -- a winning coalition of minimal size is a singleton
  obtain ⟨S, hSmem, hSmin⟩ := Finset.exists_min_image
    (Finset.univ.filter fun S : Finset ι => Win S) Finset.card ⟨Finset.univ, by simp [huniv]⟩
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hSmem hSmin
  obtain ⟨h, hh⟩ : S.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    rintro rfl
    exact hempty hSmem
  have hsing : Win {h} := by
    rcases hdich {h} with h1 | h1
    · exact h1
    · have hw := hinter S _ hSmem h1
      have hsub : S ∩ ({h} : Finset ι)ᶜ = S.erase h := by
        ext j; simp [Finset.mem_erase, and_comm]
      rw [hsub] at hw
      have := hSmin _ hw
      have := Finset.card_erase_lt_of_mem hh
      omega
  refine ⟨h, fun u u' huu => ?_⟩
  set d : ι → ℝ := u - u'
  set d'' : ι → ℝ := fun i => if i = h then d h else min (d i) (-1)
  have hd'' : Strict R d'' 0 := by
    refine (hwin {h} d'' (fun i hi => ?_) (fun i hi => ?_)).1 hsing
    · simp only [Finset.mem_singleton] at hi
      subst hi
      simp only [d'', ↓reduceIte, d, Pi.sub_apply]
      linarith
    · simp only [Finset.mem_singleton] at hi
      simp only [d'', hi, ↓reduceIte]
      exact lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have hdd : R d d'' := hmono _ _ fun i => by
    simp only [d'']
    split_ifs with hi
    · rw [hi]
    · exact min_le_left _ _
  have hd : Strict R d 0 := MWG.SocialChoice.strict_of_weak_strict hR hdd hd''
  have e : d + u' = u := by simp [d]
  have h1 := htr u' d 0
  have h2 := htr u' 0 d
  rw [e, zero_add] at h1 h2
  exact ⟨h1.2 hd.1, fun h' => hd.2 (h2.1 h')⟩

/-- Strict social preference read through a generating relation. -/
theorem strict_iff_of_generatedBy {F : UProfile ι X → X → X → Prop}
    {R : (ι → ℝ) → (ι → ℝ) → Prop} (hgen : GeneratedBy F R) (ũ : UProfile ι X) (x y : X) :
    Strict (F ũ) x y ↔ Strict R (uvec ũ x) (uvec ũ y) := by
  simp only [Strict]
  rw [hgen, hgen]

/-- **Proposition 22.D.3, extended** (MWG, p. 837). A Paretian social welfare functional that
is generated by a rational social preference relation on `ℝ^I` and is invariant to independent
changes of origins and of units (i.e., allows no interpersonal comparisons) is dictatorial:
there is an agent `h` with `ũₕ(x) > ũₕ(y) ⇒ x Fₚ(ũ) y`. -/
theorem proposition_22_D_3_relation [Finite ι] {F : UProfile ι X → X → X → Prop}
    {R : (ι → ℝ) → (ι → ℝ) → Prop} (hX : ∃ x y : X, x ≠ y) (hP : UParetian F)
    (hR : Rational R) (hgen : GeneratedBy F R) (hO : InvIndepOrigins F)
    (hU : InvIndepUnits F) :
    ∃ h : ι, ∀ (ũ : UProfile ι X) (x y : X), ũ h y < ũ h x → Strict (F ũ) x y := by
  obtain ⟨x, y, hxy⟩ := hX
  obtain ⟨h, hh⟩ := dictator_of_invariant_relation hR
    (fun a u u' => transfer_invariance hgen hxy (fun v i => v i + a i) (fun ũ => hO a ũ) u u')
    (fun b hb u u' => transfer_invariance hgen hxy (fun v i => b i * v i)
      (fun ũ => hU b hb ũ) u u')
    (fun u u' hle => (exercise_22_D_3 ⟨x, y, hxy⟩ hP hgen (u := u') (u' := u)).1 hle)
    (fun u u' hlt => (exercise_22_D_3 ⟨x, y, hxy⟩ hP hgen (u := u') (u' := u)).2 hlt)
  exact ⟨h, fun ũ a b hab => (strict_iff_of_generatedBy hgen ũ a b).2 (hh _ _ hab)⟩

/-- **Proposition 22.D.3, second part** (MWG, p. 837). If `F` is generated by an increasing
continuous social welfare function and does not allow interpersonal comparisons of utility,
then `F` is dictatorial. -/
theorem proposition_22_D_3_dictatorial [Finite ι] {F : UProfile ι X → X → X → Prop}
    {W : (ι → ℝ) → ℝ} (hX : ∃ x y : X, x ≠ y) (hW : IsIncreasingSWF W)
    (hgen : GeneratedBy F (fun u u' => W u' ≤ W u)) (hN : NoInterpersonalComparisons F) :
    ∃ h : ι, ∀ (ũ : UProfile ι X) (x y : X), ũ h y < ũ h x → Strict (F ũ) x y := by
  obtain ⟨hO, hU⟩ := (noInterpersonalComparisons_iff F).1 hN
  have hP : UParetian F := fun ũ x y => ⟨fun h => (hgen ũ x y).2 (hW.1 _ _ h),
    fun h => (strict_iff_of_generatedBy hgen ũ x y).2
      ⟨(hW.2 _ _ h).le, fun h' => absurd (hW.2 _ _ h) (not_lt.2 h')⟩⟩
  exact proposition_22_D_3_relation (R := fun u u' => W u' ≤ W u) hX hP
    ⟨fun u u' => le_total (W u') (W u), fun _ _ _ h1 h2 => h2.trans h1⟩ hgen hO hU

/-- **Exercise 22.D.4(c)** (MWG, pp. 837, 852). If a dictatorial social welfare functional (with
dictator `h`) is generated by `W(u) = ∑ bᵢ uᵢ` with `b ≥ 0`, then `bᵢ = 0` for every `i ≠ h`. -/
theorem exercise_22_D_4c [Fintype ι] {F : UProfile ι X → X → X → Prop} {b : ι → ℝ}
    (hX : ∃ x y : X, x ≠ y) (hb : ∀ i, 0 ≤ b i)
    (hgen : GeneratedBy F (fun u u' => ∑ i, b i * u' i ≤ ∑ i, b i * u i)) {h : ι}
    (hdict : ∀ (ũ : UProfile ι X) (x y : X), ũ h y < ũ h x → Strict (F ũ) x y) :
    ∀ k, k ≠ h → b k = 0 := by
  classical
  obtain ⟨x, y, hxy⟩ := hX
  intro k hk
  by_contra hne
  have hpos : 0 < b k := lt_of_le_of_ne (hb k) (Ne.symm hne)
  set M := (b h + 1) / b k
  set u : ι → ℝ := fun i => (if i = h then 1 else 0) + (if i = k then -M else 0)
  have hu : u h = 1 := by simp [u, Ne.symm hk]
  set ũ := profile3 x y u 0 0
  have ex := profile3_a x y u 0 0
  have ey := profile3_b hxy u 0 0
  have hst := (strict_iff_of_generatedBy hgen ũ x y).1 (hdict ũ x y (by
    change uvec ũ y h < uvec ũ x h
    rw [ex, ey, hu]; norm_num))
  rw [ex, ey] at hst
  have hsum : ∑ i, b i * u i = b h - M * b k := by
    simp only [u, mul_add, Finset.sum_add_distrib, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    ring
  have hM : M * b k = b h + 1 := by simp only [M]; field_simp
  apply hst.2
  simp only [Pi.zero_apply, mul_zero, Finset.sum_const_zero]
  linarith

end MWG.WelfareBargaining

