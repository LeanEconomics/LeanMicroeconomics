/-!
# Invariance to common ordinal transformations, and a separable example

MWG, Section 22.D, small type (p. 838), and Exercise 22.D.8(a)-(c), (d) first part (p. 853).

A functional is invariant to common ordinal transformations if applying the same strictly
increasing `γ` to every agent's utility function leaves it unchanged. The symmetric Rawlsian
`min`, the anti-Rawlsian `max` and dictatorial functionals have this property; an increasing
`W` with `W(u) = W(u')` for `u'₁ < u₁ < u₂ < u'₂` does not.

**Correction (p. 838).** "Under weak conditions the only social welfare functions that admit an
additively separable form and are invariant to common changes of origin are the utilitarian"
is false without further conditions: the Kolm-Pollak function `W(u) = -∑ e^{-uᵢ}` is continuous,
increasing, symmetric, concave, additively separable and invariant to common changes of origin,
yet the functional it generates is not generated by any utilitarian `∑ bᵢuᵢ`
(`kolmPollak_not_utilitarian`).
-/

namespace MWG.WelfareBargaining

variable {ι X : Type*}

/-- **Section 22.D, small type** (MWG, p. 838). Invariance to common ordinal transformations. -/
def InvCommonOrdinal (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ γ : ℝ → ℝ, StrictMono γ → ∀ ũ : UProfile ι X, F (fun i x => γ (ũ i x)) = F ũ

/-- **Exercise 22.D.8(a)-(b)** (MWG, p. 853). The symmetric Rawlsian `min` and the
anti-Rawlsian `max` generate functionals invariant to common ordinal transformations. -/
theorem exercise_22_D_8ab [Fintype ι] [Nonempty ι] :
    InvCommonOrdinal (swfFunctional (X := X)
      fun u : ι → ℝ => Finset.univ.inf' Finset.univ_nonempty u) ∧
    InvCommonOrdinal (swfFunctional (X := X)
      fun u : ι → ℝ => Finset.univ.sup' Finset.univ_nonempty u) := by
  constructor
  · intro γ hγ ũ
    refine invariance_of_relation (swfFunctional_generatedBy _) (fun v i => γ (v i))
      (fun u u' => ?_) ũ
    change Finset.univ.inf' _ (γ ∘ u') ≤ Finset.univ.inf' _ (γ ∘ u) ↔ _
    rw [← Finset.apply_inf'_eq_inf'_comp _ _ (fun a b => hγ.monotone.map_min),
      ← Finset.apply_inf'_eq_inf'_comp _ _ (fun a b => hγ.monotone.map_min)]
    exact hγ.le_iff_le
  · intro γ hγ ũ
    refine invariance_of_relation (swfFunctional_generatedBy _) (fun v i => γ (v i))
      (fun u u' => ?_) ũ
    change Finset.univ.sup' _ (γ ∘ u') ≤ Finset.univ.sup' _ (γ ∘ u) ↔ _
    rw [← Finset.apply_sup'_eq_sup'_comp _ _ (fun a b => hγ.monotone.map_max),
      ← Finset.apply_sup'_eq_sup'_comp _ _ (fun a b => hγ.monotone.map_max)]
    exact hγ.le_iff_le

/-- **Exercise 22.D.8(c)** (MWG, p. 853). Dictatorial functionals (`W(u) = uₕ`) are invariant to
common ordinal transformations. -/
theorem exercise_22_D_8c (h : ι) :
    InvCommonOrdinal (swfFunctional (X := X) fun u : ι → ℝ => u h) := by
  intro γ hγ ũ
  exact invariance_of_relation (swfFunctional_generatedBy _) (fun v i => γ (v i))
    (fun u u' => hγ.le_iff_le) ũ

/-- **Exercise 22.D.8(d)** (MWG, p. 853), first part. If `I = 2`, `W` is increasing and
`W(u) = W(u')` with `u'₁ < u₁ < u₂ < u'₂`, the functional generated by `W` is not invariant to
common ordinal transformations: the transformation fixing `u₁, u₂` and lowering `u'₁, u'₂`
strictly lowers `W(u')` below `W(u)`. -/
theorem exercise_22_D_8d (hX : ∃ x y : X, x ≠ y) {W : (Fin 2 → ℝ) → ℝ}
    (hW : IsIncreasingSWF W) {u u' : Fin 2 → ℝ} (heq : W u = W u')
    (h1 : u' 0 < u 0) (h2 : u 0 < u 1) (h3 : u 1 < u' 1) :
    ¬InvCommonOrdinal (swfFunctional (X := X) W) := by
  intro hinv
  obtain ⟨x, y, hxy⟩ := hX
  -- `γ` is the identity on `[u₀, u₁]`, has slope `2` below and slope `1/2` above
  set γ : ℝ → ℝ := fun t => if t < u 0 then u 0 + 2 * (t - u 0)
    else if t ≤ u 1 then t else u 1 + (t - u 1) / 2
  have hγ : StrictMono γ := by
    intro a b hab
    simp only [γ]
    split_ifs <;> linarith
  have hfix : (fun i => γ (u i)) = u := by
    funext i
    fin_cases i
    · simp [γ, h2.le]
    · simp [γ, not_lt.2 h2.le]
  have hlow : ∀ i, γ (u' i) < u' i := by
    intro i
    fin_cases i
    · simp only [γ, Fin.zero_eta, h1, ↓reduceIte]; linarith
    · simp only [γ, Fin.mk_one, not_lt.2 (h2.trans h3).le, ↓reduceIte,
        not_le.2 h3]; linarith
  have t := transfer_invariance (swfFunctional_generatedBy W) hxy (fun v i => γ (v i))
    (fun ũ => hinv γ hγ ũ) u' u
  simp only [hfix] at t
  have : W (fun i => γ (u' i)) < W u' := hW.2 _ _ hlow
  have := t.2 heq.le
  linarith

/-- **Correction, p. 838.** The Kolm-Pollak social welfare function `-∑ e^{-uᵢ}` generates a
functional invariant to common changes of origin. -/
theorem kolmPollak_invCommonOrigins [Fintype ι] :
    InvCommonOrigins (swfFunctional (X := X)
      fun u : ι → ℝ => -∑ i, Real.exp (-u i)) := by
  intro α ũ
  refine invariance_of_relation (swfFunctional_generatedBy _) (fun v i => v i + α)
    (fun u u' => ?_) ũ
  have e : ∀ v : ι → ℝ, ∑ i, Real.exp (-(v i + α)) = Real.exp (-α) * ∑ i, Real.exp (-v i) := by
    intro v; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by
      rw [← Real.exp_add]; ring_nf
  simp only [e, neg_le_neg_iff]
  exact mul_le_mul_iff_of_pos_left (Real.exp_pos _)

/-- **Correction, p. 838.** The Kolm-Pollak functional (two agents) is not generated by any
utilitarian social welfare function `∑ bᵢuᵢ`: it ranks `(0, 0)` strictly above `(1, -1)`
and `(1, -1)` and `(-1, 1)` as indifferent, which no linear function does. -/
theorem kolmPollak_not_utilitarian (hX : ∃ x y : X, x ≠ y) :
    ¬∃ b : Fin 2 → ℝ, GeneratedBy (swfFunctional (X := X)
      fun u : Fin 2 → ℝ => -∑ i, Real.exp (-u i))
      (fun u u' => ∑ i, b i * u' i ≤ ∑ i, b i * u i) := by
  rintro ⟨b, hb⟩
  obtain ⟨x, y, hxy⟩ := hX
  have rel : ∀ u u' : Fin 2 → ℝ, (-∑ i, Real.exp (-u' i) ≤ -∑ i, Real.exp (-u i)) ↔
      ∑ i, b i * u' i ≤ ∑ i, b i * u i := by
    intro u u'
    have := hb (profile3 x y u u' u') x y
    simp only [swfFunctional] at this
    rw [profile3_a, profile3_b hxy] at this
    exact this
  have hsum : Real.exp (-1) + Real.exp 1 > 2 := by
    have := Real.add_one_lt_exp (show (1 : ℝ) ≠ 0 by norm_num)
    have := Real.add_one_lt_exp (show (-1 : ℝ) ≠ 0 by norm_num)
    linarith
  have h1 := (rel ![1, -1] ![-1, 1]).1 (by simp [Fin.sum_univ_two])
  have h2 := (rel ![-1, 1] ![1, -1]).1 (by simp [Fin.sum_univ_two])
  have h3 := (rel ![1, -1] 0).2 (by
    simp only [Fin.sum_univ_two] at h1 h2 ⊢; simp at h1 h2 ⊢; linarith)
  simp [Fin.sum_univ_two] at h3
  linarith

end MWG.WelfareBargaining

