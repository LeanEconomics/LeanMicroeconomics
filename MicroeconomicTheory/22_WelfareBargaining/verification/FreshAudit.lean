/-!
# The constant elasticity family and marginal-utility equalization

MWG, Example 22.C.4 (p. 829), Exercise 22.C.5 (p. 851), Exercise 22.D.7 (p. 853) and the
equalization of marginal utilities in Example 22.C.1 (p. 827).

For `ρ ≥ 0` the book sets `g_ρ(uᵢ) = (1 - ρ)uᵢ^{1-ρ}` (`ρ ≠ 1`), `g₁ = ln` and
`W_ρ(u) = (∑ uᵢ^{1-ρ})^{1/(1-ρ)}` (`ρ ≠ 1`), `W₁ = ∑ ln uᵢ` (`cesG`, `cesW`).

* `example_22_C_4_elasticity`: `uᵢ g_ρ''(uᵢ)/g_ρ'(uᵢ) = -ρ`, `g_ρ' > 0`.
* `example_22_C_4_represent`: `∑ g_ρ(uᵢ)` and `W_ρ` represent the same ordering on `u ≫ 0`;
  `W_ρ = h(∑ g_ρ)` with `h(W) = (W/(1-ρ))^{1/(1-ρ)}`.
* **Correction (p. 829).** The printed `h(W) = [1/(1-ρ)]W^{1/(1-ρ)}` is not an increasing
  transformation for `ρ > 1`: then `W = ∑ g_ρ < 0`, and for `ρ = 3/2` the printed `h` is
  `-2W^{-2}`, which reverses the ranking of `(1, 1)` and `(4, 4)`
  (`example_22_C_4_printed_h`). The utilities must be positive for `ρ ≥ 1`
  (`ln 0`, `0^{1-ρ}` are not defined), not just nonnegative.
* `exercise_22_C_5`: `W_ρ(u) → min uᵢ` as `ρ → ∞`; `cesW_zero`: `W₀ = ∑ uᵢ`.
* `exercise_22_D_7a`: the functional generated by `∑ g_ρ` is invariant to common changes of
  units (on profiles of positive utilities, its domain); `exercise_22_D_7b`: for `0 < ρ < ∞` it
  is not invariant to common changes of origin, while `ρ = 0` (utilitarian) and `ρ = ∞`
  (Rawlsian) are (`exercise_22_D_7b_utilitarian`, `exercise_22_D_7b_rawls`).
* `example_22_C_1_marginal`: an interior utilitarian division of wealth equalizes marginal
  utilities; `example_22_C_1_unique`: with strictly concave utilities it is unique.
-/

namespace MWG.WelfareBargaining


variable {ι X : Type*}

/-- **Example 22.C.4** (MWG, p. 829). `g_ρ(t) = (1 - ρ)t^{1-ρ}` for `ρ ≠ 1`, `g₁ = ln`. -/
noncomputable def cesG (ρ t : ℝ) : ℝ := if ρ = 1 then Real.log t else (1 - ρ) * t ^ (1 - ρ)

/-- **Example 22.C.4** (MWG, p. 829). `W_ρ(u) = (∑ uᵢ^{1-ρ})^{1/(1-ρ)}` for `ρ ≠ 1`,
`W₁(u) = ∑ ln uᵢ`. -/
noncomputable def cesW [Fintype ι] (ρ : ℝ) (u : ι → ℝ) : ℝ :=
  if ρ = 1 then ∑ i, Real.log (u i) else (∑ i, u i ^ (1 - ρ)) ^ (1 / (1 - ρ))

/-- **Example 22.C.4** (MWG, p. 829). The marginal utility `g_ρ'(t) = (1 - ρ)²t^{-ρ}` for
`ρ ≠ 1` (`1/t` for `ρ = 1`) is positive, and its elasticity is constant:
`t g_ρ''(t)/g_ρ'(t) = -ρ` for `t > 0`. -/
theorem example_22_C_4_elasticity {ρ t : ℝ} (ht : 0 < t) :
    ∃ g₁ g₂ : ℝ, HasDerivAt (cesG ρ) g₁ t ∧
      (∃ G : ℝ → ℝ, (∀ s, 0 < s → HasDerivAt (cesG ρ) (G s) s) ∧ HasDerivAt G g₂ t) ∧
      0 < g₁ ∧ t * g₂ / g₁ = -ρ := by
  by_cases hρ : ρ = 1
  · subst hρ
    have hG : ∀ s, 0 < s → HasDerivAt (cesG 1) s⁻¹ s := fun s hs => by
      have : cesG 1 = Real.log := funext fun s => by simp [cesG]
      rw [this]; exact Real.hasDerivAt_log hs.ne'
    refine ⟨t⁻¹, -(t ^ 2)⁻¹, hG t ht, ⟨fun s => s⁻¹, hG, ?_⟩, inv_pos.2 ht, ?_⟩
    · simpa using hasDerivAt_inv ht.ne'
    · field_simp
  · have hp : (1 - ρ) ≠ 0 := sub_ne_zero.2 (Ne.symm hρ)
    have hG : ∀ s, 0 < s → HasDerivAt (cesG ρ) ((1 - ρ) ^ 2 * s ^ (-ρ)) s := fun s hs => by
      have : cesG ρ = fun s => (1 - ρ) * s ^ (1 - ρ) := funext fun s => by simp [cesG, hρ]
      rw [this]
      have := (Real.hasDerivAt_rpow_const (p := 1 - ρ) (Or.inl hs.ne')).const_mul (1 - ρ)
      convert this using 1
      rw [show 1 - ρ - 1 = -ρ by ring]; ring
    have hG' : HasDerivAt (fun s => (1 - ρ) ^ 2 * s ^ (-ρ))
        ((1 - ρ) ^ 2 * (-ρ * t ^ (-ρ - 1))) t :=
      (Real.hasDerivAt_rpow_const (p := -ρ) (Or.inl ht.ne')).const_mul _
    refine ⟨_, _, hG t ht, ⟨_, hG, hG'⟩, by positivity, ?_⟩
    have e : t * t ^ (-ρ - 1) = t ^ (-ρ) := by
      rw [Real.rpow_sub ht, Real.rpow_one]; field_simp
    have hpos : 0 < t ^ (-ρ) := Real.rpow_pos_of_pos ht _
    have hp2 : 0 < (1 - ρ) ^ 2 := by positivity
    rw [show t * ((1 - ρ) ^ 2 * (-ρ * t ^ (-ρ - 1))) = -ρ * ((1 - ρ) ^ 2 * (t * t ^ (-ρ - 1)))
      by ring, e]
    field_simp

/-- **Example 22.C.4** (MWG, p. 829). For `ρ ≠ 1` and `u ≫ 0`, `W_ρ = h(∑ g_ρ(uᵢ))` with the
increasing transformation `h(W) = (W/(1-ρ))^{1/(1-ρ)}` (the corrected `h`). -/
theorem example_22_C_4_h [Fintype ι] {ρ : ℝ} (hρ : ρ ≠ 1) (u : ι → ℝ) :
    cesW ρ u = ((∑ i, cesG ρ (u i)) / (1 - ρ)) ^ (1 / (1 - ρ)) := by
  have hp : (1 - ρ) ≠ 0 := sub_ne_zero.2 (Ne.symm hρ)
  simp only [cesW, cesG, hρ, ↓reduceIte, ← Finset.mul_sum]
  rw [mul_div_cancel_left₀ _ hp]

/-- **Example 22.C.4** (MWG, p. 829). For `ρ ≠ 1`, the generalized utilitarian `∑ g_ρ(uᵢ)` and
the CES function `W_ρ` represent the same ordering on positive utility vectors. -/
theorem example_22_C_4_represent [Fintype ι] [Nonempty ι] {ρ : ℝ} {u u' : ι → ℝ}
    (hu : ∀ i, 0 < u i) (hu' : ∀ i, 0 < u' i) :
    ∑ i, cesG ρ (u i) ≤ ∑ i, cesG ρ (u' i) ↔ cesW ρ u ≤ cesW ρ u' := by
  by_cases hρ : ρ = 1
  · simp [cesG, cesW, hρ]
  have hS : ∀ v : ι → ℝ, (∀ i, 0 < v i) → 0 < ∑ i, v i ^ (1 - ρ) := fun v hv =>
    Finset.sum_pos (fun i _ => Real.rpow_pos_of_pos (hv i) _) Finset.univ_nonempty
  simp only [cesG, cesW, hρ, ↓reduceIte, ← Finset.mul_sum]
  rcases lt_or_gt_of_ne hρ with h | h
  · have hp : 0 < 1 - ρ := by linarith
    rw [mul_le_mul_iff_of_pos_left hp, Real.rpow_le_rpow_iff (hS u hu).le (hS u' hu').le
      (by positivity)]
  · have hp : 1 - ρ < 0 := by linarith
    rw [mul_le_mul_left_of_neg hp, Real.rpow_le_rpow_iff_of_neg (hS u hu) (hS u' hu')
      (by rw [one_div]; exact inv_lt_zero.2 hp)]

/-- **Correction, Example 22.C.4** (MWG, p. 829). The printed transformation
`h(W) = [1/(1-ρ)]W^{1/(1-ρ)}` is not increasing for `ρ > 1`: for `ρ = 3/2`, `∑ g_ρ` is `-1` at
`(1, 1)` and `-1/2` at `(4, 4)`, but the printed `h` gives `-2 > -8`, reversing the ranking of
`(4, 4) ≫ (1, 1)`. -/
theorem example_22_C_4_printed_h :
    ∑ i : Fin 2, cesG (3 / 2) ((fun _ => 1) i) = -1 ∧
      ∑ i : Fin 2, cesG (3 / 2) ((fun _ => 4) i) = -1 / 2 ∧
      (1 / (1 - 3 / 2)) * (-1 / 2 : ℝ) ^ (1 / (1 - 3 / 2 : ℝ)) <
        (1 / (1 - 3 / 2)) * (-1 : ℝ) ^ (1 / (1 - 3 / 2 : ℝ)) := by
  have h4 : (4 : ℝ) ^ (1 - 3 / 2 : ℝ) = 1 / 2 := by
    rw [show (4 : ℝ) = 2 ^ (2 : ℝ) by norm_num, ← Real.rpow_mul (by norm_num)]
    norm_num
  have e : (1 / (1 - 3 / 2 : ℝ)) = ((-2 : ℤ) : ℝ) := by norm_num
  refine ⟨?_, ?_, ?_⟩
  · simp [cesG]; norm_num
  · simp only [cesG, Fin.sum_univ_two]; norm_num [h4]
  · rw [e, Real.rpow_intCast, Real.rpow_intCast]
    norm_num

/-- **Example 22.C.4** (MWG, p. 829). For `ρ = 0`, `W₀(u) = ∑ uᵢ` (the purely utilitarian
case). -/
theorem cesW_zero [Fintype ι] (u : ι → ℝ) : cesW 0 u = ∑ i, u i := by
  simp [cesW]

open Filter Topology in
/-- **Exercise 22.C.5** (MWG, pp. 829, 851). For `u ≫ 0`, `W_ρ(u) → min uᵢ` as `ρ → ∞`: with
`k = ρ - 1 > 0` and `m = min uᵢ`, `n^{-1/k} m ≤ W_ρ(u) ≤ m`. -/
theorem exercise_22_C_5 [Fintype ι] [Nonempty ι] {u : ι → ℝ} (hu : ∀ i, 0 < u i) :
    Tendsto (fun ρ => cesW ρ u) atTop (𝓝 (Finset.univ.inf' Finset.univ_nonempty u)) := by
  set m := Finset.univ.inf' Finset.univ_nonempty u with hm
  obtain ⟨i₀, -, hi₀⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty u
  have hm0 : 0 < m := by rw [hm, hi₀]; exact hu i₀
  have hmle : ∀ i, m ≤ u i := fun i => Finset.inf'_le _ (Finset.mem_univ i)
  set N : ℝ := ((Fintype.card ι : ℕ) : ℝ) with hN
  have hN1 : 1 ≤ N := by rw [hN]; exact_mod_cast Fintype.card_pos
  -- `N^{-1/(ρ-1)} → 1`
  have hlim : Tendsto (fun ρ : ℝ => N ^ (-(ρ - 1)⁻¹) * m) atTop (𝓝 m) := by
    have h1 : Tendsto (fun ρ : ℝ => -(ρ - 1)⁻¹) atTop (𝓝 0) := by
      have := (tendsto_inv_atTop_zero.comp (tendsto_atTop_add_const_right (atTop : Filter ℝ)
        (-1 : ℝ) tendsto_id)).neg
      simpa [sub_eq_add_neg] using this
    have h2 : Tendsto (fun e : ℝ => N ^ e) (𝓝 0) (𝓝 (N ^ (0 : ℝ))) :=
      (continuous_const.rpow continuous_id fun _ => Or.inl (by positivity)).tendsto 0
    rw [Real.rpow_zero] at h2
    simpa using (h2.comp h1).mul_const m
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hlim tendsto_const_nhds ?_ ?_
  · filter_upwards [eventually_gt_atTop 1] with ρ hρ
    have hk : 0 < ρ - 1 := by linarith
    have hρ1 : ρ ≠ 1 := by linarith
    simp only [cesW, hρ1, ↓reduceIte]
    have hS : ∑ i, u i ^ (1 - ρ) ≤ N * m ^ (1 - ρ) := by
      calc ∑ i, u i ^ (1 - ρ) ≤ ∑ _i : ι, m ^ (1 - ρ) := Finset.sum_le_sum fun i _ =>
            Real.rpow_le_rpow_of_nonpos hm0 (hmle i) (by linarith)
        _ = N * m ^ (1 - ρ) := by simp [hN]
    have hSpos : 0 < ∑ i, u i ^ (1 - ρ) :=
      Finset.sum_pos (fun i _ => Real.rpow_pos_of_pos (hu i) _) Finset.univ_nonempty
    have e1 : (1 / (1 - ρ)) = -(ρ - 1)⁻¹ := by rw [one_div, ← inv_neg, neg_sub]
    rw [e1]
    calc N ^ (-(ρ - 1)⁻¹) * m = (N * m ^ (1 - ρ)) ^ (-(ρ - 1)⁻¹) := by
          rw [Real.mul_rpow (by positivity) (by positivity), ← Real.rpow_mul hm0.le]
          congr 1
          rw [show (1 - ρ) * -(ρ - 1)⁻¹ = (ρ - 1) * (ρ - 1)⁻¹ by ring, mul_inv_cancel₀ hk.ne',
            Real.rpow_one]
      _ ≤ (∑ i, u i ^ (1 - ρ)) ^ (-(ρ - 1)⁻¹) :=
          Real.rpow_le_rpow_of_nonpos hSpos hS (by simp [hk.le])
  · filter_upwards [eventually_gt_atTop 1] with ρ hρ
    have hk : 0 < ρ - 1 := by linarith
    have hρ1 : ρ ≠ 1 := by linarith
    simp only [cesW, hρ1, ↓reduceIte]
    have hS : m ^ (1 - ρ) ≤ ∑ i, u i ^ (1 - ρ) := by
      rw [show m = u i₀ from hm.trans hi₀]
      exact Finset.single_le_sum (f := fun i => u i ^ (1 - ρ))
        (fun i _ => (Real.rpow_pos_of_pos (hu i) _).le) (Finset.mem_univ i₀)
    have e1 : (1 / (1 - ρ)) = -(ρ - 1)⁻¹ := by rw [one_div, ← inv_neg, neg_sub]
    rw [e1]
    calc (∑ i, u i ^ (1 - ρ)) ^ (-(ρ - 1)⁻¹) ≤ (m ^ (1 - ρ)) ^ (-(ρ - 1)⁻¹) :=
          Real.rpow_le_rpow_of_nonpos (Real.rpow_pos_of_pos hm0 _) hS (by simp [hk.le])
      _ = m := by
          rw [← Real.rpow_mul hm0.le, show (1 - ρ) * -(ρ - 1)⁻¹ = (ρ - 1) * (ρ - 1)⁻¹ by ring,
            mul_inv_cancel₀ hk.ne', Real.rpow_one]

/-! ### Exercise 22.D.7: invariance of the constant elasticity family -/

/-- The functional generated by the constant elasticity family (equivalently by `W_ρ`,
`example_22_C_4_represent`), defined on profiles of positive utilities. -/
noncomputable def cesFunctional [Fintype ι] (ρ : ℝ) : UProfile ι X → X → X → Prop :=
  swfFunctional fun u => ∑ i, cesG ρ (u i)

/-- A profile of positive utility functions: the domain of Example 22.C.4. -/
def PosProfile (ũ : UProfile ι X) : Prop := ∀ i x, 0 < ũ i x

/-- **Definition 22.D.4** (MWG, p. 834) restricted to positive profiles: invariance to common
changes of units. -/
def InvCommonUnitsPos (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ β : ℝ, 0 < β → ∀ ũ : UProfile ι X, PosProfile ũ → F (fun i x => β * ũ i x) = F ũ

/-- **Definition 22.D.4** (MWG, p. 834) restricted to positive profiles: invariance to common
changes of origin (whenever the shifted profile is still positive). -/
def InvCommonOriginsPos (F : UProfile ι X → X → X → Prop) : Prop :=
  ∀ α : ℝ, ∀ ũ : UProfile ι X, PosProfile ũ → PosProfile (fun i x => ũ i x + α) →
    F (fun i x => ũ i x + α) = F ũ

/-- `∑ g_ρ(βuᵢ)` is a positive affine transformation of `∑ g_ρ(uᵢ)` for `β > 0`, `u ≫ 0`. -/
theorem cesSum_smul [Fintype ι] (ρ : ℝ) {β : ℝ} (hβ : 0 < β) :
    ∃ a b : ℝ, 0 < a ∧ ∀ u : ι → ℝ, (∀ i, 0 < u i) →
      ∑ i, cesG ρ (β * u i) = a * ∑ i, cesG ρ (u i) + b := by
  by_cases hρ : ρ = 1
  · refine ⟨1, Fintype.card ι * Real.log β, one_pos, fun u hu => ?_⟩
    simp only [cesG, hρ, ↓reduceIte, one_mul]
    rw [Finset.sum_congr rfl fun i _ => Real.log_mul hβ.ne' (hu i).ne', Finset.sum_add_distrib]
    simp [add_comm]
  · refine ⟨β ^ (1 - ρ), 0, Real.rpow_pos_of_pos hβ _, fun u hu => ?_⟩
    simp only [cesG, hρ, ↓reduceIte, add_zero, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Real.mul_rpow hβ.le (hu i).le]; ring

/-- **Exercise 22.D.7(a)** (MWG, p. 853). The functionals of the constant elasticity family are
invariant to common changes of units. -/
theorem exercise_22_D_7a [Fintype ι] (ρ : ℝ) :
    InvCommonUnitsPos (cesFunctional (ι := ι) (X := X) ρ) := by
  intro β hβ ũ hũ
  obtain ⟨a, b, ha, hab⟩ := cesSum_smul (ι := ι) ρ hβ
  funext x y
  simp only [cesFunctional, swfFunctional, uvec]
  rw [hab _ fun i => hũ i y, hab _ fun i => hũ i x]
  exact propext (by constructor <;> intro h <;> nlinarith)

/-- **Exercise 22.D.7(a)** (MWG, p. 853), the Rawlsian limit `ρ = ∞`: `min` is invariant to
common changes of units (and of origin), being invariant to all common ordinal
transformations. -/
theorem exercise_22_D_7b_rawls [Fintype ι] [Nonempty ι] :
    InvCommonUnits (swfFunctional (X := X)
      fun u : ι → ℝ => Finset.univ.inf' Finset.univ_nonempty u) ∧
    InvCommonOrigins (swfFunctional (X := X)
      fun u : ι → ℝ => Finset.univ.inf' Finset.univ_nonempty u) := by
  have h := (exercise_22_D_8ab (ι := ι) (X := X)).1
  exact ⟨fun β hβ ũ => h (fun t => β * t) (strictMono_mul_left_of_pos hβ) ũ,
    fun α ũ => h (fun t => t + α) (strictMono_id.add_const α) ũ⟩

/-- **Exercise 22.D.7(b)** (MWG, p. 853), the utilitarian member `ρ = 0`: `∑ g₀(uᵢ) = ∑ uᵢ` and
the functional is invariant to common changes of origin. -/
theorem exercise_22_D_7b_utilitarian [Fintype ι] :
    InvCommonOrigins (swfFunctional (X := X) fun u : ι → ℝ => ∑ i, cesG 0 (u i)) := by
  intro α ũ
  refine invariance_of_relation (swfFunctional_generatedBy _) (fun v i => v i + α)
    (fun u u' => ?_) ũ
  simp only [cesG, zero_ne_one, ↓reduceIte, sub_zero, Real.rpow_one, one_mul,
    Finset.sum_add_distrib]
  constructor <;> intro h <;> linarith

/-- `g_ρ` is strictly concave on `(0, ∞)` for `ρ > 0`, in the midpoint form used below. -/
theorem cesG_midpoint {ρ x y : ℝ} (hρ : 0 < ρ) (hx : 0 < x) (hy : 0 < y) (hxy : x ≠ y) :
    (cesG ρ x + cesG ρ y) / 2 < cesG ρ ((x + y) / 2) := by
  have hmid : (1 / 2 : ℝ) • x + (1 / 2 : ℝ) • y = (x + y) / 2 := by
    simp only [smul_eq_mul]; ring
  by_cases h1 : ρ = 1
  · subst h1
    have := strictConcaveOn_log_Ioi.2 (Set.mem_Ioi.2 hx) (Set.mem_Ioi.2 hy) hxy
      (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num)
    rw [hmid] at this
    simp only [cesG, ↓reduceIte, smul_eq_mul] at this ⊢
    linarith
  rcases lt_or_gt_of_ne h1 with hlt | hgt
  · have := (Real.strictConcaveOn_rpow (p := 1 - ρ) (by linarith) (by linarith)).2
      (Set.mem_Ici.2 hx.le) (Set.mem_Ici.2 hy.le) hxy
      (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num)
    rw [hmid] at this
    simp only [cesG, h1, ↓reduceIte, smul_eq_mul] at this ⊢
    have hp : 0 < 1 - ρ := by linarith
    nlinarith
  · -- `t ↦ t^{1-ρ}` is strictly convex on `(0, ∞)` for `1 - ρ < 0`
    have hp : 1 - ρ < 0 := by linarith
    have hconv : StrictConvexOn ℝ (Set.Ioi 0) fun t : ℝ => t ^ (1 - ρ) := by
      refine StrictMonoOn.strictConvexOn_of_deriv (convex_Ioi 0)
        (fun t ht => (Real.continuousAt_rpow_const _ _ (Or.inl (ne_of_gt ht))).continuousWithinAt)
        ?_
      rw [interior_Ioi]
      intro a ha b hb hab
      simp only [Real.deriv_rpow_const]
      have := Real.rpow_lt_rpow_of_neg ha hab (show 1 - ρ - 1 < 0 by linarith)
      nlinarith
    have := hconv.2 (Set.mem_Ioi.2 hx) (Set.mem_Ioi.2 hy) hxy
      (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num)
    rw [hmid] at this
    simp only [cesG, h1, ↓reduceIte, smul_eq_mul] at this ⊢
    nlinarith

/-- The inverse of `g_ρ` on its range. -/
noncomputable def cesGInv (ρ y : ℝ) : ℝ :=
  if ρ = 1 then Real.exp y else (y / (1 - ρ)) ^ (1 / (1 - ρ))

theorem cesG_cesGInv {ρ y : ℝ} (hy : ρ ≠ 1 → 0 < y / (1 - ρ)) : cesG ρ (cesGInv ρ y) = y := by
  by_cases hρ : ρ = 1
  · simp [cesG, cesGInv, hρ]
  · have hp : (1 - ρ) ≠ 0 := sub_ne_zero.2 (Ne.symm hρ)
    simp only [cesG, cesGInv, hρ, ↓reduceIte]
    rw [← Real.rpow_mul (hy hρ).le, one_div_mul_cancel hp, Real.rpow_one]
    field_simp

theorem cesGInv_pos {ρ y : ℝ} (hy : ρ ≠ 1 → 0 < y / (1 - ρ)) : 0 < cesGInv ρ y := by
  by_cases hρ : ρ = 1
  · simp [cesGInv, hρ, Real.exp_pos]
  · simp only [cesGInv, hρ, ↓reduceIte]; exact Real.rpow_pos_of_pos (hy hρ) _

/-- **Exercise 22.D.7(b)** (MWG, p. 853). For `0 < ρ < ∞` the functional of the constant
elasticity family is not invariant to common changes of origin (with two agents and two
alternatives). If it were, it would be invariant to `u ↦ (u + k𝟙)/2`, which fixes `k𝟙`; for
`A ~ k𝟙` this gives `(A + k𝟙)/2 ~ k𝟙 ~ A`, contradicting strict concavity of `g_ρ`. Together
with `exercise_22_D_7b_utilitarian` and `exercise_22_D_7b_rawls`, only `ρ = 0` and `ρ = ∞` give
functionals invariant to common changes of origin. -/
theorem exercise_22_D_7b [Fintype ι] {i₀ i₁ : ι} (hi : i₀ ≠ i₁) {x y : X} (hxy : x ≠ y)
    {ρ : ℝ} (hρ : 0 < ρ) : ¬InvCommonOriginsPos (cesFunctional (ι := ι) (X := X) ρ) := by
  intro hO
  have hU := exercise_22_D_7a (ι := ι) (X := X) ρ
  classical
  set A : ι → ℝ := fun i => if i = i₁ then 2 else 1 with hA
  have hApos : ∀ i, 0 < A i := fun i => by simp only [hA]; split_ifs <;> norm_num
  set N : ℝ := ((Fintype.card ι : ℕ) : ℝ) with hN
  have hNpos : 0 < N := by rw [hN]; exact_mod_cast Fintype.card_pos_iff.2 ⟨i₀⟩
  set y₀ := (∑ i, cesG ρ (A i)) / N with hy₀
  have hy : ρ ≠ 1 → 0 < y₀ / (1 - ρ) := fun h1 => by
    have hp : (1 - ρ) ≠ 0 := sub_ne_zero.2 (Ne.symm h1)
    have : y₀ / (1 - ρ) = (∑ i, A i ^ (1 - ρ)) / N := by
      simp only [hy₀, cesG, h1, ↓reduceIte, ← Finset.mul_sum]; field_simp
    rw [this]
    exact div_pos (Finset.sum_pos (fun i _ => Real.rpow_pos_of_pos (hApos i) _)
      ⟨i₀, Finset.mem_univ _⟩) hNpos
  set k := cesGInv ρ y₀ with hk
  have hkpos : 0 < k := cesGInv_pos hy
  have hgk : cesG ρ k = y₀ := cesG_cesGInv hy
  set K : ι → ℝ := fun _ => k
  have hAK : ∑ i, cesG ρ (A i) = ∑ i, cesG ρ (K i) := by
    simp only [K, hgk, hy₀, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← hN]
    field_simp
  -- the vector-level invariance of the ordering under `u ↦ (u + k𝟙)/2`
  set W : (ι → ℝ) → ℝ := fun u => ∑ i, cesG ρ (u i)
  have hgen := swfFunctional_generatedBy (X := X) W
  have hinv : ∀ u u' : ι → ℝ, (∀ i, 0 < u i) → (∀ i, 0 < u' i) →
      (W (fun i => (u' i + k) / 2) ≤ W (fun i => (u i + k) / 2) ↔ W u' ≤ W u) := by
    intro u u' hu hu'
    set ũ := profile3 x y u u' u' with hũ
    have hpos : PosProfile ũ := by
      intro i z
      simp only [hũ, profile3]
      split_ifs
      · exact hu i
      · exact hu' i
      · exact hu' i
    have e1 := hO k ũ hpos (fun i z => by linarith [hpos i z])
    have hpos' : PosProfile (fun i z => ũ i z + k) := fun i z => by linarith [hpos i z]
    have e2 := hU (1 / 2) (by norm_num) _ hpos'
    have h := congrFun (congrFun (e2.trans e1) x) y
    have hx' : ∀ i, ũ i x = u i := fun i => congrFun (profile3_a x y u u' u') i
    have hy' : ∀ i, ũ i y = u' i := fun i => congrFun (profile3_b hxy u u' u') i
    simp only [cesFunctional, swfFunctional, uvec, hx', hy'] at h
    have ex : ∀ v : ι → ℝ, ∀ i, 1 / 2 * (v i + k) = (v i + k) / 2 := fun v i => by ring
    simp only [ex] at h
    exact propext_iff.1 h
  have hKpos : ∀ i, 0 < K i := fun _ => hkpos
  have hfix : (fun i => (K i + k) / 2) = K := funext fun i => by simp [K]
  -- `(A + K)/2 ~ K`
  have h1 := (hinv A K hApos hKpos).2 hAK.ge
  have h2 := (hinv K A hKpos hApos).2 hAK.le
  rw [hfix] at h1 h2
  -- strict concavity: `W((A + K)/2) > W(K)`
  have hne : ∃ i, A i ≠ k := by
    by_cases hk1 : k = 1
    · exact ⟨i₁, by simp [hA, hk1]⟩
    · exact ⟨i₀, by simp [hA, hi, Ne.symm hk1]⟩
  obtain ⟨j, hj⟩ := hne
  have hlt : (W A + W K) / 2 < W (fun i => (A i + K i) / 2) := by
    simp only [W, ← Finset.sum_add_distrib, Finset.sum_div]
    refine Finset.sum_lt_sum (fun i _ => ?_) ⟨j, Finset.mem_univ j, cesG_midpoint hρ (hApos j)
      hkpos hj⟩
    by_cases hi : A i = k
    · simp [K, hi]
    · exact (cesG_midpoint hρ (hApos i) hkpos hi).le
  have hWAK : W A = W K := hAK
  change W (fun i => (A i + k) / 2) ≤ W K at h2
  linarith

/-! ### Example 22.C.1: equalization of marginal utilities -/

open Filter Topology in
/-- **Example 22.C.1** (MWG, p. 827). If an interior division `w ≫ 0` of the wealth `ω`
maximizes `∑ φᵢ(wᵢ)` over divisions `w' ≥ 0` with `∑ w'ᵢ = ω`, and each `φᵢ` is differentiable
at `wᵢ`, then marginal utilities are equalized: `φᵢ'(wᵢ) = φⱼ'(wⱼ)`. -/
theorem example_22_C_1_marginal {n : ℕ} {φ : Fin n → ℝ → ℝ} {φ' w : Fin n → ℝ} {ω : ℝ}
    (hd : ∀ i, HasDerivAt (φ i) (φ' i) (w i)) (hpos : ∀ i, 0 < w i) (hsum : ∑ i, w i = ω)
    (hopt : ∀ w' : Fin n → ℝ, (∀ i, 0 ≤ w' i) → ∑ i, w' i = ω →
      ∑ i, φ i (w' i) ≤ ∑ i, φ i (w i)) (i j : Fin n) : φ' i = φ' j := by
  by_cases hij : i = j
  · rw [hij]
  -- transfer `t` from `j` to `i`
  set w' : ℝ → Fin n → ℝ := fun t k => w k + (if k = i then t else 0) - (if k = j then t else 0)
  have hw'i : ∀ t, w' t i = w i + t := fun t => by simp [w', hij]
  have hw'j : ∀ t, w' t j = w j - t := fun t => by simp [w', Ne.symm hij]
  have hw'k : ∀ t k, k ≠ i → k ≠ j → w' t k = w k := fun t k h1 h2 => by simp [w', h1, h2]
  have hdiff : ∀ t, ∑ k, φ k (w' t k) - ∑ k, φ k (w k) =
      (φ i (w i + t) - φ i (w i)) + (φ j (w j - t) - φ j (w j)) := by
    intro t
    rw [← Finset.sum_sub_distrib, Fintype.sum_eq_add i j hij fun k ⟨h1, h2⟩ => by
      rw [hw'k t k h1 h2, sub_self]]
    rw [hw'i, hw'j]
  have hlocal : IsLocalMax (fun t => φ i (w i + t) + φ j (w j - t)) 0 := by
    have hball : ∀ᶠ t in 𝓝 (0 : ℝ), |t| < min (w i) (w j) :=
      (continuous_abs.tendsto 0).eventually (gt_mem_nhds (by simp [hpos i, hpos j]))
    filter_upwards [hball] with t ht
    have hmi := min_le_left (w i) (w j)
    have hmj := min_le_right (w i) (w j)
    have hnn : ∀ k, 0 ≤ w' t k := by
      intro k
      by_cases h1 : k = i
      · subst h1; rw [hw'i]; linarith [neg_abs_le t]
      by_cases h2 : k = j
      · subst h2; rw [hw'j]; linarith [le_abs_self t]
      rw [hw'k t k h1 h2]; exact (hpos k).le
    have hs : ∑ k, w' t k = ω := by
      simp only [w', Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_ite_eq',
        Finset.mem_univ, ↓reduceIte, hsum]
      ring
    have := hopt (w' t) hnn hs
    have := hdiff t
    simp only [add_zero, sub_zero]
    linarith
  have hD : HasDerivAt (fun t => φ i (w i + t) + φ j (w j - t)) (φ' i - φ' j) 0 := by
    have hi' : HasDerivAt (fun t => φ i (w i + t)) (φ' i) 0 :=
      HasDerivAt.comp_const_add (w i) 0 (by simpa using hd i)
    have hj' : HasDerivAt (fun t => φ j (w j - t)) (-φ' j) 0 :=
      HasDerivAt.comp_const_sub (w j) 0 (by simpa using hd j)
    simpa [sub_eq_add_neg] using hi'.fun_add hj'
  have := hlocal.hasDerivAt_eq_zero hD
  linarith

/-- **Example 22.C.1** (MWG, p. 827). With strictly concave utilities for wealth the purely
utilitarian division of wealth is unique. -/
theorem example_22_C_1_unique {n : ℕ} {φ : Fin n → ℝ → ℝ}
    (hφ : ∀ i, StrictConcaveOn ℝ (Set.Ici 0) (φ i)) {ω : ℝ} {w v : Fin n → ℝ}
    (hw : ∀ i, 0 ≤ w i) (hv : ∀ i, 0 ≤ v i) (hws : ∑ i, w i = ω) (hvs : ∑ i, v i = ω)
    (hwopt : ∀ w' : Fin n → ℝ, (∀ i, 0 ≤ w' i) → ∑ i, w' i = ω →
      ∑ i, φ i (w' i) ≤ ∑ i, φ i (w i))
    (hvopt : ∀ w' : Fin n → ℝ, (∀ i, 0 ≤ w' i) → ∑ i, w' i = ω →
      ∑ i, φ i (w' i) ≤ ∑ i, φ i (v i)) : w = v := by
  by_contra hne
  obtain ⟨j, hj⟩ := Function.ne_iff.1 hne
  set m : Fin n → ℝ := fun k => (w k + v k) / 2
  have hm : ∑ k, m k = ω := by
    simp only [m, ← Finset.sum_div, Finset.sum_add_distrib, hws, hvs]; ring
  have hmnn : ∀ k, 0 ≤ m k := fun k => by simp only [m]; linarith [hw k, hv k]
  have hlt : (∑ k, φ k (w k) + ∑ k, φ k (v k)) / 2 < ∑ k, φ k (m k) := by
    rw [← Finset.sum_add_distrib, Finset.sum_div]
    refine Finset.sum_lt_sum (fun k _ => ?_) ⟨j, Finset.mem_univ j, ?_⟩
    · have := (hφ k).concaveOn.2 (Set.mem_Ici.2 (hw k)) (Set.mem_Ici.2 (hv k))
        (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)
      simp only [smul_eq_mul, m] at this ⊢
      rw [show 1 / 2 * w k + 1 / 2 * v k = (w k + v k) / 2 by ring] at this
      linarith
    · have := (hφ j).2 (Set.mem_Ici.2 (hw j)) (Set.mem_Ici.2 (hv j)) hj
        (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num)
      simp only [smul_eq_mul, m] at this ⊢
      rw [show 1 / 2 * w j + 1 / 2 * v j = (w j + v j) / 2 by ring] at this
      linarith
  have h1 := hwopt m hmnn hm
  have h2 := hvopt w hw hws
  have h3 := hwopt v hv hvs
  linarith

/-- **Example 22.C.1**, a concrete instance of `example_22_C_1_marginal` (MWG, p. 827):
`φᵢ(t) = -(t - cᵢ)²` with `c = (3, 2)` and `ω = 3`. The division `w = (2, 1)` is optimal and
interior, and the marginal utilities `-2(wᵢ - cᵢ)` are both `2`. -/
theorem example_22_C_1_instance :
    (∀ w' : Fin 2 → ℝ, (∀ i, 0 ≤ w' i) → ∑ i, w' i = 3 →
      ∑ i, -(w' i - (![3, 2] : Fin 2 → ℝ) i) ^ 2 ≤
        ∑ i, -((![2, 1] : Fin 2 → ℝ) i - (![3, 2] : Fin 2 → ℝ) i) ^ 2) ∧
    (∀ i, HasDerivAt (fun t => -(t - (![3, 2] : Fin 2 → ℝ) i) ^ 2) 2
      ((![2, 1] : Fin 2 → ℝ) i)) := by
  refine ⟨fun w' _ hs => ?_, fun i => ?_⟩
  · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one] at hs ⊢
    nlinarith [sq_nonneg (w' 0 - 2)]
  · have h := (((hasDerivAt_id ((![2, 1] : Fin 2 → ℝ) i)).sub_const
      ((![3, 2] : Fin 2 → ℝ) i)).pow 2).neg
    convert h using 1
    · funext t; simp
    · fin_cases i <;> simp <;> norm_num

end MWG.WelfareBargaining

