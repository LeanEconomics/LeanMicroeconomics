import MWGPositiveEquilibriumTheory.PriceEffectsEconomy
import Mathlib.Topology.Order.Compact

/-!
# Fitting an indifference map to an offer surface (MWG pp. 602-606)

The step of the proof of **Proposition 17.E.3** that the book does by picture (Figure 17.E.2:
"we can always fit an indifference map so that for any `p ∈ P_ε` we generate precisely the
demands `ωᵢ + zⁱ(p)`") and, for `L > 2`, by appeal to the strong axiom (footnote 34). We prove
a general rationalization lemma, used for both the two-good proof and Debreu's construction.

**Data.** Prices `p` in a compact set `K ⊆ (θ, Θ)^L` (normalized prices), a target excess demand
`ζ(p)` with `p·ζ(p) = 0`, and a *utility level* `λ(p)` (lower is better) compatible with
revealed preference. The candidate better-than sets are generated by a family of offer points:
at level `c` a compact space `D` of indices gives generators `g(c, d)` of levels
`ℓ(c, d) ≤ c` (`smd_rationalize`, hypotheses `hG1`-`hG6`): generators at level `c` remain
available at higher levels; at the price `p` they are revealed worse in the quantitative sense
`m (λ(p) - ℓ) ≤ p·g`; and the only generator on the budget hyperplane at level `λ(p)` is
`ζ(p)`.

**Construction.** With `κ = m / (2 L Θ)`, the support values
`σ(s, c) = min_d [s·g(c, d) - κ (c - ℓ(c, d)) ∑ₗ sₗ]` (`smdSigma`), over normals `s` in the
box `[θ, Θ]^L`, define the concave functions `F(z, c) = min_s [s·z - σ(s, c)]` (`smdF`), strictly
increasing in the level `c` with slope at least `κ L θ`. The utility is `u(z) = -q(z)`, where
`q(z)` is the least level `c` with `F(z, c) ≥ 0` (`smdQ`). It is Lipschitz, quasiconcave
(`{u ≥ -c} = {F(·, c) ≥ 0}`) and strongly monotone (all normals are `≥ θ > 0`); at every
`p ∈ K` its unique maximizer on the half-space `{p·z ≤ 0}` is `ζ(p)`. Uniqueness is the one
delicate point: if `z ≠ ζ(p)` were also optimal, the normal `s = p + δ (ζ(p) - z)` for small
`δ > 0` separates (a compactness argument in the style of Danskin's theorem).

The preferences obtained are convex but not strictly convex (their indifference sets have
flat pieces); see `docs/corrections.md`.
-/

namespace MWG.PositiveEquilibriumTheory

open Filter Topology

variable {L : ℕ}

/-- The data of the construction: the generator family `g(c, d)` with levels `ℓ(c, d)`, the
box `[θ, Θ]^L` of normals, the level interval `[lo, hi]`, and the slope constant `κ`. -/
structure SMDData (L : ℕ) (D : Type*) where
  /-- Generator `d` available at level `c`. -/
  g : ℝ → D → Fin L → ℝ
  /-- Its utility level. -/
  ℓ : ℝ → D → ℝ
  /-- Slope constant. -/
  κ : ℝ
  /-- Lower bound of the normals. -/
  θ : ℝ
  /-- Upper bound of the normals. -/
  Θ : ℝ
  /-- Lowest level. -/
  lo : ℝ
  /-- Highest level. -/
  hi : ℝ

variable {D : Type*} [TopologicalSpace D]

/-- The value at normal `s` of the generator `d` at level `c`, shifted by `κ (c - ℓ) ∑ s`. -/
def smdTerm (S : SMDData L D) (s : Fin L → ℝ) (c : ℝ) (d : D) : ℝ :=
  s ⬝ᵥ S.g c d - S.κ * (c - S.ℓ c d) * ∑ l, s l

/-- The support value `σ(s, c) = inf_d smdTerm`. -/
noncomputable def smdSigma (S : SMDData L D) (s : Fin L → ℝ) (c : ℝ) : ℝ :=
  sInf (smdTerm S s c '' Set.univ)

/-- The box `[θ, Θ]^L` of normals. -/
def smdBox (S : SMDData L D) : Set (Fin L → ℝ) := Set.Icc (fun _ => S.θ) (fun _ => S.Θ)

/-- `F(z, c) = inf_{s ∈ box} (s·z - σ(s, c))`. -/
noncomputable def smdF (S : SMDData L D) (z : Fin L → ℝ) (c : ℝ) : ℝ :=
  sInf ((fun s => s ⬝ᵥ z - smdSigma S s c) '' smdBox S)

/-- The clamp of `c` to `[lo, hi]`. -/
def smdClamp (S : SMDData L D) (c : ℝ) : ℝ := max S.lo (min c S.hi)

/-- `F` extended linearly outside `[lo, hi]`, with slope `κ L θ`. -/
noncomputable def smdFt (S : SMDData L D) (z : Fin L → ℝ) (c : ℝ) : ℝ :=
  smdF S z (smdClamp S c) + S.κ * (L * S.θ) * (c - smdClamp S c)

/-- The least level `q(z)` at which `z` is in the better-than set. -/
noncomputable def smdQ (S : SMDData L D) (z : Fin L → ℝ) : ℝ := sInf {c | 0 ≤ smdFt S z c}

/-- The utility `u(z) = -q(z)`. -/
noncomputable def smdU (S : SMDData L D) (z : Fin L → ℝ) : ℝ := -smdQ S z

variable (S : SMDData L D)

theorem smdTerm_continuous (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) :
    Continuous fun x : ((Fin L → ℝ) × ℝ) × D => smdTerm S x.1.1 x.1.2 x.2 := by
  have hg' : Continuous fun x : ((Fin L → ℝ) × ℝ) × D => S.g x.1.2 x.2 :=
    hg.comp (continuous_snd.fst'.prodMk continuous_snd)
  have hℓ' : Continuous fun x : ((Fin L → ℝ) × ℝ) × D => S.ℓ x.1.2 x.2 :=
    hℓ.comp (continuous_snd.fst'.prodMk continuous_snd)
  unfold smdTerm dotProduct
  have hs : ∀ l, Continuous fun x : ((Fin L → ℝ) × ℝ) × D => x.1.1 l :=
    fun l => (continuous_apply l).comp continuous_fst.fst
  have hgl : ∀ l, Continuous fun x : ((Fin L → ℝ) × ℝ) × D => S.g x.1.2 x.2 l :=
    fun l => (continuous_apply l).comp hg'
  refine (continuous_finsetSum _ fun l _ => (hs l).mul (hgl l)).sub ?_
  exact (continuous_const.mul (continuous_fst.snd.sub hℓ')).mul
    (continuous_finsetSum _ fun l _ => hs l)

variable [CompactSpace D]

omit [CompactSpace D] in
/-- Continuity of `smdTerm` in the generator index. -/
theorem smdTerm_continuous_d (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (s : Fin L → ℝ) (c : ℝ) :
    Continuous (smdTerm S s c) := by
  have := (smdTerm_continuous S hg hℓ).comp
    ((continuous_const (y := ((s, c) : (Fin L → ℝ) × ℝ))).prodMk (continuous_id (X := D)))
  exact this

theorem smdSigma_le (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (s : Fin L → ℝ) (c : ℝ) (d : D) :
    smdSigma S s c ≤ smdTerm S s c d :=
  csInf_le (isCompact_univ.image (smdTerm_continuous_d S hg hℓ s c)).bddBelow
    ⟨d, Set.mem_univ d, rfl⟩

theorem smdSigma_eq [Nonempty D] (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (s : Fin L → ℝ) (c : ℝ) :
    ∃ d, smdSigma S s c = smdTerm S s c d := by
  obtain ⟨d, -, h⟩ := (isCompact_univ.image (smdTerm_continuous_d S hg hℓ s c)).sInf_mem
    (Set.univ_nonempty.image _)
  exact ⟨d, h.symm⟩

theorem smdSigma_continuous (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) :
    Continuous fun x : (Fin L → ℝ) × ℝ => smdSigma S x.1 x.2 := by
  have h := smdTerm_continuous S hg hℓ
  change Continuous fun x : (Fin L → ℝ) × ℝ => sInf ((fun d => smdTerm S x.1 x.2 d) '' Set.univ)
  exact IsCompact.continuous_sInf (f := fun (x : (Fin L → ℝ) × ℝ) (d : D) => smdTerm S x.1 x.2 d)
    (K := Set.univ) isCompact_univ h

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdBox_isCompact : IsCompact (smdBox S) := isCompact_Icc

omit [TopologicalSpace D] [CompactSpace D] in
theorem mem_smdBox {s : Fin L → ℝ} : s ∈ smdBox S ↔ ∀ l, S.θ ≤ s l ∧ s l ≤ S.Θ := by
  simp only [smdBox, Set.mem_Icc, Pi.le_def]
  exact ⟨fun h l => ⟨h.1 l, h.2 l⟩, fun h => ⟨fun l => (h l).1, fun l => (h l).2⟩⟩

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdBox_nonempty (h : S.θ ≤ S.Θ) : (smdBox S).Nonempty :=
  ⟨fun _ => S.θ, (mem_smdBox S).2 fun _ => ⟨le_rfl, h⟩⟩

theorem smdF_inner_continuous (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) :
    Continuous fun x : ((Fin L → ℝ) × ℝ) × (Fin L → ℝ) =>
      x.2 ⬝ᵥ x.1.1 - smdSigma S x.2 x.1.2 := by
  have hσ : Continuous fun x : ((Fin L → ℝ) × ℝ) × (Fin L → ℝ) => smdSigma S x.2 x.1.2 := by
    have := (smdSigma_continuous S hg hℓ).comp
      ((continuous_snd (X := (Fin L → ℝ) × ℝ) (Y := Fin L → ℝ)).prodMk continuous_fst.snd)
    exact this
  refine Continuous.sub ?_ hσ
  unfold dotProduct
  exact continuous_finsetSum _ fun l _ =>
    ((continuous_apply l).comp continuous_snd).mul ((continuous_apply l).comp continuous_fst.fst)

theorem smdF_continuous (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) :
    Continuous fun x : (Fin L → ℝ) × ℝ => smdF S x.1 x.2 := by
  have h := smdF_inner_continuous S hg hℓ
  change Continuous fun x : (Fin L → ℝ) × ℝ =>
    sInf ((fun s => s ⬝ᵥ x.1 - smdSigma S s x.2) '' smdBox S)
  exact IsCompact.continuous_sInf
    (f := fun (x : (Fin L → ℝ) × ℝ) (s : Fin L → ℝ) => s ⬝ᵥ x.1 - smdSigma S s x.2)
    (smdBox_isCompact S) h

theorem smdF_le (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) {s : Fin L → ℝ} (hs : s ∈ smdBox S)
    (z : Fin L → ℝ) (c : ℝ) : smdF S z c ≤ s ⬝ᵥ z - smdSigma S s c := by
  have hc : Continuous fun s : Fin L → ℝ => s ⬝ᵥ z - smdSigma S s c := by
    have := (smdF_inner_continuous S hg hℓ).comp
      ((continuous_const (y := ((z, c) : (Fin L → ℝ) × ℝ))).prodMk
        (continuous_id (X := Fin L → ℝ)))
    exact this
  exact csInf_le ((smdBox_isCompact S).image hc).bddBelow ⟨s, hs, rfl⟩

omit [TopologicalSpace D] [CompactSpace D] in
theorem le_smdF (h : S.θ ≤ S.Θ) {z : Fin L → ℝ} {c a : ℝ}
    (ha : ∀ s ∈ smdBox S, a ≤ s ⬝ᵥ z - smdSigma S s c) : a ≤ smdF S z c :=
  le_csInf ((smdBox_nonempty S h).image _) (by rintro _ ⟨s, hs, rfl⟩; exact ha s hs)

theorem smdF_eq (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (h : S.θ ≤ S.Θ) (z : Fin L → ℝ) (c : ℝ) :
    ∃ s ∈ smdBox S, smdF S z c = s ⬝ᵥ z - smdSigma S s c := by
  have hc : Continuous fun s : Fin L → ℝ => s ⬝ᵥ z - smdSigma S s c := by
    have := (smdF_inner_continuous S hg hℓ).comp
      ((continuous_const (y := ((z, c) : (Fin L → ℝ) × ℝ))).prodMk
        (continuous_id (X := Fin L → ℝ)))
    exact this
  obtain ⟨s, hs, hs'⟩ := ((smdBox_isCompact S).image hc).sInf_mem
    ((smdBox_nonempty S h).image _)
  exact ⟨s, hs, hs'.symm⟩

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdBox_sum {s : Fin L → ℝ} (hs : s ∈ smdBox S) :
    L * S.θ ≤ ∑ l, s l ∧ ∑ l, s l ≤ L * S.Θ := by
  rw [mem_smdBox] at hs
  constructor
  · have := Finset.sum_le_sum fun l (_ : l ∈ Finset.univ) => (hs l).1
    simpa using this
  · have := Finset.sum_le_sum fun l (_ : l ∈ Finset.univ) => (hs l).2
    simpa using this

/-- Monotonicity of `σ` in the level (generators remain available at higher levels). -/
theorem smdSigma_mono [Nonempty D] (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2)
    (hG6 : ∀ c ∈ Set.Icc S.lo S.hi, ∀ c' ∈ Set.Icc S.lo S.hi, c ≤ c' → ∀ d, ∃ d',
      S.g c' d' = S.g c d ∧ S.ℓ c' d' = S.ℓ c d)
    {c c' : ℝ} (hc : c ∈ Set.Icc S.lo S.hi) (hc' : c' ∈ Set.Icc S.lo S.hi) (hcc : c ≤ c')
    (s : Fin L → ℝ) :
    smdSigma S s c' ≤ smdSigma S s c - S.κ * (c' - c) * ∑ l, s l := by
  obtain ⟨d, hd⟩ := smdSigma_eq S hg hℓ s c
  obtain ⟨d', hg', hℓ'⟩ := hG6 c hc c' hc' hcc d
  have := smdSigma_le S hg hℓ s c' d'
  rw [hd]
  simp only [smdTerm, hg', hℓ'] at this ⊢
  linarith

/-- `F` increases in the level with slope at least `κ L θ`. -/
theorem smdF_mono [Nonempty D] (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθΘ : S.θ ≤ S.Θ) (hκ : 0 ≤ S.κ)
    (hG6 : ∀ c ∈ Set.Icc S.lo S.hi, ∀ c' ∈ Set.Icc S.lo S.hi, c ≤ c' → ∀ d, ∃ d',
      S.g c' d' = S.g c d ∧ S.ℓ c' d' = S.ℓ c d)
    {c c' : ℝ} (hc : c ∈ Set.Icc S.lo S.hi) (hc' : c' ∈ Set.Icc S.lo S.hi) (hcc : c ≤ c')
    (z : Fin L → ℝ) : smdF S z c + S.κ * (L * S.θ) * (c' - c) ≤ smdF S z c' := by
  obtain ⟨s, hs, hF⟩ := smdF_eq S hg hℓ hθΘ z c'
  have h1 := smdSigma_mono S hg hℓ hG6 hc hc' hcc s
  have h2 := smdF_le S hg hℓ hs z c
  have h3 := (smdBox_sum S hs).1
  have h4 : S.κ * (L * S.θ) * (c' - c) ≤ S.κ * (c' - c) * ∑ l, s l := by
    rw [mul_right_comm]
    exact mul_le_mul_of_nonneg_left h3 (mul_nonneg hκ (sub_nonneg.2 hcc))
  rw [hF]
  linarith

/-- `F` is Lipschitz in the bundle. -/
theorem smdF_lipschitz (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθ : 0 ≤ S.θ) (hθΘ : S.θ ≤ S.Θ)
    (z z' : Fin L → ℝ) (c : ℝ) : smdF S z c - L * S.Θ * ‖z - z'‖ ≤ smdF S z' c := by
  refine le_smdF S hθΘ fun s hs => ?_
  have h1 := smdF_le S hg hℓ hs z c
  have hb : |s ⬝ᵥ (z - z')| ≤ L * S.Θ * ‖z - z'‖ := by
    rw [mem_smdBox] at hs
    calc |s ⬝ᵥ (z - z')| ≤ ∑ l, |s l * (z - z') l| := by
          unfold dotProduct; exact Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _l : Fin L, S.Θ * ‖z - z'‖ := by
          refine Finset.sum_le_sum fun l _ => ?_
          rw [abs_mul, abs_of_nonneg (hθ.trans (hs l).1)]
          exact mul_le_mul (hs l).2 (by simpa using norm_le_pi_norm (z - z') l)
            (abs_nonneg _) (hθ.trans hθΘ)
      _ = L * S.Θ * ‖z - z'‖ := by simp; ring
  have h2 : s ⬝ᵥ z - s ⬝ᵥ z' ≤ L * S.Θ * ‖z - z'‖ := by
    rw [← dotProduct_sub]; exact (le_abs_self _).trans hb
  linarith

/-- `F` gains at least `θ ∑ₗ (z'ₗ - zₗ)` when the bundle increases. -/
theorem smdF_add_le (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθΘ : S.θ ≤ S.Θ) {z z' : Fin L → ℝ}
    (hzz : z ≤ z') (c : ℝ) : smdF S z c + S.θ * ∑ l, (z' l - z l) ≤ smdF S z' c := by
  refine le_smdF S hθΘ fun s hs => ?_
  have h1 := smdF_le S hg hℓ hs z c
  have h2 : S.θ * ∑ l, (z' l - z l) ≤ s ⬝ᵥ z' - s ⬝ᵥ z := by
    rw [← dotProduct_sub, dotProduct, Finset.mul_sum]
    refine Finset.sum_le_sum fun l _ => ?_
    exact mul_le_mul_of_nonneg_right (((mem_smdBox S).1 hs l).1) (sub_nonneg.2 (hzz l))
  linarith

omit [TopologicalSpace D] [CompactSpace D] in
/-- `F(·, c)` is concave. -/
theorem smdF_concave (hθΘ : S.θ ≤ S.Θ) (z z' : Fin L → ℝ) (c a b : ℝ) (ha : 0 ≤ a)
    (hb : 0 ≤ b) (hab : a + b = 1) (hz : ∀ s ∈ smdBox S, smdF S z c ≤ s ⬝ᵥ z - smdSigma S s c)
    (hz' : ∀ s ∈ smdBox S, smdF S z' c ≤ s ⬝ᵥ z' - smdSigma S s c) :
    a * smdF S z c + b * smdF S z' c ≤ smdF S (a • z + b • z') c := by
  refine le_smdF S hθΘ fun s hs => ?_
  have h1 := mul_le_mul_of_nonneg_left (hz s hs) ha
  have h2 := mul_le_mul_of_nonneg_left (hz' s hs) hb
  rw [dotProduct_add, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul]
  have : smdSigma S s c = a * smdSigma S s c + b * smdSigma S s c := by
    rw [← add_mul, hab, one_mul]
  nlinarith

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdClamp_mem (h : S.lo ≤ S.hi) (c : ℝ) : smdClamp S c ∈ Set.Icc S.lo S.hi :=
  ⟨le_max_left _ _, max_le h (min_le_right _ _)⟩

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdClamp_of_mem {c : ℝ} (hc : c ∈ Set.Icc S.lo S.hi) : smdClamp S c = c := by
  simp [smdClamp, hc.1, hc.2]

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdClamp_mono {c c' : ℝ} (h : c ≤ c') : smdClamp S c ≤ smdClamp S c' :=
  max_le_max le_rfl (min_le_min h le_rfl)

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdClamp_sub_mono (h : S.lo ≤ S.hi) {c c' : ℝ} (hcc : c ≤ c') :
    smdClamp S c' - smdClamp S c ≤ c' - c := by
  unfold smdClamp
  rcases le_total c S.lo with h1 | h1 <;> rcases le_total c S.hi with h2 | h2 <;>
    rcases le_total c' S.lo with h3 | h3 <;> rcases le_total c' S.hi with h4 | h4 <;>
    simp only [min_eq_left, min_eq_right, max_eq_left, max_eq_right, *] <;>
    linarith

/-- The extended `F` increases in the level with slope at least `κ L θ`. -/
theorem smdFt_mono [Nonempty D] (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθΘ : S.θ ≤ S.Θ) (hκ : 0 ≤ S.κ)
    (hlh : S.lo ≤ S.hi)
    (hG6 : ∀ c ∈ Set.Icc S.lo S.hi, ∀ c' ∈ Set.Icc S.lo S.hi, c ≤ c' → ∀ d, ∃ d',
      S.g c' d' = S.g c d ∧ S.ℓ c' d' = S.ℓ c d)
    {c c' : ℝ} (hcc : c ≤ c') (z : Fin L → ℝ) :
    smdFt S z c + S.κ * (L * S.θ) * (c' - c) ≤ smdFt S z c' := by
  have h1 := smdF_mono S hg hℓ hθΘ hκ hG6 (smdClamp_mem S hlh c) (smdClamp_mem S hlh c')
    (smdClamp_mono S hcc) z
  unfold smdFt
  linarith

omit [TopologicalSpace D] [CompactSpace D] in
theorem smdClamp_continuous : Continuous (smdClamp S) :=
  continuous_const.max (continuous_id.min continuous_const)

theorem smdFt_continuous (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) :
    Continuous fun x : (Fin L → ℝ) × ℝ => smdFt S x.1 x.2 := by
  have hcl := smdClamp_continuous S
  have hF := (smdF_continuous S hg hℓ).comp (continuous_fst.prodMk (hcl.comp continuous_snd))
  unfold smdFt
  exact hF.add (continuous_const.mul (continuous_snd.sub (hcl.comp continuous_snd)))

/-- The level function `q` is characterized by `q(z) ≤ c ⟺ F̃(z, c) ≥ 0`. -/
theorem smdQ_le_iff [Nonempty D] (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθΘ : S.θ ≤ S.Θ) (hκ : 0 ≤ S.κ)
    (hlh : S.lo ≤ S.hi) (hk : 0 < S.κ * (L * S.θ))
    (hG6 : ∀ c ∈ Set.Icc S.lo S.hi, ∀ c' ∈ Set.Icc S.lo S.hi, c ≤ c' → ∀ d, ∃ d',
      S.g c' d' = S.g c d ∧ S.ℓ c' d' = S.ℓ c d)
    (z : Fin L → ℝ) (c : ℝ) : smdQ S z ≤ c ↔ 0 ≤ smdFt S z c := by
  have hmono : ∀ c c', c ≤ c' →
      smdFt S z c + S.κ * (L * S.θ) * (c' - c) ≤ smdFt S z c' :=
    fun c c' h => smdFt_mono S hg hℓ hθΘ hκ hlh hG6 h z
  have hcont : Continuous fun c => smdFt S z c := by
    have := (smdFt_continuous S hg hℓ).comp
      ((continuous_const (y := z)).prodMk (continuous_id (X := ℝ)))
    exact this
  have hne : ({c | 0 ≤ smdFt S z c} : Set ℝ).Nonempty := by
    refine ⟨max 0 (-smdFt S z 0 / (S.κ * (L * S.θ))), ?_⟩
    have h := hmono 0 (max 0 (-smdFt S z 0 / (S.κ * (L * S.θ)))) (le_max_left _ _)
    have h2 : -smdFt S z 0 / (S.κ * (L * S.θ)) ≤
        max 0 (-smdFt S z 0 / (S.κ * (L * S.θ))) := le_max_right _ _
    have h3 : S.κ * (L * S.θ) * (-smdFt S z 0 / (S.κ * (L * S.θ))) = -smdFt S z 0 :=
      mul_div_cancel₀ _ hk.ne'
    have h4 := mul_le_mul_of_nonneg_left h2 hk.le
    change 0 ≤ smdFt S z _
    linarith
  have hbdd : BddBelow ({c | 0 ≤ smdFt S z c} : Set ℝ) := by
    refine ⟨min 0 (-smdFt S z 0 / (S.κ * (L * S.θ))), fun c hc => ?_⟩
    by_contra hlt
    push Not at hlt
    have hc0 : c < 0 := lt_of_lt_of_le hlt (min_le_left _ _)
    have hc1 : c < -smdFt S z 0 / (S.κ * (L * S.θ)) := lt_of_lt_of_le hlt (min_le_right _ _)
    have h := hmono c 0 hc0.le
    have h3 : S.κ * (L * S.θ) * (-smdFt S z 0 / (S.κ * (L * S.θ))) = -smdFt S z 0 :=
      mul_div_cancel₀ _ hk.ne'
    have h4 := mul_lt_mul_of_pos_left hc1 hk
    have hc' : 0 ≤ smdFt S z c := hc
    linarith
  have hclosed : IsClosed ({c | 0 ≤ smdFt S z c} : Set ℝ) := isClosed_le continuous_const hcont
  constructor
  · intro h
    have hmem : 0 ≤ smdFt S z (smdQ S z) := hclosed.csInf_mem hne hbdd
    have h1 := hmono _ _ h
    have h2 : 0 ≤ S.κ * (L * S.θ) * (c - smdQ S z) := mul_nonneg hk.le (sub_nonneg.2 h)
    linarith
  · intro h
    exact csInf_le hbdd h

/-- `F̃` is Lipschitz in the bundle. -/
theorem smdFt_lipschitz (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθ : 0 ≤ S.θ) (hθΘ : S.θ ≤ S.Θ)
    (z z' : Fin L → ℝ) (c : ℝ) : smdFt S z c - L * S.Θ * ‖z - z'‖ ≤ smdFt S z' c := by
  have := smdF_lipschitz S hg hℓ hθ hθΘ z z' (smdClamp S c)
  unfold smdFt
  linarith

/-- The level function `q` is Lipschitz. -/
theorem smdQ_le_add [Nonempty D] (hg : Continuous fun x : ℝ × D => S.g x.1 x.2)
    (hℓ : Continuous fun x : ℝ × D => S.ℓ x.1 x.2) (hθ : 0 ≤ S.θ) (hθΘ : S.θ ≤ S.Θ)
    (hκ : 0 ≤ S.κ) (hlh : S.lo ≤ S.hi) (hk : 0 < S.κ * (L * S.θ))
    (hG6 : ∀ c ∈ Set.Icc S.lo S.hi, ∀ c' ∈ Set.Icc S.lo S.hi, c ≤ c' → ∀ d, ∃ d',
      S.g c' d' = S.g c d ∧ S.ℓ c' d' = S.ℓ c d)
    (z z' : Fin L → ℝ) :
    smdQ S z' ≤ smdQ S z + L * S.Θ / (S.κ * (L * S.θ)) * ‖z - z'‖ := by
  set k := S.κ * (L * S.θ)
  set C := L * S.Θ / k
  have hC : 0 ≤ C := div_nonneg (mul_nonneg (Nat.cast_nonneg L) (hθ.trans hθΘ)) hk.le
  rw [smdQ_le_iff S hg hℓ hθΘ hκ hlh hk hG6]
  have h0 : 0 ≤ smdFt S z (smdQ S z) := (smdQ_le_iff S hg hℓ hθΘ hκ hlh hk hG6 z _).1 le_rfl
  have h1 := smdFt_mono S hg hℓ hθΘ hκ hlh hG6 (c := smdQ S z)
    (c' := smdQ S z + C * ‖z - z'‖)
    (le_add_of_nonneg_right (mul_nonneg hC (norm_nonneg (z - z')))) z
  have h2 := smdFt_lipschitz S hg hℓ hθ hθΘ z z' (smdQ S z + C * ‖z - z'‖)
  have h3 : k * (smdQ S z + C * ‖z - z'‖ - smdQ S z) = L * S.Θ * ‖z - z'‖ := by
    simp only [C]; field_simp; ring
  linarith

/-- **The rationalization lemma** (the step "we can always fit an indifference map" of the
proof of Proposition 17.E.3, MWG pp. 603 and 605). Under the hypotheses on the generator family
described in the module docstring, there is a continuous, quasiconcave (convex upper contour
sets), strongly monotone utility `u` on `ℝ^L` such that for every `p ∈ K`, `ζ(p)` is the unique
maximizer of `u` on the half-space `{z : p·z ≤ 0}`. -/
theorem smd_rationalize [Nonempty D] (hL : 0 < L) {K : Set (Fin L → ℝ)}
    {ζ : (Fin L → ℝ) → Fin L → ℝ} {lev : (Fin L → ℝ) → ℝ} {g : ℝ → D → Fin L → ℝ}
    {ℓ : ℝ → D → ℝ} {lo hi θ Θ m : ℝ}
    (hg : Continuous fun x : ℝ × D => g x.1 x.2) (hℓ : Continuous fun x : ℝ × D => ℓ x.1 x.2)
    (hlh : lo ≤ hi) (hθ : 0 < θ) (hθΘ : θ ≤ Θ) (hm : 0 < m)
    (hK : ∀ p ∈ K, ∀ l, θ < p l ∧ p l < Θ) (hlev : ∀ p ∈ K, lev p ∈ Set.Icc lo hi)
    (hG1 : ∀ c ∈ Set.Icc lo hi, ∀ d, ℓ c d ≤ c)
    (hG2 : ∀ p ∈ K, ∀ c ∈ Set.Icc lo hi, c ≤ lev p → ∀ d, m * (lev p - ℓ c d) ≤ p ⬝ᵥ g c d)
    (hG3 : ∀ p ∈ K, ∀ d, p ⬝ᵥ g (lev p) d = 0 → ℓ (lev p) d = lev p → g (lev p) d = ζ p)
    (hG4 : ∀ p ∈ K, ∃ d, g (lev p) d = ζ p ∧ ℓ (lev p) d = lev p)
    (hG5 : ∀ p ∈ K, p ⬝ᵥ ζ p = 0)
    (hG6 : ∀ c ∈ Set.Icc lo hi, ∀ c' ∈ Set.Icc lo hi, c ≤ c' → ∀ d, ∃ d',
      g c' d' = g c d ∧ ℓ c' d' = ℓ c d) :
    ∃ u : (Fin L → ℝ) → ℝ, Continuous u ∧ (∀ c, Convex ℝ {z | c ≤ u z}) ∧
      (∀ z z', z ≤ z' → z ≠ z' → u z < u z') ∧
      ∀ p ∈ K, ∀ z, p ⬝ᵥ z ≤ 0 → u z ≤ u (ζ p) ∧ (u (ζ p) ≤ u z → z = ζ p) := by
  have hΘ : 0 < Θ := hθ.trans_le hθΘ
  have hLr : (0 : ℝ) < L := Nat.cast_pos.2 hL
  set S : SMDData L D := ⟨g, ℓ, m / (2 * (L * Θ)), θ, Θ, lo, hi⟩ with hS
  have hSg : S.g = g := rfl
  have hSℓ : S.ℓ = ℓ := rfl
  have hκ : 0 < S.κ := by simp only [hS]; positivity
  have hk : 0 < S.κ * (L * S.θ) := by simp only [hS] at hκ ⊢; positivity
  have hκsum : ∀ s ∈ smdBox S, S.κ * ∑ l, s l ≤ m / 2 := by
    intro s hs
    have := (smdBox_sum S hs).2
    calc S.κ * ∑ l, s l ≤ S.κ * (L * Θ) := mul_le_mul_of_nonneg_left this hκ.le
      _ = m / 2 := by simp only [hS]; field_simp
  have hpbox : ∀ p ∈ K, p ∈ smdBox S :=
    fun p hp => (mem_smdBox S).2 fun l => ⟨(hK p hp l).1.le, (hK p hp l).2.le⟩
  have hQ := smdQ_le_iff S hg hℓ hθΘ hκ.le hlh hk hG6
  -- the support value at `p` is at least `m (λ(p) - c)`
  have hN2 : ∀ p ∈ K, ∀ c ∈ Set.Icc lo hi, c ≤ lev p → m * (lev p - c) ≤ smdSigma S p c := by
    intro p hp c hc hcl
    obtain ⟨d, hd⟩ := smdSigma_eq S hg hℓ p c
    rw [hd]
    have h2 := hG2 p hp c hc hcl d
    have h1 := hG1 c hc d
    have h3 := hκsum p (hpbox p hp)
    have h4 : S.κ * (c - ℓ c d) * ∑ l, p l ≤ m / 2 * (c - ℓ c d) := by
      rw [mul_right_comm]; exact mul_le_mul_of_nonneg_right h3 (sub_nonneg.2 h1)
    simp only [smdTerm]
    change m * (lev p - c) ≤ p ⬝ᵥ g c d - S.κ * (c - ℓ c d) * ∑ l, p l
    nlinarith
  refine ⟨smdU S, ?_, ?_, ?_, ?_⟩
  · -- continuity
    have hlip : LipschitzWith (Real.toNNReal (L * S.Θ / (S.κ * (L * S.θ)))) (smdQ S) := by
      refine LipschitzWith.of_dist_le_mul fun z z' => ?_
      rw [Real.dist_eq, dist_eq_norm, Real.coe_toNNReal _ (by positivity)]
      have h1 := smdQ_le_add S hg hℓ hθ.le hθΘ hκ.le hlh hk hG6 z' z
      have h2 := smdQ_le_add S hg hℓ hθ.le hθΘ hκ.le hlh hk hG6 z z'
      rw [norm_sub_rev] at h1
      rw [abs_le]
      constructor <;> linarith
    exact hlip.continuous.neg
  · -- convex upper contour sets
    intro c x hx y hy a b ha hb hab
    have hx2 : c ≤ -smdQ S x := hx
    have hy2 : c ≤ -smdQ S y := hy
    have hx' : 0 ≤ smdFt S x (-c) := (hQ x (-c)).1 (by linarith)
    have hy' : 0 ≤ smdFt S y (-c) := (hQ y (-c)).1 (by linarith)
    have hconc := smdF_concave S hθΘ x y (smdClamp S (-c)) a b ha hb hab
      (fun s hs => smdF_le S hg hℓ hs x _) (fun s hs => smdF_le S hg hℓ hs y _)
    have : 0 ≤ smdFt S (a • x + b • y) (-c) := by
      unfold smdFt at hx' hy' ⊢
      have e : S.κ * (L * S.θ) * (-c - smdClamp S (-c)) =
          a * (S.κ * (L * S.θ) * (-c - smdClamp S (-c))) +
            b * (S.κ * (L * S.θ) * (-c - smdClamp S (-c))) := by
        rw [← add_mul, hab, one_mul]
      nlinarith
    change c ≤ smdU S (a • x + b • y)
    have := (hQ _ _).2 this
    simp only [smdU]; linarith
  · -- strong monotonicity
    intro z z' hzz hne
    have hpos : 0 < S.θ * ∑ l, (z' l - z l) := by
      obtain ⟨k, hk'⟩ : ∃ k, z k < z' k := by
        by_contra h; push Not at h; exact hne (le_antisymm hzz fun k => h k)
      exact mul_pos hθ (Finset.sum_pos' (fun l _ => sub_nonneg.2 (hzz l))
        ⟨k, Finset.mem_univ k, sub_pos.2 hk'⟩)
    have hFt : ∀ c, smdFt S z c + S.θ * ∑ l, (z' l - z l) ≤ smdFt S z' c := by
      intro c
      have := smdF_add_le S hg hℓ hθΘ hzz (smdClamp S c)
      unfold smdFt; linarith
    set q := smdQ S z
    have h0 : 0 ≤ smdFt S z q := (hQ z q).1 le_rfl
    have hq' : 0 < smdFt S z' q := by linarith [hFt q]
    have hcont : Continuous fun c => smdFt S z' c := by
      have := (smdFt_continuous S hg hℓ).comp
        ((continuous_const (y := z')).prodMk (continuous_id (X := ℝ)))
      exact this
    have hev : ∀ᶠ c in 𝓝 q, 0 < smdFt S z' c := (hcont.tendsto q).eventually (lt_mem_nhds hq')
    obtain ⟨c, hc, hcq⟩ := ((hev.filter_mono nhdsWithin_le_nhds).and
      (self_mem_nhdsWithin (s := Set.Iio q))).exists
    have := (hQ z' c).2 hc.le
    simp only [smdU]
    exact neg_lt_neg (lt_of_le_of_lt this hcq)
  · -- the demand
    intro p hp
    have hlp := hlev p hp
    have hcl : smdClamp S (lev p) = (lev p) := smdClamp_of_mem S hlp
    have hFtF : ∀ z, smdFt S z (lev p) = smdF S z (lev p) := by
      intro z; unfold smdFt; rw [hcl, sub_self, mul_zero, add_zero]
    obtain ⟨d₄, hd₄g, hd₄ℓ⟩ := hG4 p hp
    -- `u(ζ(p)) ≥ -λ(p)`
    have hζ : -(lev p) ≤ smdU S (ζ p) := by
      have : 0 ≤ smdFt S (ζ p) (lev p) := by
        rw [hFtF]
        refine le_smdF S hθΘ fun s hs => ?_
        have := smdSigma_le S hg hℓ s (lev p) d₄
        simp only [smdTerm, hSg, hSℓ, hd₄g, hd₄ℓ, sub_self, mul_zero, zero_mul, sub_zero] at this
        change 0 ≤ s ⬝ᵥ ζ p - smdSigma S s (lev p)
        linarith
      have := (hQ _ _).2 this
      simp only [smdU]; linarith
    -- `u(z) ≤ -λ(p)` on the budget half-space
    have hbud : ∀ z, p ⬝ᵥ z ≤ 0 → smdU S z ≤ -(lev p) := by
      intro z hz
      by_contra hlt
      push Not at hlt
      have hq : smdQ S z < (lev p) := by simp only [smdU] at hlt; linarith
      set c := smdQ S z
      have h0 : 0 ≤ smdFt S z c := (hQ z c).1 le_rfl
      rcases lt_or_ge c lo with hc | hc
      · have hclc : smdClamp S c = lo := by
          simp only [smdClamp]
          rw [min_eq_left (hc.le.trans hlh), max_eq_left hc.le]
        unfold smdFt at h0
        rw [hclc] at h0
        have hpos : 0 < smdF S z lo := by
          have : S.κ * (L * S.θ) * (c - lo) < 0 := mul_neg_of_pos_of_neg hk (by linarith)
          linarith
        have h1 := smdF_le S hg hℓ (hpbox p hp) z lo
        have h2 := hN2 p hp lo ⟨le_rfl, hlh⟩ hlp.1
        have h3 : 0 ≤ m * ((lev p) - lo) := mul_nonneg hm.le (sub_nonneg.2 hlp.1)
        linarith
      · have hcI : c ∈ Set.Icc lo hi := ⟨hc, hq.le.trans hlp.2⟩
        have hclc : smdClamp S c = c := smdClamp_of_mem S hcI
        unfold smdFt at h0
        rw [hclc, sub_self, mul_zero, add_zero] at h0
        have h1 := smdF_le S hg hℓ (hpbox p hp) z c
        have h2 := hN2 p hp c hcI hq.le
        have h3 : 0 < m * ((lev p) - c) := mul_pos hm (sub_pos.2 hq)
        linarith
    have hζeq : smdU S (ζ p) = -(lev p) := le_antisymm (hbud _ (hG5 p hp).le) hζ
    intro z hz
    refine ⟨by rw [hζeq]; exact hbud z hz, fun hge => ?_⟩
    rw [hζeq] at hge
    have hFz : 0 ≤ smdF S z (lev p) := by
      rw [← hFtF]; exact (hQ z (lev p)).1 (by simp only [smdU] at hge; linarith)
    -- uniqueness: separate with the normal `p + δ (ζ(p) - z)`
    by_contra hne
    set v := ζ p - z with hv
    have hvv : 0 < v ⬝ᵥ v := by
      have hnn : 0 ≤ v ⬝ᵥ v := Finset.sum_nonneg fun l _ => mul_self_nonneg _
      refine lt_of_le_of_ne hnn fun h => hne ?_
      have := dotProduct_self_eq_zero.1 h.symm
      rw [hv, sub_eq_zero] at this
      exact this.symm
    set η := v ⬝ᵥ v / 2
    set A : D → ℝ := fun d => smdTerm S p (lev p) d
    set B : D → ℝ := fun d => smdTerm S v (lev p) d
    have hAc : Continuous A := smdTerm_continuous_d S hg hℓ p (lev p)
    have hBc : Continuous B := smdTerm_continuous_d S hg hℓ v (lev p)
    have hlin : ∀ δ : ℝ, ∀ d, smdTerm S (p + δ • v) (lev p) d = A d + δ * B d := by
      intro δ d
      simp only [A, B, smdTerm, add_dotProduct, smul_dotProduct, smul_eq_mul, Pi.add_apply,
        Pi.smul_apply, Finset.sum_add_distrib, ← Finset.mul_sum]
      ring
    have hA0 : ∀ d, 0 ≤ A d := by
      intro d
      have h2 := hG2 p hp (lev p) hlp le_rfl d
      have h1 := hG1 (lev p) hlp d
      have h3 := hκsum p (hpbox p hp)
      have h4 : S.κ * ((lev p) - ℓ (lev p) d) * ∑ l, p l ≤ m / 2 * ((lev p) - ℓ (lev p) d) := by
        rw [mul_right_comm]; exact mul_le_mul_of_nonneg_right h3 (sub_nonneg.2 h1)
      change 0 ≤ p ⬝ᵥ g (lev p) d - S.κ * ((lev p) - ℓ (lev p) d) * ∑ l, p l
      nlinarith
    have hAeq : ∀ d, A d = 0 → g (lev p) d = ζ p ∧ ℓ (lev p) d = (lev p) := by
      intro d hd
      have h2 := hG2 p hp (lev p) hlp le_rfl d
      have h1 := hG1 (lev p) hlp d
      have h3 := hκsum p (hpbox p hp)
      have h4 : S.κ * ((lev p) - ℓ (lev p) d) * ∑ l, p l ≤ m / 2 * ((lev p) - ℓ (lev p) d) := by
        rw [mul_right_comm]; exact mul_le_mul_of_nonneg_right h3 (sub_nonneg.2 h1)
      have hd' : p ⬝ᵥ g (lev p) d - S.κ * ((lev p) - ℓ (lev p) d) * ∑ l, p l = 0 := hd
      have hℓeq : ℓ (lev p) d = (lev p) := by nlinarith
      have hpg : p ⬝ᵥ g (lev p) d = 0 := by rw [hℓeq, sub_self, mul_zero, zero_mul] at hd'; linarith
      exact ⟨hG3 p hp d hpg hℓeq, hℓeq⟩
    set C : Set D := {d | B d ≤ v ⬝ᵥ ζ p - η}
    have hCc : IsCompact C := (isClosed_le hBc continuous_const).isCompact
    obtain ⟨a, ha, haC⟩ : ∃ a, 0 < a ∧ ∀ d ∈ C, a ≤ A d := by
      rcases C.eq_empty_or_nonempty with hC | hC
      · exact ⟨1, one_pos, fun d hd => by rw [hC] at hd; exact hd.elim⟩
      · obtain ⟨d₁, hd₁, hmin⟩ := hCc.exists_isMinOn hC hAc.continuousOn
        refine ⟨A d₁, lt_of_le_of_ne (hA0 d₁) fun h => ?_, fun d hd => hmin hd⟩
        obtain ⟨hgd, hℓd⟩ := hAeq d₁ h.symm
        have hBd : B d₁ = v ⬝ᵥ ζ p := by
          change v ⬝ᵥ g (lev p) d₁ - S.κ * ((lev p) - ℓ (lev p) d₁) * ∑ l, v l = _
          rw [hgd, hℓd, sub_self, mul_zero, zero_mul, sub_zero]
        have : B d₁ ≤ v ⬝ᵥ ζ p - η := hd₁
        have hη : 0 < η := by positivity
        linarith
    obtain ⟨M, hM⟩ := isCompact_univ.exists_bound_of_continuousOn hBc.continuousOn
    set W := |M| + |v ⬝ᵥ ζ p| + η + 1
    have hW : 0 < W := by positivity
    have hev : ∀ᶠ δ in 𝓝 (0 : ℝ), (∀ l, θ < (p + δ • v) l ∧ (p + δ • v) l < Θ) ∧
        δ * W < a := by
      refine (eventually_all.2 fun l => ?_).and ?_
      · have hcl : ContinuousAt (fun δ : ℝ => (p + δ • v) l) 0 := by
          simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
          exact (continuous_const.add (continuous_id.mul continuous_const)).continuousAt
        have hv0 : (p + (0 : ℝ) • v) l = p l := by simp
        exact (continuousAt_const.eventually_lt hcl (by rw [hv0]; exact (hK p hp l).1)).and
          (hcl.eventually_lt continuousAt_const (by rw [hv0]; exact (hK p hp l).2))
      · have hcl : ContinuousAt (fun δ : ℝ => δ * W) 0 :=
          (continuous_id.mul continuous_const).continuousAt
        exact hcl.eventually_lt continuousAt_const (by simpa using ha)
    obtain ⟨δ, ⟨hδbox, hδW⟩, hδpos⟩ := ((hev.filter_mono nhdsWithin_le_nhds).and
      (self_mem_nhdsWithin (s := Set.Ioi (0 : ℝ)))).exists
    have hδ : 0 < δ := hδpos
    have hsbox : p + δ • v ∈ smdBox S :=
      (mem_smdBox S).2 fun l => ⟨(hδbox l).1.le, (hδbox l).2.le⟩
    -- the support value at the tilted normal
    have hσ : δ * (v ⬝ᵥ ζ p - η) ≤ smdSigma S (p + δ • v) (lev p) := by
      obtain ⟨d, hd⟩ := smdSigma_eq S hg hℓ (p + δ • v) (lev p)
      rw [hd, hlin]
      by_cases hdC : d ∈ C
      · have h1 := haC d hdC
        have h2' : |B d| ≤ M := by simpa using hM d (Set.mem_univ d)
        have h2 : |B d| ≤ |M| := h2'.trans (le_abs_self M)
        have h3 : -(δ * |M|) ≤ δ * B d := by
          rw [← mul_neg]; exact mul_le_mul_of_nonneg_left (neg_le_of_abs_le h2) hδ.le
        have h4 : δ * (v ⬝ᵥ ζ p - η) ≤ δ * (|v ⬝ᵥ ζ p| + η + 1) := by
          refine mul_le_mul_of_nonneg_left ?_ hδ.le
          have : 0 ≤ η := by positivity
          linarith [le_abs_self (v ⬝ᵥ ζ p)]
        have h5 : δ * W = δ * |M| + δ * (|v ⬝ᵥ ζ p| + η + 1) := by simp only [W]; ring
        linarith
      · have h1 : v ⬝ᵥ ζ p - η < B d := lt_of_not_ge hdC
        have h2 := hA0 d
        nlinarith
    have hFle := smdF_le S hg hℓ hsbox z (lev p)
    have hsz : (p + δ • v) ⬝ᵥ z ≤ δ * (v ⬝ᵥ z) := by
      rw [add_dotProduct, smul_dotProduct, smul_eq_mul]; linarith
    have hkey : δ * (v ⬝ᵥ ζ p - η) ≤ δ * (v ⬝ᵥ z) := by linarith
    have hkey' : v ⬝ᵥ ζ p - η ≤ v ⬝ᵥ z := le_of_mul_le_mul_left hkey hδ
    have hvv' : v ⬝ᵥ v = v ⬝ᵥ ζ p - v ⬝ᵥ z := by rw [hv, dotProduct_sub]
    have : v ⬝ᵥ v ≤ η := by linarith
    simp only [η] at this
    linarith

end MWG.PositiveEquilibriumTheory
