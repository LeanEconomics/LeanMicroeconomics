import MWGPositiveEquilibriumTheory.SMDTheorem

/-!
# Exercises 17.E.4 and 17.E.5, footnote 31 (MWG pp. 603-604, 645)

* **Exercise 17.E.4**: the two-good function
  `z(p) = ((p₁ - p₂)/(p₁ + p₂)²) (p₂, -p₁)` is continuous, homogeneous of degree zero and
  satisfies Walras' law on `P_ε = {p ≫ 0 : ε < p₁/p₂ < 1/ε}` (`0 < ε < 1`), its offer curve
  passes through the endowment (`z(1, 1) = 0`), and it is not the excess demand of any single
  consumer with a utility function, whatever the consumption set and endowment: two of its
  values violate the weak axiom (`exercise_17_E_4`). This is why the proof of Proposition 17.E.3
  needs `zⁱ(p) ≠ 0` on `P_ε`.
* **Exercise 17.E.5** (Figure 17.E.3): if `z(p) = (-1, a)` and `z(p') = (b, -1)` with `p` steeper
  than `p'`, these choices cannot be decomposed among two consumers (as in Proposition 17.E.3
  for `L = 2`) with consumption sets `ℝ²_+` and endowments at most `(1, 1)`
  (`exercise_17_E_5`). With four consumers the weak-axiom obstruction disappears
  (`exercise_17_E_5_four`, a certificate; see `docs/corrections.md`).
* **Footnote 31**: a function on `P_ε` with no zero there is still an aggregate excess demand
  (`footnote_17_31`); the equilibria of the economy lie outside `P_ε`.
-/

namespace MWG.PositiveEquilibriumTheory

open MWG.ConsumerChoice MWG.ClassicalDemand MWG.GeneralEquilibriumExamples Filter Topology

/-- **Exercise 17.E.4** (MWG, p. 645). The excess demand
`z(p) = ((p₁ - p₂)/(p₁ + p₂)²) (p₂, -p₁)`. -/
noncomputable def ex17E4Z (p : Fin 2 → ℝ) : Fin 2 → ℝ :=
  ((p 0 - p 1) / (p 0 + p 1) ^ 2) • ![p 1, -p 0]

/-- **Exercise 17.E.4** (MWG, p. 645). The domain `{p ≫ 0 : ε < p₁/p₂ < 1/ε}`. -/
def ex17E4Dom (ε : ℝ) : Set (Fin 2 → ℝ) :=
  {p | 0 < p 0 ∧ 0 < p 1 ∧ ε < p 0 / p 1 ∧ p 0 / p 1 < 1 / ε}

/-- **Exercise 17.E.4** (MWG, p. 645). `z` is continuous, homogeneous of degree zero and
satisfies Walras' law on `{p ≫ 0}`, and `z(1, 1) = 0`. -/
theorem ex17E4Z_props :
    ContinuousOn ex17E4Z {p | 0 < p 0 ∧ 0 < p 1} ∧
    (∀ p : Fin 2 → ℝ, 0 < p 0 → 0 < p 1 → ∀ α : ℝ, 0 < α → ex17E4Z (α • p) = ex17E4Z p) ∧
    (∀ p : Fin 2 → ℝ, p ⬝ᵥ ex17E4Z p = 0) ∧ ex17E4Z ![1, 1] = 0 := by
  refine ⟨?_, fun p h0 h1 α hα => ?_, fun p => ?_, ?_⟩
  · have hden : ContinuousOn (fun p : Fin 2 → ℝ => (p 0 - p 1) / (p 0 + p 1) ^ 2)
        {p | 0 < p 0 ∧ 0 < p 1} :=
      ((continuous_apply 0).sub (continuous_apply 1)).continuousOn.div
        (((continuous_apply 0).add (continuous_apply 1)).pow 2).continuousOn
        fun p hp => by have := hp.1; have := hp.2; positivity
    have hv : Continuous fun p : Fin 2 → ℝ => (![p 1, -p 0] : Fin 2 → ℝ) := by
      refine continuous_pi fun l => ?_
      fin_cases l
      · exact continuous_apply 1
      · exact (continuous_apply 0).neg
    exact hden.smul hv.continuousOn
  · funext l
    fin_cases l <;> simp [ex17E4Z] <;> field_simp
  · simp [ex17E4Z, dotProduct, Fin.sum_univ_two]; ring
  · funext l; fin_cases l <;> simp [ex17E4Z]

/-- **Exercise 17.E.4** (MWG, p. 645). For `0 < ε < 1`, `z` is not generated by a single
consumer: there are no consumption set `X`, utility `u` and endowment `ω` whose demand at every
`p` of the domain is the single bundle `ω + z(p)` (two values of `z` violate the weak axiom). -/
theorem exercise_17_E_4 {ε : ℝ} (hε : 0 < ε) (hε1 : ε < 1) :
    ¬ ∃ (X : Set (Fin 2 → ℝ)) (u : (Fin 2 → ℝ) → ℝ) (ω : Fin 2 → ℝ),
      ∀ p ∈ ex17E4Dom ε, walrasianDemandOn X u p (p ⬝ᵥ ω) = {ω + ex17E4Z p} := by
  rintro ⟨X, u, ω, h⟩
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = (1 + 1 / ε) / 2 := ⟨_, rfl⟩
  have hinv : 1 < 1 / ε := by rw [lt_div_iff₀ hε]; linarith
  have ha1 : 1 < a := by rw [ha]; linarith
  have haε : a < 1 / ε := by rw [ha]; linarith
  have ha0 : 0 < a := by linarith
  have hεa : ε < 1 / a := by
    rw [lt_div_iff₀ ha0]
    have : ε * (1 / ε) = 1 := by field_simp
    nlinarith
  have hp : (![1, a] : Fin 2 → ℝ) ∈ ex17E4Dom ε := by
    refine ⟨by simp, by simp [ha0], ?_, ?_⟩
    · simpa using hεa
    · simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [div_lt_div_iff₀ ha0 hε]; nlinarith
  have hp' : (![a, 1] : Fin 2 → ℝ) ∈ ex17E4Dom ε := by
    refine ⟨by simp [ha0], by simp, ?_, ?_⟩
    · simpa using (lt_trans hε1 ha1)
    · simpa using haε
  have hd := h _ hp
  have hd' := h _ hp'
  set x := ω + ex17E4Z ![1, a]
  set x' := ω + ex17E4Z ![a, 1]
  have hx : x ∈ walrasianDemandOn X u ![1, a] (![1, a] ⬝ᵥ ω) := by rw [hd]; rfl
  have hx' : x' ∈ walrasianDemandOn X u ![a, 1] (![a, 1] ⬝ᵥ ω) := by rw [hd']; rfl
  have hden : 0 < (1 + a) ^ 2 := by positivity
  -- `x'` is affordable at `(1, a)` and `x` at `(a, 1)`
  have e1 : (![1, a] : Fin 2 → ℝ) ⬝ᵥ ex17E4Z ![a, 1] = (a - 1) / (a + 1) ^ 2 * (1 - a ^ 2) := by
    simp [ex17E4Z, dotProduct, Fin.sum_univ_two]; ring
  have e2 : (![a, 1] : Fin 2 → ℝ) ⬝ᵥ ex17E4Z ![1, a] = (1 - a) / (1 + a) ^ 2 * (a ^ 2 - 1) := by
    simp [ex17E4Z, dotProduct, Fin.sum_univ_two]; ring
  have hb1 : x' ∈ budgetSetOn X ![1, a] (![1, a] ⬝ᵥ ω) := by
    refine ⟨hx'.1.1, ?_⟩
    have : (![1, a] : Fin 2 → ℝ) ⬝ᵥ ex17E4Z ![a, 1] ≤ 0 := by
      rw [e1]
      exact mul_nonpos_of_nonneg_of_nonpos (div_nonneg (by linarith) (by positivity))
        (by nlinarith)
    rw [dotProduct_add]; linarith
  have hb2 : x ∈ budgetSetOn X ![a, 1] (![a, 1] ⬝ᵥ ω) := by
    refine ⟨hx.1.1, ?_⟩
    have : (![a, 1] : Fin 2 → ℝ) ⬝ᵥ ex17E4Z ![1, a] ≤ 0 := by
      rw [e2]
      exact mul_nonpos_of_nonpos_of_nonneg (div_nonpos_of_nonpos_of_nonneg (by linarith)
        (by positivity)) (by nlinarith)
    rw [dotProduct_add]; linarith
  have hne : x ≠ x' := by
    intro he
    have h0 := congrFun he 0
    simp only [x, x', Pi.add_apply, add_right_inj] at h0
    have f1 : ex17E4Z ![1, a] 0 = (1 - a) / (1 + a) ^ 2 * a := by simp [ex17E4Z]
    have f2 : ex17E4Z ![a, 1] 0 = (a - 1) / (a + 1) ^ 2 * 1 := by simp [ex17E4Z]
    rw [f1, f2] at h0
    have h1 : (1 - a) / (1 + a) ^ 2 * a < 0 :=
      mul_neg_of_neg_of_pos (div_neg_of_neg_of_pos (by linarith) hden) ha0
    have h2 : 0 < (a - 1) / (a + 1) ^ 2 * 1 := by
      rw [mul_one]; exact div_pos (by linarith) (by positivity)
    linarith
  have h1 := hx.2 x' hb1
  have h2 := hx'.2 x hb2
  have hx'd : x' ∈ walrasianDemandOn X u ![1, a] (![1, a] ⬝ᵥ ω) :=
    ⟨hb1, fun y hy => (hx.2 y hy).trans h2⟩
  rw [hd] at hx'd
  exact hne hx'd.symm

/-- **Exercise 17.E.5** (MWG, p. 645; Figure 17.E.3). Let `p, p' ≫ 0` with `p` steeper than `p'`
(`p₁/p₂ < p'₁/p'₂`), `z(p) = (-1, a) ∈ T_p` and `z(p') = (b, -1) ∈ T_{p'}`. No exchange economy with
two consumers, consumption sets `ℝ²_+`, endowments bounded above by `(1, 1)` and single-valued
demands at `p` and `p'` has these aggregate excess demands. -/
theorem exercise_17_E_5 {p p' : Fin 2 → ℝ} (hp : StrictlyPositive p) (hp' : StrictlyPositive p')
    (hslope : p 0 * p' 1 < p' 0 * p 1) {a b : ℝ} (hza : p ⬝ᵥ ![-1, a] = 0)
    (hzb : p' ⬝ᵥ ![b, -1] = 0) (E : ExchangeEconomy (Fin 2) 2)
    (hX : ∀ i, E.X i = nonnegOrthant 2) (hω : ∀ i l, E.ω i l ≤ 1)
    (hd : ∀ i, ∃ x, E.demand i p = {x}) (hd' : ∀ i, ∃ x, E.demand i p' = {x}) :
    ¬ (excessDemand E p = ![-1, a] ∧ excessDemand E p' = ![b, -1]) := by
  rintro ⟨hz, hz'⟩
  simp only [dotProduct, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at hza hzb
  have hp0 := hp 0
  have hp1 := hp 1
  have hp0' := hp' 0
  have hp1' := hp' 1
  choose x hx using hd
  choose x' hx' using hd'
  have hxm : ∀ i, x i ∈ E.demand i p := fun i => by rw [hx i]; rfl
  have hxm' : ∀ i, x' i ∈ E.demand i p' := fun i => by rw [hx' i]; rfl
  have hdf : ∀ i, demandFn E i p = x i := fun i => demandFn_eq E (hx i)
  have hdf' : ∀ i, demandFn E i p' = x' i := fun i => demandFn_eq E (hx' i)
  -- excess demands
  set z := fun i => x i - E.ω i
  set z' := fun i => x' i - E.ω i
  have hsum : ∀ l, z 0 l + z 1 l = ![-1, a] l := by
    intro l
    rw [← hz, excessDemand_apply, Fin.sum_univ_two, hdf, hdf]
    rfl
  have hsum' : ∀ l, z' 0 l + z' 1 l = ![b, -1] l := by
    intro l
    rw [← hz', excessDemand_apply, Fin.sum_univ_two, hdf', hdf']
    rfl
  -- affordability: `p·zᵢ ≤ 0`, hence `= 0`
  have haff : ∀ i, p 0 * z i 0 + p 1 * z i 1 ≤ 0 := by
    intro i
    have := (hxm i).1.2
    simp only [dotProduct, Fin.sum_univ_two] at this
    simp only [z, Pi.sub_apply]; linarith
  have haff' : ∀ i, p' 0 * z' i 0 + p' 1 * z' i 1 ≤ 0 := by
    intro i
    have := (hxm' i).1.2
    simp only [dotProduct, Fin.sum_univ_two] at this
    simp only [z', Pi.sub_apply]; linarith
  have hs0 := hsum 0
  have hs1 := hsum 1
  have hs0' := hsum' 0
  have hs1' := hsum' 1
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hs0 hs1 hs0' hs1'
  have hW : ∀ i, p 0 * z i 0 + p 1 * z i 1 = 0 := by
    have h0 := haff 0
    have h1 := haff 1
    intro i
    fin_cases i <;> simp <;> nlinarith
  have hW' : ∀ i, p' 0 * z' i 0 + p' 1 * z' i 1 = 0 := by
    have h0 := haff' 0
    have h1 := haff' 1
    intro i
    fin_cases i <;> simp <;> nlinarith
  -- bounds `αᵢ = -zᵢ₁(p) ≤ 1`, `βᵢ = -z'ᵢ₂ ≤ 1`
  have hbd : ∀ i, -1 ≤ z i 0 := by
    intro i
    have h1 := (hxm i).1.1
    rw [hX i] at h1
    have := hω i 0
    simp only [z, Pi.sub_apply]; linarith [h1 0]
  have hbd' : ∀ i, -1 ≤ z' i 1 := by
    intro i
    have h1 := (hxm' i).1.1
    rw [hX i] at h1
    have := hω i 1
    simp only [z', Pi.sub_apply]; linarith [h1 1]
  have hα : ∀ i, z i 0 ≤ 0 := by
    intro i; fin_cases i
    · have := hbd 1; simp at this ⊢; linarith
    · have := hbd 0; simp at this ⊢; linarith
  have hβ : ∀ i, z' i 1 ≤ 0 := by
    intro i; fin_cases i
    · have := hbd' 1; simp at this ⊢; linarith
    · have := hbd' 0; simp at this ⊢; linarith
  -- each consumer's two choices are affordable at the other price, hence equal
  have heq : ∀ i, z i = z' i := by
    intro i
    have hb1 : x' i ∈ budgetSetOn (E.X i) p (p ⬝ᵥ E.ω i) := by
      refine ⟨(hxm' i).1.1, ?_⟩
      have hz1 : z' i 0 = -(p' 1 / p' 0) * z' i 1 := by
        have := hW' i; field_simp; linarith
      have hneg : p 0 * (p' 1 / p' 0) - p 1 ≤ 0 := by
        rw [mul_div_assoc', div_sub' hp0'.ne', div_nonpos_iff]
        right; constructor <;> nlinarith
      have hz'x : x' i = z' i + E.ω i := by simp [z']
      have : p 0 * z' i 0 + p 1 * z' i 1 ≤ 0 := by
        rw [hz1]
        have := hβ i
        nlinarith
      rw [hz'x, dotProduct_add]
      simp only [dotProduct, Fin.sum_univ_two] at this ⊢
      linarith
    have hb2 : x i ∈ budgetSetOn (E.X i) p' (p' ⬝ᵥ E.ω i) := by
      refine ⟨(hxm i).1.1, ?_⟩
      have hz1 : z i 1 = -(p 0 / p 1) * z i 0 := by
        have := hW i; field_simp; linarith
      have hzx : x i = z i + E.ω i := by simp [z]
      have : p' 0 * z i 0 + p' 1 * z i 1 ≤ 0 := by
        rw [hz1]
        have := hα i
        have hk : 0 ≤ p' 0 - p' 1 * (p 0 / p 1) := by
          rw [mul_div_assoc', sub_div' hp1.ne', le_div_iff₀ hp1]; nlinarith
        nlinarith
      rw [hzx, dotProduct_add]
      simp only [dotProduct, Fin.sum_univ_two] at this ⊢
      linarith
    have h1 := (hxm i).2 _ hb1
    have h2 := (hxm' i).2 _ hb2
    have hmem : x' i ∈ E.demand i p := ⟨hb1, fun y hy => ((hxm i).2 y hy).trans h2⟩
    rw [hx i] at hmem
    have : x' i = x i := hmem
    simp only [z, z', this]
  -- then both choices vanish: `αᵢ (-1, a) = βᵢ (b, -1)` with `αᵢ, βᵢ ≥ 0`
  have hzero : ∀ i, z i 0 = 0 := by
    intro i
    have e0 := congrFun (heq i) 0
    have e1 := congrFun (heq i) 1
    have hA : z i 1 = -(p 0 / p 1) * z i 0 := by have := hW i; field_simp; linarith
    have hB : z' i 0 = -(p' 1 / p' 0) * z' i 1 := by have := hW' i; field_simp; linarith
    have hprod : z i 0 * (1 - (p' 1 / p' 0) * (p 0 / p 1)) = 0 := by
      linear_combination e0 + hB + (p' 1 / p' 0) * e1 - (p' 1 / p' 0) * hA
    have hk : (p' 1 / p' 0) * (p 0 / p 1) < 1 := by
      rw [div_mul_div_comm, div_lt_one (by positivity)]; nlinarith
    exact (mul_eq_zero.1 hprod).resolve_right (by linarith)
  have := hzero 0
  have := hzero 1
  linarith

/-- **Exercise 17.E.5** (MWG, p. 645), the four-consumer remark: with four consumers the shares
`αᵢ` of `z(p)` and `βᵢ` of `z(p')` can be `(1, 1, -1/2, -1/2)` and `(-1/2, -1/2, 1, 1)`. They
satisfy every constraint used in `exercise_17_E_5` (sums `1`, bounds `αᵢ, βᵢ ≤ 1` from
endowments `≤ (1, 1)`), and for each consumer one share is negative, so that neither choice is
affordable at the other price and the weak axiom is not violated. -/
theorem exercise_17_E_5_four :
    let α : Fin 4 → ℝ := ![1, 1, -1/2, -1/2]
    let β : Fin 4 → ℝ := ![-1/2, -1/2, 1, 1]
    ∑ i, α i = 1 ∧ ∑ i, β i = 1 ∧ (∀ i, α i ≤ 1 ∧ β i ≤ 1) ∧ ∀ i, α i < 0 ∨ β i < 0 := by
  refine ⟨?_, ?_, fun i => ?_, fun i => ?_⟩
  · norm_num [Fin.sum_univ_four]
  · norm_num [Fin.sum_univ_four]
  · fin_cases i <;> norm_num
  · fin_cases i <;> norm_num

/-- **Footnote 31** (MWG, p. 603). A function `z` on `P_ε` (two goods) without any zero in
`P_ε`, namely `z(p) = (p₂, -p₁)/(p₁ + p₂)`, is nevertheless the aggregate excess demand on `P_ε`
of an economy (Proposition 17.E.3); its equilibria lie outside `P_ε`. -/
theorem footnote_17_31 {ε : ℝ} (hε : 0 < ε) :
    ∃ z : (Fin 2 → ℝ) → Fin 2 → ℝ, (∀ p ∈ pEps 2 ε, z p ≠ 0) ∧
      ∃ E : ExchangeEconomy (Fin 2) 2, (∀ i, E.X i = nonnegOrthant 2) ∧
        ∀ p ∈ pEps 2 ε, excessDemand E p = z p := by
  set z : (Fin 2 → ℝ) → Fin 2 → ℝ := fun p => (p 0 + p 1)⁻¹ • ![p 1, -p 0] with hzdef
  have hpos : ∀ p ∈ pEps 2 ε, 0 < p 0 + p 1 := fun p hp => by
    have := pEps_pos hε hp 0; have := pEps_pos hε hp 1; positivity
  have hc : ContinuousOn z (pEps 2 ε) := by
    have hv : Continuous fun p : Fin 2 → ℝ => (![p 1, -p 0] : Fin 2 → ℝ) := by
      refine continuous_pi fun l => ?_
      fin_cases l
      · exact continuous_apply 1
      · exact (continuous_apply 0).neg
    exact (((continuous_apply 0).add (continuous_apply 1)).continuousOn.inv₀
      fun p hp => (hpos p hp).ne').smul hv.continuousOn
  have hH : ∀ p ∈ pEps 2 ε, ∀ α : ℝ, 0 < α → z (α • p) = z p := by
    intro p hp α hα
    have := hpos p hp
    funext l
    fin_cases l <;> simp [hzdef] <;> field_simp
  have hW : ∀ p ∈ pEps 2 ε, p ⬝ᵥ z p = 0 := by
    intro p _
    simp [hzdef, dotProduct, Fin.sum_univ_two]; ring
  obtain ⟨E, hX, -, -, hE⟩ := proposition_17_E_3 hε hc hH hW
  refine ⟨z, fun p hp h0 => ?_, E, hX, fun p hp => (hE p hp).2⟩
  have := congrFun h0 0
  simp only [hzdef, Pi.smul_apply, smul_eq_mul, Matrix.cons_val_zero, Pi.zero_apply] at this
  have h1 := pEps_pos hε hp 1
  have h2 := hpos p hp
  rcases mul_eq_zero.1 this with h | h
  · exact (inv_pos.2 h2).ne' h
  · linarith

end MWG.PositiveEquilibriumTheory
