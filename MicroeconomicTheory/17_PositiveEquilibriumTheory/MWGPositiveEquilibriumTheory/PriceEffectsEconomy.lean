import MWGPositiveEquilibriumTheory.PriceEffects

/-!
# Any admissible matrix of price effects is generated by an economy (MWG pp. 599-601)

**Proposition 17.E.2**: given `p ≫ 0`, `z ∈ ℝ^L` and an `L × L` matrix `A` with `p·z = 0`,
`A p = 0` and `p·A = -z`, there are `L` consumers whose aggregate excess demand has
`z(p) = z` and `Dz(p) = A` (`proposition_17_E_2`).

The book's consumers have a vertex at their demanded point (null substitution matrix) and the
wealth-effect vector `(1/pᵢ)eⁱ`. We make them explicit (this is **Exercise 17.E.3**): consumer
`i` has the utility
`uᵢ(x) = p·(x - x̄) - c ∑_{k ≠ i} |xₖ - x̄ₖ|`, `0 < c < minₖ pₖ` (`kinkUtility`),
continuous and strongly monotone on `ℝ^L_+`, whose indifference sets have a ridge along
`x̄ + ℝ eⁱ`. At every price `p'` near `p` its demand is the single bundle
`x̄ + ((w - p'·x̄)/p'ᵢ) eⁱ` (`kink_demand`): wealth effect `(1/p'ᵢ) eⁱ` and null substitution
matrix, as in the book. With `x̄ = R𝟙` and `ωᵢ = R𝟙 + pᵢ aⁱ` (`aⁱ` the `i`-th row of `A`, `R`
large) we get `zᵢ(p') = pᵢ (p'·aⁱ / p'ᵢ) eⁱ - pᵢ aⁱ` near `p`, so `z(p) = -p·A = z` and
`Dz(p) = ∑ᵢ eⁱ aⁱ = A`.

**Footnote 24** ("`z(p)` can take any value") holds exactly for the values with `p·z = 0`
(`footnote_17_24`); a demanded bundle always satisfies `p·z ≤ 0` (`footnote_17_24_necessary`),
so a value with `p·z > 0` is impossible.
-/

namespace MWG.PositiveEquilibriumTheory

open MWG.ConsumerChoice MWG.ClassicalDemand MWG.GeneralEquilibriumExamples Filter Topology

variable {L : ℕ}

/-- **Exercise 17.E.3** (MWG, p. 645). The kinked utility
`u(x) = q·(x - x̄) - c ∑ₖ mₖ |xₖ - x̄ₖ|`. -/
def kinkUtility (q xb m : Fin L → ℝ) (c : ℝ) (x : Fin L → ℝ) : ℝ :=
  q ⬝ᵥ (x - xb) - c * ∑ k, m k * |x k - xb k|

theorem kinkUtility_continuous (q xb m : Fin L → ℝ) (c : ℝ) :
    Continuous (kinkUtility q xb m c) := by
  unfold kinkUtility dotProduct
  fun_prop

/-- The kinked utility is strongly monotone when `c mₖ < qₖ` for every `k`. -/
theorem kinkUtility_stronglyMonotone {q xb m : Fin L → ℝ} {c : ℝ} (hc : 0 ≤ c)
    (hm : ∀ k, 0 ≤ m k) (hq : ∀ k, c * m k < q k) :
    UtilityStronglyMonotone (kinkUtility q xb m c) := by
  intro x _ y _ hxy hne
  have hlt : kinkUtility q xb m c x < kinkUtility q xb m c y := by
    have hdiff : kinkUtility q xb m c y - kinkUtility q xb m c x =
        ∑ k, (q k * (y k - x k) - c * (m k * |y k - xb k|) + c * (m k * |x k - xb k|)) := by
      simp only [kinkUtility, dotProduct, Pi.sub_apply, Finset.mul_sum,
        ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun k _ => by ring
    have hterm : ∀ k, (q k - c * m k) * (y k - x k) ≤
        q k * (y k - x k) - c * (m k * |y k - xb k|) + c * (m k * |x k - xb k|) := by
      intro k
      have h1 : |y k - xb k| - |x k - xb k| ≤ y k - x k := by
        have := abs_sub_abs_le_abs_sub (y k - xb k) (x k - xb k)
        rw [show y k - xb k - (x k - xb k) = y k - x k by ring,
          abs_of_nonneg (sub_nonneg.2 (hxy k))] at this
        exact this
      have h2 := mul_le_mul_of_nonneg_left h1 (mul_nonneg hc (hm k))
      nlinarith
    obtain ⟨k, hk⟩ : ∃ k, x k < y k := by
      by_contra h
      push Not at h
      exact hne (le_antisymm (fun k => h k) hxy)
    have hpos : 0 < ∑ k, (q k - c * m k) * (y k - x k) := by
      refine Finset.sum_pos' (fun j _ => mul_nonneg (sub_nonneg.2 (hq j).le)
        (sub_nonneg.2 (hxy j))) ⟨k, Finset.mem_univ k, mul_pos (sub_pos.2 (hq k))
        (sub_pos.2 hk)⟩
    have := Finset.sum_le_sum fun k (_ : k ∈ Finset.univ) => hterm k
    linarith
  exact ⟨hlt.le, not_le.2 hlt⟩

/-- **Exercise 17.E.3** (MWG, p. 645), the demand of the kinked utility. Let `p ≫ 0`, `qᵢ > 0`,
`mᵢ = 0`, and for `k ≠ i`: `mₖ = 1` and `|qₖ - qᵢ pₖ/pᵢ| < c`. If
`x* = x̄ + ((w - p·x̄)/pᵢ) eⁱ ∈ ℝ^L_+`, the demand at `(p, w)` is exactly `{x*}`. -/
theorem kink_demand {q xb m p : Fin L → ℝ} {c w : ℝ} {i : Fin L} (hp : StrictlyPositive p)
    (hqi : 0 < q i) (hmi : m i = 0)
    (hγ : ∀ k, k ≠ i → m k = 1 ∧ |q k - q i * p k / p i| < c)
    (hx : xb + ((w - p ⬝ᵥ xb) / p i) • Pi.single i 1 ∈ nonnegOrthant L) :
    walrasianDemandOn (nonnegOrthant L) (kinkUtility q xb m c) p w =
      {xb + ((w - p ⬝ᵥ xb) / p i) • Pi.single i 1} := by
  set t := (w - p ⬝ᵥ xb) / p i with ht
  set xs := xb + t • (Pi.single i 1 : Fin L → ℝ) with hxs
  have hpi := hp i
  have hbud : p ⬝ᵥ xs = w := by
    rw [hxs, dotProduct_add, dotProduct_smul, dotProduct_single, mul_one, smul_eq_mul, ht]
    field_simp
    ring
  -- the comparison with any affordable bundle
  have key : ∀ y, p ⬝ᵥ y ≤ w → kinkUtility q xb m c y ≤ kinkUtility q xb m c xs ∧
      (kinkUtility q xb m c xs ≤ kinkUtility q xb m c y → y = xs) := by
    intro y hy
    set d := y - xs with hd
    have hpd : p ⬝ᵥ d ≤ 0 := by rw [hd, dotProduct_sub, hbud]; linarith
    set γ : Fin L → ℝ := fun k => q k - q i * p k / p i with hγdef
    have hγi : γ i = 0 := by simp only [hγdef]; field_simp; ring
    have hxsk : ∀ k, k ≠ i → xs k = xb k := by
      intro k hk; simp [hxs, hk]
    have habs : ∀ k, m k * |y k - xb k| - m k * |xs k - xb k| = m k * |d k| := by
      intro k
      by_cases hk : k = i
      · subst hk; rw [hmi]; ring
      · rw [hxsk k hk, sub_self, abs_zero, mul_zero, sub_zero, hd, Pi.sub_apply, hxsk k hk]
    have hdiff : kinkUtility q xb m c y - kinkUtility q xb m c xs =
        q ⬝ᵥ d - c * ∑ k, m k * |d k| := by
      simp only [kinkUtility]
      rw [← Finset.sum_congr rfl fun k _ => habs k, Finset.sum_sub_distrib, hd,
        dotProduct_sub, dotProduct_sub, dotProduct_sub]
      ring
    have hqd : q ⬝ᵥ d ≤ ∑ k, γ k * d k := by
      have hid : q ⬝ᵥ d = ∑ k, γ k * d k + q i / p i * (p ⬝ᵥ d) := by
        simp only [hγdef, dotProduct, Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun k _ => ?_
        field_simp
        ring
      rw [hid]
      have : q i / p i * (p ⬝ᵥ d) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (by positivity) hpd
      linarith
    have hterm : ∀ k, γ k * d k - c * (m k * |d k|) ≤ 0 := by
      intro k
      by_cases hk : k = i
      · subst hk; rw [hγi, hmi]; simp
      · obtain ⟨hmk, hγk⟩ := hγ k hk
        rw [hmk, one_mul]
        have h1 : γ k * d k ≤ |γ k| * |d k| := by
          rw [← abs_mul]; exact le_abs_self _
        have h2 : |γ k| * |d k| ≤ c * |d k| :=
          mul_le_mul_of_nonneg_right hγk.le (abs_nonneg _)
        linarith
    have hsum : kinkUtility q xb m c y - kinkUtility q xb m c xs ≤
        ∑ k, (γ k * d k - c * (m k * |d k|)) := by
      rw [hdiff, Finset.sum_sub_distrib, ← Finset.mul_sum]
      linarith
    have hnp : ∑ k, (γ k * d k - c * (m k * |d k|)) ≤ 0 :=
      Finset.sum_nonpos fun k _ => hterm k
    refine ⟨by linarith, fun hge => ?_⟩
    have h0 : ∑ k, (γ k * d k - c * (m k * |d k|)) = 0 := le_antisymm hnp (by linarith)
    have hall := (Finset.sum_eq_zero_iff_of_nonpos fun k _ => hterm k).1 h0
    have hdk : ∀ k, k ≠ i → d k = 0 := by
      intro k hk
      obtain ⟨hmk, hγk⟩ := hγ k hk
      have e := hall k (Finset.mem_univ k)
      rw [hmk, one_mul] at e
      by_contra hne
      have hpos : 0 < |d k| := abs_pos.2 hne
      have h1 : γ k * d k ≤ |γ k| * |d k| := by rw [← abs_mul]; exact le_abs_self _
      have h2 : |γ k| * |d k| < c * |d k| := mul_lt_mul_of_pos_right hγk hpos
      linarith
    have hmd : ∑ k, m k * |d k| = 0 := by
      refine Finset.sum_eq_zero fun k _ => ?_
      by_cases hk : k = i
      · subst hk; rw [hmi, zero_mul]
      · rw [hdk k hk, abs_zero, mul_zero]
    have hdot : ∀ v : Fin L → ℝ, v ⬝ᵥ d = v i * d i := by
      intro v
      rw [dotProduct, Finset.sum_eq_single i (fun k _ hk => by rw [hdk k hk, mul_zero])
        (by simp)]
    have hqd' : 0 ≤ q i * d i := by
      rw [← sub_nonneg, hdiff, hmd, mul_zero, sub_zero] at hge
      rw [← hdot]; exact hge
    have hpd' : p i * d i ≤ 0 := by rw [← hdot]; exact hpd
    have hdi : d i = 0 := by
      rcases lt_trichotomy (d i) 0 with h | h | h
      · nlinarith
      · exact h
      · nlinarith
    have hd0 : d = 0 := by
      funext k
      by_cases hk : k = i
      · subst hk; exact hdi
      · exact hdk k hk
    rw [hd] at hd0
    exact sub_eq_zero.1 hd0
  ext y
  simp only [Set.mem_singleton_iff]
  constructor
  · rintro ⟨hyb, hmax⟩
    exact (key y hyb.2).2 (hmax xs ⟨hx, hbud.le⟩)
  · rintro rfl
    exact ⟨⟨hx, hbud.le⟩, fun y hy => (key y hy.2).1⟩

/-- **Footnote 24** (MWG, p. 599), necessity: a demanded bundle `ω + z` satisfies `p·z ≤ 0`, so
`z(p)` cannot take a value with `p·z > 0`. -/
theorem footnote_17_24_necessary {X : Set (Fin L → ℝ)} {u : (Fin L → ℝ) → ℝ}
    {p ω z : Fin L → ℝ} (h : ω + z ∈ walrasianDemandOn X u p (p ⬝ᵥ ω)) : p ⬝ᵥ z ≤ 0 := by
  have := h.1.2
  rw [dotProduct_add] at this
  linarith

/-- **Footnote 24** (MWG, p. 599). For `p ≫ 0` and any `z` with `p·z = 0`, a single consumer with
consumption set `ℝ^L_+`, an endowment `ω ≫ 0` with `ω + z ≫ 0`, and a continuous strongly
monotone utility (`kinkUtility`) demands exactly `ω + z` at `p`. -/
theorem footnote_17_24 {p z : Fin L → ℝ} (hp : StrictlyPositive p) (hz : p ⬝ᵥ z = 0)
    (i : Fin L) : ∃ (ω : Fin L → ℝ) (u : (Fin L → ℝ) → ℝ), StrictlyPositive ω ∧
      StrictlyPositive (ω + z) ∧ Continuous u ∧ UtilityStronglyMonotone u ∧
      walrasianDemandOn (nonnegOrthant L) u p (p ⬝ᵥ ω) = {ω + z} := by
  set R : ℝ := 1 + ∑ k, |z k| with hR
  have hzk : ∀ k, |z k| ≤ ∑ k, |z k| := fun k =>
    Finset.single_le_sum (f := fun k => |z k|) (fun _ _ => abs_nonneg _) (Finset.mem_univ k)
  have hR0 : 0 ≤ ∑ k, |z k| := Finset.sum_nonneg fun _ _ => abs_nonneg _
  set c : ℝ := p i / 2 * (∑ k, (p k)⁻¹)⁻¹ * (p i)⁻¹ with hc
  have hsum : (p i)⁻¹ ≤ ∑ k, (p k)⁻¹ := Finset.single_le_sum (f := fun k => (p k)⁻¹)
    (fun k _ => (inv_pos.2 (hp k)).le) (Finset.mem_univ i)
  have hspos : 0 < ∑ k, (p k)⁻¹ := lt_of_lt_of_le (inv_pos.2 (hp i)) hsum
  have hcpos : 0 < c := by rw [hc]; have := hp i; positivity
  have hck : ∀ k, c < p k := by
    intro k
    have hk : (p k)⁻¹ ≤ ∑ k, (p k)⁻¹ := Finset.single_le_sum (f := fun k => (p k)⁻¹)
      (fun k _ => (inv_pos.2 (hp k)).le) (Finset.mem_univ k)
    have hpk := hp k
    have hpi := hp i
    have h1 : (∑ k, (p k)⁻¹)⁻¹ ≤ p k := by
      rw [inv_le_comm₀ hspos hpk]; exact hk
    rw [hc]
    calc p i / 2 * (∑ k, (p k)⁻¹)⁻¹ * (p i)⁻¹ = (∑ k, (p k)⁻¹)⁻¹ / 2 := by field_simp
      _ < p k := by linarith [inv_pos.2 hspos]
  set m : Fin L → ℝ := fun k => if k = i then 0 else 1 with hm
  refine ⟨fun _ => R, kinkUtility p ((fun _ => R) + z) m c, fun _ => by positivity,
    fun k => ?_, kinkUtility_continuous _ _ _ _,
    kinkUtility_stronglyMonotone hcpos.le (fun k => by simp only [hm]; split_ifs <;> norm_num)
      (fun k => by simp only [hm]; split_ifs <;> [simp [hp k]; simpa using hck k]), ?_⟩
  · have := neg_abs_le (z k); simp only [Pi.add_apply]; linarith [hzk k]
  · have ht : (p ⬝ᵥ (fun _ => R) - p ⬝ᵥ ((fun _ => R) + z)) / p i = 0 := by
      rw [dotProduct_add, hz]; simp
    have hdem := kink_demand (q := p) (xb := (fun _ => R) + z) (m := m) (c := c)
      (w := p ⬝ᵥ fun _ => R) hp (hp i) (by simp [hm])
      (fun k hk => ⟨by simp [hm, hk], by
        rw [show p k - p i * p k / p i = 0 by field_simp [(hp i).ne']; ring, abs_zero]
        exact hcpos⟩)
      (by
        rw [ht, zero_smul, add_zero]
        intro k
        have := neg_abs_le (z k); simp only [Pi.add_apply]; linarith [hzk k])
    rw [hdem, ht, zero_smul, add_zero]

/-- **Proposition 17.E.2** (MWG, p. 600). Given `p ≫ 0`, `z ∈ ℝ^L` and an `L × L` matrix `A` with
`p·z = 0`, `A p = 0` and `p·A = -z`, there is an exchange economy with `L` consumers
(consumption sets `ℝ^L_+`, endowments `ωᵢ ≫ 0`, continuous strongly monotone utilities) whose
aggregate excess demand satisfies `z(p) = z` and is differentiable at `p` with `Dz(p) = A`
(indeed strictly differentiable, as the implicit function theorem of Section 17.G needs). -/
theorem proposition_17_E_2 {p z : Fin L → ℝ} (hp : StrictlyPositive p)
    (A : Matrix (Fin L) (Fin L) ℝ) (_hz : p ⬝ᵥ z = 0) (hA : A.mulVec p = 0)
    (hpA : Matrix.vecMul p A = -z) :
    ∃ E : ExchangeEconomy (Fin L) L, (∀ i, E.X i = nonnegOrthant L) ∧
      (∀ i, StrictlyPositive (E.ω i)) ∧
      (∀ i, Continuous (E.u i) ∧ UtilityStronglyMonotone (E.u i)) ∧
      excessDemand E p = z ∧
      ∃ D : (Fin L → ℝ) →L[ℝ] (Fin L → ℝ), HasStrictFDerivAt (excessDemand E) D p ∧
        ∀ v, D v = A.mulVec v := by
  classical
  set R : ℝ := 1 + ∑ i, ∑ k, |p i * A i k| with hR
  have hR0 : ∀ i k, |p i * A i k| ≤ R - 1 := by
    intro i k
    have h1 : |p i * A i k| ≤ ∑ k, |p i * A i k| := Finset.single_le_sum
      (f := fun k => |p i * A i k|) (fun _ _ => abs_nonneg _) (Finset.mem_univ k)
    have h2 : ∑ k, |p i * A i k| ≤ ∑ i, ∑ k, |p i * A i k| := Finset.single_le_sum
      (f := fun i => ∑ k, |p i * A i k|) (fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _)
      (Finset.mem_univ i)
    rw [hR]; linarith
  set c : ℝ := (∑ k, (p k)⁻¹)⁻¹ / 2 with hc
  have hck : ∀ k, 0 < c ∧ c < p k := by
    intro k
    have hk : (p k)⁻¹ ≤ ∑ k, (p k)⁻¹ := Finset.single_le_sum (f := fun k => (p k)⁻¹)
      (fun k _ => (inv_pos.2 (hp k)).le) (Finset.mem_univ k)
    have hspos : 0 < ∑ k, (p k)⁻¹ := lt_of_lt_of_le (inv_pos.2 (hp k)) hk
    have h1 : (∑ k, (p k)⁻¹)⁻¹ ≤ p k := by rw [inv_le_comm₀ hspos (hp k)]; exact hk
    have := inv_pos.2 hspos
    constructor <;> rw [hc] <;> linarith
  set xb : Fin L → ℝ := fun _ => R with hxb
  set ω : Fin L → Fin L → ℝ := fun i => xb + p i • A i with hω
  set m : Fin L → Fin L → ℝ := fun i k => if k = i then 0 else 1 with hm
  let E : ExchangeEconomy (Fin L) L :=
    ExchangeEconomy.ofOrthant (fun i => kinkUtility p xb (m i) c) ω
  have hωpos : ∀ i, StrictlyPositive (ω i) := by
    intro i k
    have := neg_abs_le (p i * A i k)
    simp only [hω, hxb, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    linarith [hR0 i k]
  -- the demand near `p`
  set t : Fin L → (Fin L → ℝ) → ℝ := fun i p' => p i * (A i ⬝ᵥ p') / p' i with htdef
  have hAi : ∀ i, A i ⬝ᵥ p = 0 := fun i => congrFun hA i
  have hev : ∀ᶠ p' in 𝓝 p, StrictlyPositive p' ∧
      (∀ i k, |p k - p i * p' k / p' i| < c) ∧ (∀ i, 0 < R + t i p') := by
    refine (eventually_all.2 fun k => ?_).and ((eventually_all.2 fun i =>
      eventually_all.2 fun k => ?_).and (eventually_all.2 fun i => ?_))
    · exact continuousAt_const.eventually_lt (continuous_apply k).continuousAt (hp k)
    · have hcont : ContinuousAt (fun p' : Fin L → ℝ => |p k - p i * p' k / p' i|) p := by
        have hq : ContinuousAt (fun p' : Fin L → ℝ => p' k / p' i) p :=
          (continuous_apply k).continuousAt.div (continuous_apply i).continuousAt (hp i).ne'
        have := ((continuousAt_const (y := p k)).sub
          ((continuousAt_const (y := p i)).mul hq)).abs
        simp only [mul_div_assoc]
        exact this
      refine hcont.eventually_lt continuousAt_const ?_
      rw [show p k - p i * p k / p i = 0 by field_simp [(hp i).ne']; ring, abs_zero]
      exact (hck k).1
    · have hcont : ContinuousAt (fun p' : Fin L → ℝ => R + t i p') p := by
        simp only [htdef, dotProduct]
        refine continuousAt_const.add ((continuousAt_const.mul ?_).div
          (continuous_apply i).continuousAt (hp i).ne')
        exact (continuous_finsetSum _ fun k _ =>
          continuous_const.mul (continuous_apply k)).continuousAt
      refine continuousAt_const.eventually_lt hcont ?_
      simp only [htdef, hAi, mul_zero, zero_div, add_zero]
      linarith [abs_nonneg (p i * A i i), hR0 i i]
  have hdem : ∀ p', StrictlyPositive p' → (∀ i k, |p k - p i * p' k / p' i| < c) →
      (∀ i, 0 < R + t i p') → ∀ i, demandFn E i p' = xb + t i p' • Pi.single i 1 := by
    intro p' hp' hγ hR' i
    have hwt : (p' ⬝ᵥ ω i - p' ⬝ᵥ xb) / p' i = t i p' := by
      simp only [hω, htdef, dotProduct_add, dotProduct_smul, smul_eq_mul, add_sub_cancel_left,
        dotProduct_comm p' (A i)]
    apply demandFn_eq
    have := kink_demand (q := p) (xb := xb) (m := m i) (c := c) (w := p' ⬝ᵥ ω i) (i := i) hp'
      (hp i) (by simp [hm]) (fun k hk => ⟨by simp [hm, hk], hγ i k⟩) (by
        rw [hwt]
        intro k
        by_cases hk : k = i
        · subst hk
          have h := hR' k
          simp only [hxb, Pi.add_apply, Pi.smul_apply, Pi.single_eq_same, smul_eq_mul, mul_one]
          linarith
        · simp [hxb, hk]; linarith [hR0 i i, abs_nonneg (p i * A i i)])
    rw [hwt] at this
    exact this
  -- the excess demand near `p`
  set G : (Fin L → ℝ) → Fin L → ℝ := fun p' l => t l p' + z l with hG
  have hEG : excessDemand E =ᶠ[𝓝 p] G := by
    filter_upwards [hev] with p' hp'
    funext l
    rw [excessDemand_apply]
    have hz' : z l = -∑ i, p i * A i l := by
      have := congrFun hpA l
      simp only [Matrix.vecMul, dotProduct, Pi.neg_apply] at this
      linarith
    have hterm : ∀ i, demandFn E i p' l - E.ω i l =
        t i p' * (Pi.single i (1 : ℝ) : Fin L → ℝ) l - p i * A i l := by
      intro i
      rw [hdem p' hp'.1 hp'.2.1 hp'.2.2 i]
      change (xb + t i p' • (Pi.single i 1 : Fin L → ℝ)) l - (xb + p i • A i) l = _
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      ring
    rw [Finset.sum_congr rfl fun i _ => hterm i, Finset.sum_sub_distrib]
    change _ = t l p' + z l
    rw [hz']
    simp only [Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
      Finset.mem_univ, ↓reduceIte]
    ring
  have hGp : G p = z := by
    funext l; simp [hG, htdef, hAi]
  -- the derivative
  let D : (Fin L → ℝ) →L[ℝ] (Fin L → ℝ) := LinearMap.toContinuousLinearMap (Matrix.mulVecLin A)
  have hD : ∀ v, D v = A.mulVec v := fun v => rfl
  have hGd : HasStrictFDerivAt G D p := by
    rw [hasStrictFDerivAt_pi']
    intro l
    have hg : HasStrictFDerivAt (fun p' : Fin L → ℝ => p l * (A l ⬝ᵥ p'))
        (p l • pe_dotCLM (A l)) p := by
      have : (fun p' : Fin L → ℝ => p l * (A l ⬝ᵥ p')) = p l • pe_dotCLM (A l) := by
        funext p'
        simp [pe_dotCLM_apply, dotProduct_comm]
      rw [this]
      exact (p l • pe_dotCLM (A l)).hasStrictFDerivAt
    have hh : HasStrictFDerivAt (fun p' : Fin L → ℝ => (p' l)⁻¹)
        ((ContinuousLinearMap.toSpanSingleton ℝ (-(p l ^ 2)⁻¹)).comp
          (ContinuousLinearMap.proj l)) p :=
      (hasStrictFDerivAt_inv (𝕜 := ℝ) (hp l).ne').comp p (hasStrictFDerivAt_apply l p)
    have hmul := (hg.mul hh).add_const (z l)
    refine hmul.congr_of_eventuallyEq (Eventually.of_forall fun p' => ?_) |>.congr_fderiv ?_
    · simp [hG, htdef, div_eq_mul_inv]
    · ext v
      simp [pe_dotCLM_apply, hAi, hD, Matrix.mulVec, dotProduct_comm]
      field_simp [(hp l).ne']
  refine ⟨E, fun _ => rfl, hωpos, fun i => ⟨kinkUtility_continuous _ _ _ _,
    kinkUtility_stronglyMonotone (hck i).1.le
      (fun k => by simp only [hm]; split_ifs <;> norm_num)
      (fun k => by simp only [hm]; split_ifs <;> [simp [hp k]; simpa using (hck k).2])⟩,
    ?_, D, hGd.congr_of_eventuallyEq hEG.symm, hD⟩
  rw [hEG.eq_of_nhds, hGp]

/-- **Exercise 17.E.3** (MWG, p. 645). Explicit utility functions rationalizing at `p` the
individual excess demands and price effects of Proposition 17.E.2: the kinked utilities
`kinkUtility p x̄ (𝟙 - eⁱ) c` of `proposition_17_E_2`. Restated: the consumer with this utility
and endowment `ω` demands, at every `p'` near enough to `p`, the single bundle
`x̄ + ((p'·ω - p'·x̄)/p'ᵢ) eⁱ` (wealth effect `(1/p'ᵢ)eⁱ`, null substitution matrix). -/
theorem exercise_17_E_3 {q xb p : Fin L → ℝ} {c w : ℝ} {i : Fin L} (hp : StrictlyPositive p)
    (hqi : 0 < q i) (hγ : ∀ k, k ≠ i → |q k - q i * p k / p i| < c)
    (hx : xb + ((w - p ⬝ᵥ xb) / p i) • Pi.single i 1 ∈ nonnegOrthant L) :
    walrasianDemandOn (nonnegOrthant L)
      (kinkUtility q xb (fun k => if k = i then 0 else 1) c) p w =
      {xb + ((w - p ⬝ᵥ xb) / p i) • Pi.single i 1} :=
  kink_demand hp hqi (by simp) (fun k hk => ⟨by simp [hk], hγ k hk⟩) hx

end MWG.PositiveEquilibriumTheory
