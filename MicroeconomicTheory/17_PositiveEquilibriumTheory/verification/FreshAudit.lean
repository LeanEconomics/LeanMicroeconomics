  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · refine continuousOn_pi.2 fun l => ?_
    fin_cases l
    · simp only [ex17C6NotBdd, Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero]
