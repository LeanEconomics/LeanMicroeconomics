/-!
# Appendix A to Chapter 3: the bordered Hessian

MWG, Appendix A to Chapter 3, "Differentiability", p. 95, and footnote 33.

* The Jacobian of the first-order system `∇u(x) - λp = 0`, `p·x - w = 0` with respect to
  `(x, λ)` is `[[D²u(x), -p], [pᵀ, 0]]` (`appendixAFocJacobian`; the derivative itself is
  computed in
  `AppendixADifferentiability`). Its determinant is nonzero iff the system's linearisation has
  trivial kernel (`appendixAFocJacobian_det_ne_zero_iff`).
* "Since `∇u(x) = λp` and `λ > 0`, the determinant of this matrix is nonzero iff the determinant
  of the bordered Hessian is nonzero": `det [[H, λp], [λpᵀ, 0]] = -λ² det [[H, -p], [pᵀ, 0]]`
  (`appendixABorderedHessian_det_eq`, `appendixAFocJacobian_det_ne_zero_iff_bordered`).
* The parenthetical examples: `f(x) = -x⁴` is strictly concave with `f''(0) = 0`
  (`appendixA_strictConcave_neg_pow_four`), and `u(x) = x₂ - x₁⁴` is strictly quasiconcave with
  nonzero
  gradient but a zero bordered Hessian determinant at `x₁ = 0` (`appendixA_bordered_zero_example`).
* **Footnote 33**: the Leontief demand `(w/(p₁+p₂), w/(p₁+p₂))`, generated by `min{x₁, x₂}`,
  is differentiable and its Slutsky matrix is zero, of rank `0 ≠ L - 1`
  (`footnote_3_AA_33`). It reuses Chapter 2's Exercise 2.F.17.
-/

namespace MWG.ClassicalDemand

open MWG.ConsumerChoice Matrix

variable {L : ℕ}

/-- **Appendix A** (MWG, p. 95). The Jacobian matrix of the first-order system
`∇u(x) - λp = 0`, `p·x - w = 0` with respect to `(x, λ)`: `[[D²u(x), -p], [pᵀ, 0]]`, for a
Hessian `H = D²u(x)`. -/
def appendixAFocJacobian (H : Matrix (Fin L) (Fin L) ℝ) (p : Fin L → ℝ) :
    Matrix (Fin L ⊕ Fin 1) (Fin L ⊕ Fin 1) ℝ :=
  fromBlocks H (replicateCol (Fin 1) (-p)) (replicateRow (Fin 1) p) 0

/-- **Appendix A** (MWG, p. 95). The bordered Hessian `[[D²u(x), ∇u(x)], [∇u(x)ᵀ, 0]]`, for a
Hessian `H` and a gradient `g`. -/
def appendixABorderedHessian (H : Matrix (Fin L) (Fin L) ℝ) (g : Fin L → ℝ) :
    Matrix (Fin L ⊕ Fin 1) (Fin L ⊕ Fin 1) ℝ :=
  fromBlocks H (replicateCol (Fin 1) g) (replicateRow (Fin 1) g) 0

/-- The Jacobian applied to a direction `(dx, dλ)`: `(H dx - dλ p, p·dx)`. -/
theorem appendixAFocJacobian_mulVec (H : Matrix (Fin L) (Fin L) ℝ) (p dx : Fin L → ℝ) (dlam : ℝ) :
    appendixAFocJacobian H p *ᵥ Sum.elim dx (fun _ => dlam) =
      Sum.elim (H *ᵥ dx - dlam • p) (fun _ => p ⬝ᵥ dx) := by
  rw [appendixAFocJacobian, fromBlocks_mulVec]
  congr 1
  · funext i
    simp [mulVec, dotProduct, replicateCol, sub_eq_add_neg, mul_comm]
  · funext i
    simp [mulVec, dotProduct, replicateRow]

/-- **Appendix A** (MWG, p. 95). The Jacobian determinant is nonzero iff the linearised system
`H dx - dλ p = 0`, `p·dx = 0` has only the trivial solution. -/
theorem appendixAFocJacobian_det_ne_zero_iff (H : Matrix (Fin L) (Fin L) ℝ) (p : Fin L → ℝ) :
    (appendixAFocJacobian H p).det ≠ 0 ↔
      ∀ (dx : Fin L → ℝ) (dlam : ℝ), H *ᵥ dx - dlam • p = 0 → p ⬝ᵥ dx = 0 →
        dx = 0 ∧ dlam = 0 := by
  rw [← isUnit_iff_ne_zero, ← isUnit_iff_isUnit_det, ← mulVec_injective_iff_isUnit]
  have hlin : Function.Injective (appendixAFocJacobian H p).mulVec ↔
      ∀ v, appendixAFocJacobian H p *ᵥ v = 0 → v = 0 := by
    rw [← (appendixAFocJacobian H p).coe_mulVecLin, injective_iff_map_eq_zero]
  rw [hlin]
  constructor
  · intro h dx dlam h1 h2
    have := h (Sum.elim dx (fun _ => dlam)) (by
      rw [appendixAFocJacobian_mulVec, h1, h2]
      funext i
      cases i <;> rfl)
    exact ⟨funext fun l => congrFun this (Sum.inl l), congrFun this (Sum.inr 0)⟩
  · intro h v hv
    have hv' : v = Sum.elim (v ∘ Sum.inl) (fun _ => v (Sum.inr 0)) := by
      funext i
      rcases i with i | i
      · rfl
      · rw [Fin.fin_one_eq_zero i]
        rfl
    rw [hv', appendixAFocJacobian_mulVec] at hv
    have h1 : H *ᵥ (v ∘ Sum.inl) - v (Sum.inr 0) • p = 0 := funext fun l => congrFun hv (Sum.inl l)
    have h2 : p ⬝ᵥ (v ∘ Sum.inl) = 0 := congrFun hv (Sum.inr 0)
    obtain ⟨hx, hl⟩ := h _ _ h1 h2
    rw [hv']
    funext i
    rcases i with i | i
    · exact congrFun hx i
    · exact hl

/-- **Appendix A** (MWG, p. 95). With `∇u(x) = λp`, the bordered Hessian is obtained from the
Jacobian by scaling its last row by `λ` and its last column by `-λ`. -/
theorem appendixABorderedHessian_eq_mul (H : Matrix (Fin L) (Fin L) ℝ) (p : Fin L → ℝ) (lam : ℝ) :
    appendixABorderedHessian H (lam • p) =
      fromBlocks 1 0 0 (lam • 1) * appendixAFocJacobian H p * fromBlocks 1 0 0 ((-lam) • 1) := by
  rw [appendixAFocJacobian, appendixABorderedHessian, fromBlocks_multiply, fromBlocks_multiply]
  simp only [one_mul, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_zero, Matrix.mul_one,
    Matrix.smul_mul, Matrix.mul_smul, one_mul, Matrix.mul_one, smul_zero]
  congr 1
  · ext i j
    simp [replicateCol]
  · ext i j
    simp [replicateRow]

/-- **Appendix A** (MWG, p. 95). `det [[H, λp], [λpᵀ, 0]] = -λ² det [[H, -p], [pᵀ, 0]]`. -/
theorem appendixABorderedHessian_det_eq (H : Matrix (Fin L) (Fin L) ℝ) (p : Fin L → ℝ) (lam : ℝ) :
    (appendixABorderedHessian H (lam • p)).det = -lam ^ 2 * (appendixAFocJacobian H p).det := by
  rw [appendixABorderedHessian_eq_mul, det_mul, det_mul, det_fromBlocks_zero₂₁,
    det_fromBlocks_zero₂₁]
  simp
  ring

/-- **Appendix A** (MWG, p. 95). "Since `∇u(x) = λp` and `λ > 0`, the determinant of this matrix
is nonzero if and only if the determinant of the bordered Hessian of `u(x)` at `x` is
nonzero." -/
theorem appendixAFocJacobian_det_ne_zero_iff_bordered (H : Matrix (Fin L) (Fin L) ℝ)
    {p g : Fin L → ℝ}
    {lam : ℝ} (hg : g = lam • p) (hlam : lam ≠ 0) :
    (appendixAFocJacobian H p).det ≠ 0 ↔ (appendixABorderedHessian H g).det ≠ 0 := by
  rw [hg, appendixABorderedHessian_det_eq]
  constructor
  · intro h
    exact mul_ne_zero (neg_ne_zero.mpr (pow_ne_zero 2 hlam)) h
  · intro h h0
    rw [h0, mul_zero] at h
    exact h rfl

/-- **Appendix A** (MWG, p. 95), parenthetical remark: the strictly concave function
`f(x) = -x⁴` has `f''(0) = 0`. -/
theorem appendixA_strictConcave_neg_pow_four :
    StrictConcaveOn ℝ Set.univ (fun x : ℝ => -x ^ 4) ∧
      deriv (deriv fun x : ℝ => -x ^ 4) 0 = 0 := by
  refine ⟨(Even.strictConvexOn_pow (by decide) (by decide)).neg, ?_⟩
  have h1 : deriv (fun x : ℝ => -x ^ 4) = fun x => -(4 * x ^ 3) := by
    funext x
    simp
  rw [h1]
  simp

/-- The utility `u(x) = x₂ - x₁⁴` on `ℝ²` (goods indexed `0, 1`). -/
def appendixABorderedZeroUtility (x : Fin 2 → ℝ) : ℝ := x 1 - x 0 ^ 4

/-- The derivative of `u(x) = x₂ - x₁⁴`: `h ↦ h₂ - 4x₁³ h₁`. -/
theorem appendixA_hasFDerivAt_borderedZeroUtility (x : Fin 2 → ℝ) :
    HasFDerivAt appendixABorderedZeroUtility
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) 1 -
        (4 * x 0 ^ 3) • ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) 0) x := by
  have h1 := hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin 2 => ℝ) (1 : Fin 2) x
  have h0 := (hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin 2 => ℝ) (0 : Fin 2) x).pow 4
  have e : appendixABorderedZeroUtility = (fun f : Fin 2 → ℝ => f 1) - fun f => f 0 ^ 4 := rfl
  rw [e]
  convert h1.sub h0 using 3
  norm_num

/-- The gradient of `u(x) = x₂ - x₁⁴` is `(-4x₁³, 1)`. -/
theorem appendixA_gradient_borderedZeroUtility (x : Fin 2 → ℝ) :
    gradientVec (fderiv ℝ appendixABorderedZeroUtility x) = ![-(4 * x 0 ^ 3), 1] := by
  rw [(appendixA_hasFDerivAt_borderedZeroUtility x).fderiv]
  funext l
  fin_cases l <;> simp [gradientVec]

/-- **Appendix A** (MWG, p. 95), parenthetical remark: "a strictly quasiconcave function could
have a bordered Hessian determinant that is zero at a point". `u(x) = x₂ - x₁⁴` is strictly
quasiconcave on `ℝ²`, has nowhere-zero gradient, and its Hessian at every `x` with `x₁ = 0` is
zero, so its bordered Hessian determinant vanishes there. -/
theorem appendixA_bordered_zero_example :
    StrictlyQuasiconcaveOn Set.univ appendixABorderedZeroUtility ∧
      (∀ x, gradientVec (fderiv ℝ appendixABorderedZeroUtility x) ≠ 0) ∧
      ∀ x : Fin 2 → ℝ, x 0 = 0 →
        MWG.ConsumerChoice.hessianMatrix appendixABorderedZeroUtility x = 0 ∧
        (appendixABorderedHessian
          (MWG.ConsumerChoice.hessianMatrix appendixABorderedZeroUtility x)
          (gradientVec (fderiv ℝ appendixABorderedZeroUtility x))).det = 0 := by
  refine ⟨⟨convex_univ, fun x _ y _ hxy α hα0 hα1 t htx hty => ?_⟩, fun x h => ?_,
    fun x hx => ?_⟩
  · simp only [appendixABorderedZeroUtility, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at htx hty ⊢
    have hconv := (Even.strictConvexOn_pow (n := 4) (by decide) (by decide))
    by_cases h0 : x 0 = y 0
    · have h1 : x 1 ≠ y 1 := by
        intro h1
        apply hxy
        funext l
        fin_cases l
        · exact h0
        · exact h1
      rw [← h0] at hty ⊢
      have e : α * x 0 + (1 - α) * x 0 = x 0 := by ring
      rw [e]
      rcases lt_or_gt_of_ne h1 with h | h <;> nlinarith
    · have := hconv.2 (Set.mem_univ (x 0)) (Set.mem_univ (y 0)) h0 hα0 (by linarith : 0 < 1 - α)
        (by ring)
      simp only [smul_eq_mul] at this
      nlinarith
  · have := congrFun h 1
    rw [appendixA_gradient_borderedZeroUtility] at this
    simp at this
  · have hG : (fun y => gradientVec (fderiv ℝ appendixABorderedZeroUtility y)) =
        fun y : Fin 2 → ℝ => ![-(4 * y 0 ^ 3), 1] := funext appendixA_gradient_borderedZeroUtility
    have hD : HasFDerivAt (𝕜 := ℝ) (fun y : Fin 2 → ℝ => (![-(4 * y 0 ^ 3), 1] : Fin 2 → ℝ))
        0 x := by
      rw [hasFDerivAt_pi']
      intro l
      fin_cases l
      · rw [ContinuousLinearMap.comp_zero]
        have := (((hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin 2 => ℝ) (0 : Fin 2)
          x).pow 3).const_mul 4).neg
        convert this using 1
        · funext y
          simp
        · simp [hx]
      · simpa using hasFDerivAt_const (1 : ℝ) x
    have hH : MWG.ConsumerChoice.hessianMatrix appendixABorderedZeroUtility x = 0 := by
      rw [MWG.ConsumerChoice.hessianMatrix, hG, hD.fderiv]
      ext i j
      simp [jacobian]
    refine ⟨hH, ?_⟩
    apply det_eq_zero_of_row_eq_zero (Sum.inl 0)
    intro j
    rcases j with j | j
    · simp [appendixABorderedHessian, hH]
    · simp [appendixABorderedHessian, replicateCol, appendixA_gradient_borderedZeroUtility, hx]

/-- **Footnote 33** (MWG, p. 95). The demand generated by `u(x) = min{x₁, x₂}` (MWG Ch. 3's
`leontiefUtility`) at `(p, w) ≫ 0` is `(w/(p₁+p₂), w/(p₁+p₂))`, Chapter 2's Exercise 2.F.17
demand with `L = 2`. -/
theorem footnote_3_AA_33_demand {p : Fin 2 → ℝ} {w : ℝ} (hd : PWDomain p w) :
    walrasianDemand leontiefUtility p w = {demand_2_F_17 2 p w} := by
  have hS : 0 < p 0 + p 1 := add_pos (hd.1 0) (hd.1 1)
  set m := w / (p 0 + p 1) with hm
  have hm0 : 0 ≤ m := div_nonneg hd.2.le hS.le
  have hdem : demand_2_F_17 2 p w = fun _ => m := by
    funext l
    simp [demand_2_F_17, Fin.sum_univ_two, hm]
  have hbound : ∀ y ∈ budgetSet p w, min (y 0) (y 1) ≤ m := by
    intro y hy
    have hc := hy.2
    simp only [dotProduct, Fin.sum_univ_two] at hc
    rw [hm, le_div_iff₀ hS]
    have h0 := min_le_left (y 0) (y 1)
    have h1 := min_le_right (y 0) (y 1)
    nlinarith [hd.1 0, hd.1 1]
  have hmem : (fun _ : Fin 2 => m) ∈ budgetSet p w := by
    refine ⟨fun _ => hm0, ?_⟩
    simp only [dotProduct, Fin.sum_univ_two]
    rw [hm]
    field_simp
    linarith
  rw [hdem]
  ext y
  rw [Set.mem_singleton_iff]
  constructor
  · rintro ⟨hy, hopt⟩
    have h1 := hopt _ hmem
    simp only [leontiefUtility, min_self] at h1
    have hc := hy.2
    simp only [dotProduct, Fin.sum_univ_two] at hc
    have hy0 : m ≤ y 0 := h1.trans (min_le_left _ _)
    have hy1 : m ≤ y 1 := h1.trans (min_le_right _ _)
    have hsum : p 0 * m + p 1 * m = w := by rw [hm]; field_simp
    have e0 : y 0 = m := by nlinarith [hd.1 0, hd.1 1]
    have e1 : y 1 = m := by nlinarith [hd.1 0, hd.1 1]
    funext l
    fin_cases l
    · exact e0
    · exact e1
  · rintro rfl
    exact ⟨hmem, fun y hy => by simpa [leontiefUtility] using hbound y hy⟩

/-- **Footnote 33** (MWG, p. 95). The Leontief demand is differentiable at every `(p, w) ≫ 0`,
but all entries of its Slutsky matrix are zero, so the Slutsky matrix has rank `0`, not
`L - 1 = 1`: the maximal-rank statement needs a `C²` utility. -/
theorem footnote_3_AA_33 {p : Fin 2 → ℝ} {w : ℝ} (hd : PWDomain p w) :
    walrasianDemand leontiefUtility p w = {demand_2_F_17 2 p w} ∧
      DifferentiableAt ℝ (Function.uncurry (demand_2_F_17 2)) (p, w) ∧
      slutskyMatrix (fderiv ℝ (Function.uncurry (demand_2_F_17 2)) (p, w))
        (demand_2_F_17 2 p w) = 0 ∧
      (slutskyMatrix (fderiv ℝ (Function.uncurry (demand_2_F_17 2)) (p, w))
        (demand_2_F_17 2 p w)).rank = 0 := by
  have hz := exercise_2_F_17d_zero hd 0
  refine ⟨footnote_3_AA_33_demand hd, demand_2_F_17_differentiableAt hd 0, hz, ?_⟩
  rw [hz, rank_zero]

end MWG.ClassicalDemand
